From 710918c87717990dc3748b96e39a97814bc813ce Mon Sep 17 00:00:00 2001
From: mzak <mzak.amin@gmail.com>
Date: Sat, 7 Nov 2026 20:30:00 +0200
Subject: [PATCH] libavcodec: v4l2m2m: FFmpeg 9 pixel format list for the DRM
 PRIME decoders

FFmpeg 9 removed the public AVCodec.pix_fmts field; codecs declare their
formats with CODEC_PIXFMTS_ARRAY() (FFCodec.pix_fmts). The v4l2 DRM PRIME
series still set .p.pix_fmts and passed avctx->codec->pix_fmts to
ff_get_format(). Use one static list for both.

Signed-off-by: mzak <mzak.amin@gmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 libavcodec/v4l2_m2m_dec.c | 11 +++++++----
 1 file changed, 7 insertions(+), 4 deletions(-)

diff --git a/libavcodec/v4l2_m2m_dec.c b/libavcodec/v4l2_m2m_dec.c
index 88b4eb4..1375aaa 100644
--- a/libavcodec/v4l2_m2m_dec.c
+++ b/libavcodec/v4l2_m2m_dec.c
@@ -41,6 +41,11 @@
 #include "v4l2_m2m.h"
 #include "v4l2_fmt.h"
 
+/* FFmpeg 9: AVCodec.pix_fmts is gone; one list for the codec table and ff_get_format() */
+static const enum AVPixelFormat v4l2_m2m_dec_pix_fmts[] = {
+    AV_PIX_FMT_DRM_PRIME, AV_PIX_FMT_NV12, AV_PIX_FMT_NONE
+};
+
 static int v4l2_try_start(AVCodecContext *avctx)
 {
     V4L2m2mContext *s = ((V4L2m2mPriv*)avctx->priv_data)->context;
@@ -218,7 +223,7 @@ static av_cold int v4l2_decode_init(AVCodecContext *avctx)
      *   - the DRM frame format is passed in the DRM frame descriptor layer.
      *       check the v4l2_get_drm_frame function.
      */
-    switch (ff_get_format(avctx, avctx->codec->pix_fmts)) {
+    switch (ff_get_format(avctx, v4l2_m2m_dec_pix_fmts)) {
     case AV_PIX_FMT_DRM_PRIME:
         s->output_drm = 1;
         break;
@@ -365,9 +370,7 @@ static const AVCodecHWConfigInternal *v4l2_m2m_hw_configs[] = {
         .caps_internal  = FF_CODEC_CAP_NOT_INIT_THREADSAFE | \
                           FF_CODEC_CAP_INIT_CLEANUP, \
         .p.wrapper_name = "v4l2m2m", \
-        .p.pix_fmts     = (const enum AVPixelFormat[]) { AV_PIX_FMT_DRM_PRIME, \
-                                                         AV_PIX_FMT_NV12, \
-                                                         AV_PIX_FMT_NONE}, \
+        CODEC_PIXFMTS_ARRAY(v4l2_m2m_dec_pix_fmts), \
         .hw_configs     = v4l2_m2m_hw_configs, \
     }
 
