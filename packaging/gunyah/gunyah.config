# Gunyah VM manager as modules (packaging/gunyah): merged into the kernel's own config by build-modules.sh.
# Nothing loads at boot; gunyah-rehearsal.sh insmods the modules from /run.
# olddefconfig adds CONFIG_GUNYAH_HYPERCALLS, CONFIG_GUNYAH_TIMER and CONFIG_GUNYAH_PLATFORM_HOOKS (=m).
CONFIG_GUNYAH=m
CONFIG_GUNYAH_QCOM_PLATFORM=m
CONFIG_GUNYAH_IRQFD=m
CONFIG_GUNYAH_IOEVENTFD=m
CONFIG_GUNYAH_QCOM_TRUSTED_VM=m
