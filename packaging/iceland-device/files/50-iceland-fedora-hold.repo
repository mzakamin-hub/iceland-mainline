# iceland-device: packages installed on the OnePlus Pad 4 that must not be replaced by Fedora's or RPM Fusion's updates.
# A dnf5 repository override (/usr/share/dnf5/repos.override.d). dnf5 APPENDS the excludepkgs of every override file
# (checked with dnf5 5.4.6: 50 + 53 + 59 gave the union), so this list only adds to the repositories; our builds still
# come from the local repository (iceland-local) after a RAM rehearsal.
#
# 0.28-47: the ONE hold file. It carries every hold that was spread over this file, iceland-coexist's
# 52-iceland-coexist-hold.repo (dropped in iceland-coexist 1.0-9) and the hand-placed /etc/dnf/repos.override.d files
# 53-iceland-upower-hold, 54-iceland-rpmfusion-hold and 55-iceland-ffhw-hold (moved aside by %posttrans only when
# their content is the known one). Fedora's own kernels stay refused from every repository by
# /usr/share/dnf5/libdnf.conf.d/80-iceland-kernel.conf (main excludepkgs).
#
# Held, and why:
# - kernel*, kernel-iceland*: no Fedora kernel boots the Pad 4; kernel-iceland comes from iceland-local only.
#   (Also freezes Fedora's kernel-tools / kernel-headers at the installed version.)
# - grub2-*, shim-*: EFI/fedora/shimaa64.efi is the standalone GRUB 2.16 reading /bootfs/grub2/grub.cfg; a shim-aa64 /
#   grub2-efi-aa64 update would overwrite it, grub2-tools scriptlets could rewrite a grub.cfg.
# - mesa (the Fedora mesa sub-packages, not mesa-libGLU / mesa-demos): our 26.3 build with the A840 fixes (.iceland1).
# - libcamera*: 0.7.1 .iceland_af1 with the autofocus patches.
# - upower*: 1.91.5 .iceland2 (time-to-full to the charge end threshold).
# - virglrenderer*: 1.3.0 .iceland1 with the VM 3D backports; Fedora's 1.3.0-2+ would replace them.
# - gstreamer1-plugins-good*: 1.28.8 .iceland1 with the V4L2 colorimetry fix (GStreamer !12699).
# - the ffmpeg-free family: the V4L2 DRM-PRIME decode build (Firefox hardware video). Fedora security updates of
#   ffmpeg-free wait: rebuild with the same changes, then install through iceland-local.
# - iio-sensor-proxy*, hexagonrpc*, libssc*: the sensor-hub builds; Fedora's iio-sensor-proxy has no SSC support.
# - iceland-*: our own packages, from iceland-local only.
# - RPM Fusion also: ffmpeg, ffmpeg-libs, ffmpeg-devel, libavdevice (they swap out ffmpeg-free), libavcodec-freeworld
#   (shadows libavcodec through ld.so.conf.d), and its mesa-*-freeworld drivers.
# - alsa-ucm: RELEASED in 0.28-47. No alsa-ucm file is a file of this package (file lists of 1.2.15.3-3 and
#   1.2.16.1-1 checked: no Qualcomm/kaanapali or conf.d/kaanapali path), so an update can never overwrite our
#   profile; should one ever ship the same path, rpm refuses the transaction (file conflict) instead of
#   overwriting, and skip_broken skips it. Our profile still includes lib/card-init.conf, lib/ctl-remap.conf and
#   codecs/wcd939x/init.conf from alsa-ucm: an update of those reaches the tablet like any Fedora update.
# An upgrade that cannot be resolved because of a hold is skipped, the rest goes ahead (best=False, skip_broken=True
# in 80-iceland-kernel.conf). iceland-update-check lists what waits; iceland-update-check --check verifies that every
# held package that is installed is our build.

[fedora]
excludepkgs=kernel*,kernel-iceland*,grub2-*,shim-*,mesa-dri-drivers,mesa-filesystem,mesa-libEGL*,mesa-libGL,mesa-libGL-devel,mesa-libgbm*,mesa-vulkan-drivers,mesa-libOpenCL*,mesa-libTeflon,mesa-dxil-devel,mesa-va-drivers,mesa-vdpau-drivers,mesa-libxatracker,mesa-libd3d*,mesa-libOSMesa*,libcamera*,upower*,virglrenderer*,gstreamer1-plugins-good*,ffmpeg-free*,libavcodec-free*,libavdevice-free*,libavfilter-free*,libavformat-free*,libavutil-free*,libswresample-free*,libswscale-free*,iio-sensor-proxy*,hexagonrpc*,libssc*,iceland-*

[updates]
excludepkgs=kernel*,kernel-iceland*,grub2-*,shim-*,mesa-dri-drivers,mesa-filesystem,mesa-libEGL*,mesa-libGL,mesa-libGL-devel,mesa-libgbm*,mesa-vulkan-drivers,mesa-libOpenCL*,mesa-libTeflon,mesa-dxil-devel,mesa-va-drivers,mesa-vdpau-drivers,mesa-libxatracker,mesa-libd3d*,mesa-libOSMesa*,libcamera*,upower*,virglrenderer*,gstreamer1-plugins-good*,ffmpeg-free*,libavcodec-free*,libavdevice-free*,libavfilter-free*,libavformat-free*,libavutil-free*,libswresample-free*,libswscale-free*,iio-sensor-proxy*,hexagonrpc*,libssc*,iceland-*

