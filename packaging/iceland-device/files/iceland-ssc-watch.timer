# iceland-device 0.28-16 (wf/r16): the sensor programs are checked once a minute from 90 s after the boot
# (iceland-ssc-watch.service). Pulled in by the package's own timers.target.wants link. AccuracySec lets systemd
# merge the wake-up with others (no extra wake-ups at idle).
[Unit]
Description=OnePlus Pad 4: check the sensor programs once a minute

[Timer]
OnBootSec=90s
OnUnitActiveSec=60s
AccuracySec=30s
