#!/usr/bin/python3
# SPDX-License-Identifier: GPL-2.0-or-later
#
# iceland-battery-guard: a second safety layer for charging on the OnePlus Pad 4 under mainline Linux.
# On stock, the OnePlus charging stack (oplus_chg) enforces these limits; mainline only has the SoCCP charger
# firmware + qcom_battmgr. Until it is proven that the firmware enforces them by itself (PLAN 5-PM C step 2), this
# service watches the battery and stops charging, lowers the charge current, or shuts down at the stock limits.
#
# Every limit is the Pad 4's stock 11.A.38 value (live stock DT capture 2; KNOWLEDGE rule 13), unless marked OURS.
# The kernel side (qcom_battmgr, Pad 4) already applies the stock per-charger-type input and charge currents.
#
#  oplus,comm  batt-them-thr (decidegC) = -100 0 50 120 160 350 450 530 -> 9 temperature regions R0..R8
#              sw-over-fv-mv  (per region) = 4508 x6, 4488, 4138, 4138   -> stop charging above this
#              wired-vbatdet-mv (per region) = 0 4200 4300 4400 4400 4400 4380 4030 0 -> recharge below this
#              vbatt-ov-thr-mv = 4600                                   -> over-voltage, stop charging
#              poweroff_high_batt_temp = 720, poweroff_emergency_batt_temp = 770 (decidegC); the framework's
#              own high-temperature protection shuts down earlier, at 700 (odm sys_high_temp_protect
#              HighTemperatureProtectShutDown), so the guard powers off at 70 C and forces it at 77 C
#              vbat_uv_thr_mv = 3300                                    -> power off when discharging below it
#  oplus,wired led_on-fccmax-ma (per region) = 0 1959 3300 3300 3300 3300 3300 1000 0 -> charge current cap
#              (the screen-on table, used always: it is the lower one; 0 = no charging, i.e. below -10 C and
#              at/above 53 C)
#  oplus,mms_wired (USB-C connector: stock reads usb_temp_adc_l / _r; the guard takes the hottest valid reading of
#              the usb-temp-l, usb-temp-r and usb-therm zones):
#              stop  : usb >= usbtemp_ntc_temp_low 57 C (battery <= usbtemp_batt_temp_low 50 C),
#                      usb >= usbtemp_ntc_temp_high 69 C (battery above 50 C),
#                      or usb - battery >= 7 / 12 / 15 C (usbtemp_temp_gap_low_with_batt_temp /
#                      _high_with_batt_temp / _with_batt_temp_in_over_hot, the last from battery >= 60 C
#                      usbtemp_batt_temp_over_hot); stock then stays stopped until the charger is unplugged.
#              cool down: usb >= 54 / 65 C or gap >= 12 / 20 C -> 1200 mA (usbtemp_cool_down_*,
#                      cool_down_pdqc_curr_ma level 1); recover below 48 / 60 C and gap below 6 / 15 C.
#              rise fast: the connector warming by rise_fast_temp 3 C -> stop (latched like the other USB stops).
#  VBUS over-voltage: stock's charger OV is 11000 mV -> stop (latched until unplugged).
#  Awake while a charger is in: stock's charging driver holds a wakelock from plug-in to
#              unplug (oplus_chg_wired.c:1872 oplus_wired_set_awake(chip, true), :1968 false), so on stock the
#              kernel side of charging never sleeps. Under mainline a suspend freezes this guard and the kernel's
#              5 s attach poll, and the charger firmware goes on alone with the last limits: no temperature
#              regions, no USB-C connector rules, no 85 % limit. So the guard holds a logind block on "sleep"
#              while a charger is in (KEEP_AWAKE=0 in the conf file turns that off). The screen still blanks;
#              "systemctl suspend -i" still suspends.
#  The cover (wf/wake): logind's lid action ignores "sleep" blocks (LidSwitchIgnoreInhibited=yes, its default),
#              so the block covers the lid switch as well UNLESS logind only locks (or ignores) a closing cover with
#              a charger in: HandleLidSwitchExternalPower and HandleLidSwitchDocked both "lock" or "ignore", as the
#              package's logind drop-in (logind.conf.d/60-iceland.conf) sets them. Then a closing cover locks the
#              session and the screen goes dark, the tablet stays awake (stock turns the screen off and keeps its
#              kernel awake), and at the unplug logind looks at the closed cover again and suspends. logind counts
#              the charger as external power by the same online attribute the guard reads (on_ac_power(): any
#              non-battery supply online; a USB one unless its USB-C port is a source). If logind would sleep on a
#              closing cover, or its setting can't be read (logind not up yet), the lid switch is blocked too and
#              the cover does nothing: the careful side. Read again every LID_RECHECK_S while a charger is in;
#              BLOCK_LID_SWITCH=yes in the conf file blocks the lid switch always (the cover then does nothing on
#              a charger).
#  OURS (not stock values): the input-current check: three readings in a row with the
#  measured input current more than 15 % + 50 mA above the limit the firmware reports -> stop charging until the
#  charger is unplugged (before patch 0053 the tablet drew 1.2-1.9 A from a PC port); a status line in the journal
#  at plug-in, 10 s later, every 10 minutes and at unplug;
#  the 45 C floor for the gap rules (stop and cool-down) (as in the OnePlus usbtemp code; PC verifies it in the
#  OnePlusOSS source, relay 013), 2 C temperature hysteresis on region changes, 3 consecutive low-voltage readings
#  before a power-off (load dips), "no charging while the battery temperature or voltage can't be read", the
#  rise-fast window (one 5 s sample; stock counts over 20-30 samples), a failed stop being retried every step
#  with the warning repeated every 5 minutes, connector readings outside -30..125 C treated as a broken channel,
#  and the charge limit (CHARGE_LIMIT / CHARGE_RESUME in /etc/iceland/battery-guard.conf, the user's 85 %): at
#  or above the limit charging stops, and it starts again at or below the resume level.
#  With a kernel that has the charge limit itself (charge_control_end_threshold on the battery: qcom_battmgr's
#  software limit, written by UPower when GNOME's "Preserve Battery Health" is on) the guard follows the kernel's
#  two thresholds instead of the config file, with the kernel's rule: stop at or above the end threshold, start
#  again below the start threshold. The kernel keeps the charger off while the guard's charge_behaviour OR its own
#  limit says so, so the two layers cannot work against each other; the guard is the second one.
#  (LIMIT_SOURCE=conf in the conf file: always the config file's two numbers, as before 0.17.)
#  Thermal cap: iceland-thermal (the skin temperature policy) publishes the charge-current cap of the present
#  temperature gear in /run/iceland/thermal-fcc-ma (stock's charging cool-down levels: cool_down_pdqc_curr_ma and
#  cool_down_normal_curr_ma 1200 1500 2000 mA, stock overlay dt00.dts:4220-4223). The guard takes the smaller of
#  that cap and its own (temperature region, USB-C connector cool-down), so its own stock limits are never raised.
#  OURS: a cap file older than 60 s is ignored (iceland-thermal rewrites it every 5 s): if that service stops, the
#  guard goes on with its own limits. THERMAL_CAP=0 in the conf file: the cap file is not read.
import glob, os, signal, subprocess, sys, syslog, time

BAT = os.environ.get("ICELAND_BAT", "/sys/class/power_supply/qcom-battmgr-bat")
USB = os.environ.get("ICELAND_USB", "/sys/class/power_supply/qcom-battmgr-usb")
THERMAL = os.environ.get("ICELAND_THERMAL", "/sys/class/thermal")
CONF = os.environ.get("ICELAND_GUARD_CONF", "/etc/iceland/battery-guard.conf")
DRYRUN = os.environ.get("ICELAND_GUARD_DRYRUN") == "1"   # tests: print actions instead of running them
ONESHOT = os.environ.get("ICELAND_GUARD_ONESHOT") == "1"

REGION_THR = [-10.0, 0.0, 5.0, 12.0, 16.0, 35.0, 45.0, 53.0]
SW_OVER_FV = [4.508, 4.508, 4.508, 4.508, 4.508, 4.508, 4.488, 4.138, 4.138]
VBATDET = [0.0, 4.200, 4.300, 4.400, 4.400, 4.400, 4.380, 4.030, 0.0]
FCC_MA = [0, 1959, 3300, 3300, 3300, 3300, 3300, 1000, 0]
V_OV = 4.600
T_POWEROFF = 70.0                         # stock framework (see header); the DT's own step is 72.0
T_EMERGENCY = 77.0
V_UV = 3.300
USB_STOP_LOW, USB_STOP_HIGH = 57.0, 69.0
USB_BATT_LOW, USB_BATT_OVER_HOT = 50.0, 60.0
USB_GAP_LOW, USB_GAP_HIGH, USB_GAP_OVER_HOT = 7.0, 12.0, 15.0
USB_GAP_FLOOR = 45.0                      # OURS (see header)
USB_COOL_LOW, USB_COOL_HIGH = 54.0, 65.0
USB_COOL_GAP_LOW, USB_COOL_GAP_HIGH = 12.0, 20.0
USB_REC_LOW, USB_REC_HIGH = 48.0, 60.0
USB_REC_GAP_LOW, USB_REC_GAP_HIGH = 6.0, 15.0
USB_COOL_MA = 1200
USB_RISE_FAST = 3.0                       # rise_fast_temp (C)
VBUS_OV = 11.0                            # stock charger OV (V)
HYST_T = 2.0                              # OURS
UV_COUNT = 3                              # OURS
REWARN_S = 300                            # OURS: repeat a "can't stop charging" warning every 5 min
USB_ZONES = ("usb-temp-l-thermal", "usb-temp-r-thermal", "usb-therm-thermal", "usb-therm")
USB_VALID = (-30.0, 125.0)                # OURS: outside = a broken channel, not a temperature
LIMIT_MIN = 50                            # OURS: a CHARGE_LIMIT below this is ignored
THERMAL_CAP = os.environ.get("ICELAND_THERMAL_CAP", "/run/iceland/thermal-fcc-ma")
THERMAL_CAP_AGE = 60                      # OURS: an older cap file is stale (iceland-thermal rewrites it every 5 s)
ICL_OVER_FACTOR, ICL_OVER_UA = 1.15, 50000   # OURS: measured input current above limit x 1.15 + 50 mA ...
ICL_OVER_COUNT = 3                        # OURS: ... in this many readings in a row -> stop until unplugged
STATUS_S = 600                            # OURS: a status line every 10 min while a charger is in
INHIBIT_ARGS = ["--who=iceland-battery-guard", "--why=a charger is connected: the charging guard has to stay awake (as on stock)",
                "--mode=block", "sleep", "infinity"]   # after "systemd-inhibit --what=..." (awake_what())
LID_SAFE = ("lock", "ignore")             # logind lid actions with a charger in that keep the tablet awake
LID_RECHECK_S = 60                        # OURS: logind's lid setting is read again this often while a charger is in

def rd(path, default=None):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default

def wr(path, value):
    if DRYRUN:
        print("DRYRUN: %s <- %s" % (os.path.basename(path), value), flush=True)
    try:
        with open(path, "w") as f:
            f.write(value)
        return True
    except OSError:
        return False

# started by systemd with stdout in the journal (both variables are set for a service, not for a shell)
UNDER_SYSTEMD = bool(os.environ.get("INVOCATION_ID") and os.environ.get("JOURNAL_STREAM"))

def log(msg, prio=syslog.LOG_WARNING):
    syslog.syslog(prio, msg)
    if not UNDER_SYSTEMD:      # a unit's stdout goes to the journal too: the syslog line is enough there
        print(msg, flush=True)

def run(cmd):
    if DRYRUN:
        print("DRYRUN: " + " ".join(cmd), flush=True)
        return 0
    return subprocess.call(cmd)

def usb_zones():
    """the USB-C connector zones present, {type: path}"""
    zs = {}
    for z in glob.glob(THERMAL + "/thermal_zone*"):
        t = rd(z + "/type", "")
        if t in USB_ZONES:
            zs[t] = z
    return zs

def usb_therm():
    """the hottest valid USB-C connector reading, or None"""
    vals = []
    for z in usb_zones().values():
        t = rd(z + "/temp")
        if t and t.lstrip("-").isdigit() and USB_VALID[0] < int(t) / 1000.0 < USB_VALID[1]:
            vals.append(int(t) / 1000.0)
    return max(vals) if vals else None

def conf():
    """the settings in CONF as a dict (read at every use: no restart needed)"""
    c = {}
    for line in (rd(CONF, "") or "").splitlines():
        line = line.split("#", 1)[0]
        if "=" in line:
            k, v = line.split("=", 1)
            c[k.strip()] = v.strip()
    return c

def num(text):
    """an integer sysfs value, or None"""
    return int(text) if text and text.lstrip("-").isdigit() else None

def selected(text):
    """the selected word of a sysfs choice ("Unknown [SDP] DCP" -> "SDP")"""
    if text and "[" in text and "]" in text:
        return text[text.index("[") + 1:text.index("]")]
    return text or "?"

def kernel_limit():
    """the kernel's own charge limit, (end, start) in percent as charge_control_end_threshold and
    charge_control_start_threshold read (end 100 = off); None when the kernel has none or it can't be read"""
    e = rd(BAT + "/charge_control_end_threshold")
    s = rd(BAT + "/charge_control_start_threshold", "0")
    if e is None or not e.isdigit() or not s.isdigit():
        return None
    return int(e), int(s)

def limit_from_kernel():
    """the kernel's thresholds if the guard is to follow them, else None (LIMIT_SOURCE=conf in CONF: never)"""
    if conf().get("LIMIT_SOURCE", "kernel") == "conf":
        return None
    return kernel_limit()

def logind_lid_actions():
    """logind's HandleLidSwitchExternalPower and HandleLidSwitchDocked now, or None if they can't be read"""
    v = os.environ.get("ICELAND_LID_ACTIONS")          # tests: "lock ignore", or "" for "can't be read"
    if v is not None:
        return v.split() or None
    try:
        r = subprocess.run(["busctl", "get-property", "org.freedesktop.login1", "/org/freedesktop/login1",
                            "org.freedesktop.login1.Manager", "HandleLidSwitchExternalPower", "HandleLidSwitchDocked"],
                           stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.SubprocessError):
        return None
    acts = [l.split()[1].strip('"') for l in r.stdout.splitlines() if len(l.split()) == 2 and l.split()[0] == "s"]
    return acts if r.returncode == 0 and len(acts) == 2 else None

def awake_what():
    """(what the guard's block covers, why): "sleep" when logind only locks or ignores a closing cover with a
    charger in, else "sleep:handle-lid-switch" (logind would sleep, can't be read, or BLOCK_LID_SWITCH=yes)"""
    if conf().get("BLOCK_LID_SWITCH", "auto") == "yes":
        return "sleep:handle-lid-switch", "BLOCK_LID_SWITCH=yes"
    acts = logind_lid_actions()
    if acts and all(a in LID_SAFE for a in acts):
        return "sleep", "logind: a closing cover with a charger in = %s" % acts[0]
    return "sleep:handle-lid-switch", ("logind would %s on a closing cover with a charger in" % "/".join(acts)
                                        if acts else "logind's lid setting can't be read")

def thermal_cap():
    """the charge-current cap (mA) of the present skin temperature gear from iceland-thermal, or None"""
    if conf().get("THERMAL_CAP", "1") == "0":
        return None
    try:
        if time.time() - os.stat(THERMAL_CAP).st_mtime > THERMAL_CAP_AGE:
            return None
        v = int(rd(THERMAL_CAP, "0"))
    except (OSError, ValueError):
        return None
    return v if v > 0 else None

def charge_limit():
    """(limit, resume) in percent: charging stops at or above limit and starts again at or below resume; None when
    off. From the kernel's thresholds if it has them (the kernel starts again BELOW its start threshold), else from
    CONF (off: CHARGE_LIMIT 0/100/absent or unusable); LIMIT_SOURCE=conf: always from CONF"""
    k = limit_from_kernel()
    if k is not None:
        end, start = k
        if not 0 < end < 100:
            return None
        if not 0 < start < end:
            start = max(end - 5, 1)        # the kernel's own default distance
        return end, start - 1
    c = conf()
    try:
        lim = int(c.get("CHARGE_LIMIT", "0"))
        res = int(c.get("CHARGE_RESUME", str(lim - 5)))
    except ValueError:
        return None
    if not LIMIT_MIN <= lim < 100:
        return None
    return lim, max(0, min(res, lim - 1))

def behaviour(value):
    """charge_behaviour as the kernel shows it ("[auto] inhibit-charge") or as a plain word"""
    if value and "[" in value:
        return value[value.index("[") + 1:value.index("]")]
    return value

def region(temp, prev):
    """stock region index; leaving the current region needs HYST_T of margin (OURS)"""
    r = sum(1 for t in REGION_THR if temp >= t)
    if prev is not None and r != prev:
        lo = REGION_THR[prev - 1] if prev > 0 else -1e9
        hi = REGION_THR[prev] if prev < len(REGION_THR) else 1e9
        # moving towards the safe middle needs margin; moving towards an extreme is immediate
        towards_middle = abs(r - 5) < abs(prev - 5)
        if towards_middle and lo - HYST_T < temp < hi + HYST_T:
            return prev
    return r

def usb_stop(ut, temp):
    if ut is None or temp is None:
        return None
    if temp <= USB_BATT_LOW:
        lim, gap = USB_STOP_LOW, USB_GAP_LOW
    elif temp < USB_BATT_OVER_HOT:
        lim, gap = USB_STOP_HIGH, USB_GAP_HIGH
    else:
        lim, gap = USB_STOP_HIGH, USB_GAP_OVER_HOT
    if ut >= lim:
        return "USB connector %.1f C >= %.0f C" % (ut, lim)
    if ut >= USB_GAP_FLOOR and ut - temp >= gap:
        return "USB connector %.1f C is %.1f C above the battery" % (ut, ut - temp)
    return None

def usb_cool(ut, temp, cooling):
    if ut is None or temp is None:
        return False
    low = temp <= USB_BATT_LOW
    if cooling:
        rec, rgap = (USB_REC_LOW, USB_REC_GAP_LOW) if low else (USB_REC_HIGH, USB_REC_GAP_HIGH)
        return not (ut < rec and ut - temp < rgap)
    lim, gap = (USB_COOL_LOW, USB_COOL_GAP_LOW) if low else (USB_COOL_HIGH, USB_COOL_GAP_HIGH)
    return ut >= lim or (ut >= USB_GAP_FLOOR and ut - temp >= gap)

class Guard:
    def __init__(self):
        self.inhibited = None      # the last state written successfully; None = unknown, write on first decision
        self.fcc = None
        self.region = None
        self.usb_latched = False
        self.usb_why = None        # why the USB latch was set (kept for the log until unplugged)
        self.prev_ut = None        # the connector temperature at the previous plugged step (rise-fast rule)
        self.cooling = False
        self.uv_count = 0
        self.warned_at = None      # when "can't stop charging" was last reported
        self.missing_at = None     # when a missing input was last reported while plugged
        self.v_stop = False        # stopped for voltage: resume only below the stock recharge voltage
        self.limit_hold = None     # charge limit: True = held at the limit until the resume level
        self.awake = None          # the logind block held while a charger is in (a child process)
        self.awake_fail_at = None  # when taking the block last failed
        self.what = None           # what the block covers ("sleep" or "sleep:handle-lid-switch")
        self.what_at = None        # when logind's lid setting was last read for it
        self.icl_over = 0          # readings in a row with the input current above its limit
        self.was_plugged = None    # the charger state of the previous step (status line)
        self.status_at = None      # when the status line was last written

    def keep_awake(self, on, quiet=False):
        """stock keeps the kernel awake while a charger is in; here: a logind block on sleep, and on the lid switch
        unless logind only locks the session when the cover closes with a charger in (awake_what)"""
        if on and conf().get("KEEP_AWAKE", "1") == "0":
            on = False
        if self.awake is not None and self.awake is not True and self.awake.poll() is not None:
            self.awake = None      # the child is gone (logind restarted?)
        now = time.monotonic()
        if on and self.awake is not None and (self.what_at is None or now - self.what_at >= LID_RECHECK_S):
            self.what_at = now
            what, why = awake_what()
            if what != self.what:  # logind's lid setting or BLOCK_LID_SWITCH changed: take the block again
                log("iceland-battery-guard: the block changes from %s to %s (%s)" % (self.what, what, why), syslog.LOG_NOTICE)
                self.keep_awake(False, quiet=True)
        if on == (self.awake is not None):
            return
        if not on:
            if self.awake is not True:
                self.awake.terminate()
                self.awake.wait()
            self.awake = None
            if DRYRUN:
                print("DRYRUN: keep awake off", flush=True)
            if not quiet:
                log("iceland-battery-guard: no charger (or KEEP_AWAKE=0): the tablet may sleep again", syslog.LOG_NOTICE)
            return
        if self.awake_fail_at is not None and now - self.awake_fail_at < REWARN_S:
            return
        what, why = awake_what()
        self.what, self.what_at = what, now
        if DRYRUN:
            print("DRYRUN: keep awake on (%s)" % what, flush=True)
            self.awake = True
        else:
            try:
                self.awake = subprocess.Popen(["systemd-inhibit", "--what=" + what] + INHIBIT_ARGS, stdin=subprocess.DEVNULL,
                                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                time.sleep(0.2)
                if self.awake.poll() is not None:
                    self.awake = None
            except OSError:
                self.awake = None
        if self.awake is None:
            self.awake_fail_at = now
            log("iceland-battery-guard: can't block sleep while the charger is in (systemd-inhibit failed): "
                "a suspend now leaves charging to the firmware alone")
            return
        self.awake_fail_at = None
        if what == "sleep":
            log("iceland-battery-guard: a charger is in: sleep is blocked, the cover only locks the screen (%s; "
                "KEEP_AWAKE=0 turns this off)" % why, syslog.LOG_NOTICE)
        else:
            log("iceland-battery-guard: a charger is in: sleep and the lid switch are blocked (%s; KEEP_AWAKE=0 "
                "turns this off)" % why, syslog.LOG_NOTICE)

    def status_line(self, plugged, temp, volt, soc, vbus):
        """the journal's record of what was plugged in and how it charged (plug-in, 10 s later, every 10 min, unplug)"""
        now = time.monotonic()
        changed = plugged != self.was_plugged
        first = self.was_plugged is None
        self.was_plugged = plugged
        if changed and not plugged:
            self.status_at = None
            if not first:
                log("iceland-battery-guard: charger unplugged at %s %%" % ("?" if soc is None else soc),
                    syslog.LOG_NOTICE)
            return
        if not plugged or (not changed and self.status_at is not None and now - self.status_at < STATUS_S):
            return
        # after the plug-in line the next one comes 10 s later (the kernel's setup has finished by then)
        self.status_at = now - STATUS_S + 10 if changed else now
        lim = num(rd(USB + "/input_current_limit")); cur = num(rd(USB + "/current_now"))
        ib = num(rd(BAT + "/current_now")); cap = num(rd(BAT + "/constant_charge_current_max"))
        ma = lambda v: "?" if v is None else "%d" % round(v / 1000.0)
        log("iceland-battery-guard: charger in: type %s, VBUS %s V, input %s of %s mA; battery %s %%, %s V, %s C, "
            "%s mA, %s; charge cap %s mA, %s" % (
                selected(rd(USB + "/usb_type")), "?" if vbus is None else "%.2f" % vbus, ma(cur), ma(lim),
                "?" if soc is None else soc, "?" if volt is None else "%.3f" % volt,
                "?" if temp is None else "%.1f" % temp, ma(ib), rd(BAT + "/status", "?"), ma(cap),
                selected(rd(BAT + "/charge_behaviour"))), syslog.LOG_NOTICE)

    def input_over(self, plugged):
        """OURS: the measured input current is above the limit the firmware reports, several readings in a row"""
        lim = num(rd(USB + "/input_current_limit")); cur = num(rd(USB + "/current_now"))
        if plugged and lim and cur is not None and cur > lim * ICL_OVER_FACTOR + ICL_OVER_UA:
            self.icl_over += 1
        else:
            self.icl_over = 0
        if self.icl_over >= ICL_OVER_COUNT:
            return "input current %d mA above its limit %d mA" % (round(cur / 1000.0), round(lim / 1000.0))
        return None

    def report_inputs(self):
        """log once at start which inputs and knobs exist (a missing one disables its rules)"""
        zones = usb_zones()
        have = {"charge_behaviour": os.path.exists(BAT + "/charge_behaviour"),
                "constant_charge_current_max": os.path.exists(BAT + "/constant_charge_current_max"),
                "usb-therm zone": bool(zones),
                "battery voltage": rd(BAT + "/voltage_now") is not None,
                "USB voltage": rd(USB + "/voltage_now") is not None}
        missing = [k for k, ok in have.items() if not ok]
        log("iceland-battery-guard: inputs " + ", ".join("%s %s" % (k, "ok" if ok else "MISSING") for k, ok in have.items()),
            syslog.LOG_WARNING if missing else syslog.LOG_NOTICE)
        lim = charge_limit(); tcap = thermal_cap()
        log("iceland-battery-guard: USB-C zones %s; charge limit %s%s; awake while a charger is in: %s; "
            "thermal charge cap %s" % (
            " ".join(sorted(zones)) or "none",
            "%d %% (resume at %d %%)" % lim if lim else "off",
            ", from the kernel's thresholds" if limit_from_kernel() is not None else "",
            "off (KEEP_AWAKE=0)" if conf().get("KEEP_AWAKE", "1") == "0" else "on",
            "off (THERMAL_CAP=0)" if conf().get("THERMAL_CAP", "1") == "0" else
            "%d mA" % tcap if tcap else "none now (%s)" % THERMAL_CAP), syslog.LOG_NOTICE)
        log("iceland-battery-guard: with a charger in the block covers %s (%s)" % awake_what(), syslog.LOG_NOTICE)
        return missing

    def limit_stop(self, soc):
        """the charge limit's stop reason, or None"""
        lim = charge_limit()
        if lim is None or soc is None:
            self.limit_hold = None
            return None
        if soc >= lim[0]:
            self.limit_hold = True
        elif soc <= lim[1]:
            self.limit_hold = False
        elif self.limit_hold is None:
            self.limit_hold = True     # started between the two levels: wait for the resume level
        if self.limit_hold:
            return "charge limit %d %% (resumes at %d %%)" % lim
        return None

    def inhibit(self, on, why=""):
        cb = BAT + "/charge_behaviour"
        want = "inhibit-charge" if on else "auto"
        # re-read every step: something else may have changed it (or an earlier write failed)
        if self.inhibited == on and behaviour(rd(cb)) == want:
            return
        ok = os.path.exists(cb) and wr(cb, want)
        if not ok:
            now = time.monotonic()
            if on and (self.warned_at is None or now - self.warned_at >= REWARN_S):
                log("iceland-battery-guard: must stop charging (%s) but can't; unplug the charger" % why, syslog.LOG_CRIT)
                run(["wall", "OnePlus Pad 4: unplug the charger (%s)" % why])
                self.warned_at = now
            return                 # not cached: the next step tries again
        if self.inhibited != on:
            log("iceland-battery-guard: " + ("charging stopped: " + why if on else "charging allowed"),
                syslog.LOG_WARNING if on else syslog.LOG_NOTICE)
        self.inhibited = on
        self.warned_at = None

    def set_fcc(self, ma):
        if self.fcc == ma:
            return
        p = BAT + "/constant_charge_current_max"
        if os.path.exists(p) and wr(p, str(ma * 1000)):
            log("iceland-battery-guard: charge current cap %d mA" % ma, syslog.LOG_NOTICE)
            self.fcc = ma          # cached only on success: a failed write is retried next step

    def step(self):
        t = rd(BAT + "/temp"); v = rd(BAT + "/voltage_now"); st = rd(BAT + "/status", "")
        temp = int(t) / 10.0 if t and t.lstrip("-").isdigit() else None   # tenths of a degree C
        volt = int(v) / 1e6 if v and v.isdigit() else None                 # uV
        plugged = rd(USB + "/online", "0") == "1"
        vb = rd(USB + "/voltage_now")
        vbus = int(vb) / 1e6 if vb and vb.isdigit() else None               # uV
        c = rd(BAT + "/capacity")
        soc = int(c) if c and c.isdigit() else None
        ut = usb_therm()
        self.keep_awake(plugged)
        if plugged and ut is None:
            now = time.monotonic()
            if self.missing_at is None or now - self.missing_at >= REWARN_S:
                log("iceland-battery-guard: no valid USB-C connector temperature: the connector rules are off")
                self.missing_at = now

        # shutdowns
        if temp is not None and temp >= T_EMERGENCY:
            log("iceland-battery-guard: battery %.1f C, powering off NOW" % temp, syslog.LOG_CRIT)
            run(["systemctl", "poweroff", "-ff"])
        elif temp is not None and temp >= T_POWEROFF:
            log("iceland-battery-guard: battery %.1f C, powering off" % temp, syslog.LOG_CRIT)
            run(["systemctl", "poweroff"])
        if st == "Discharging" and volt is not None and volt < V_UV:
            self.uv_count += 1
            if self.uv_count >= UV_COUNT:
                log("iceland-battery-guard: battery %.3f V < %.2f V, powering off" % (volt, V_UV), syslog.LOG_CRIT)
                run(["systemctl", "poweroff"])
        else:
            self.uv_count = 0

        # the USB-C connector latch lasts until the charger is unplugged, as on stock
        if not plugged:
            self.usb_latched = False
            self.usb_why = None
            self.prev_ut = None
        why = usb_stop(ut, temp)
        if not why and plugged and ut is not None and self.prev_ut is not None and ut - self.prev_ut >= USB_RISE_FAST:
            why = "USB connector rose %.1f C in one step (%.1f C)" % (ut - self.prev_ut, ut)
        if not why and plugged and vbus is not None and vbus > VBUS_OV:
            why = "VBUS %.2f V above %.1f V" % (vbus, VBUS_OV)
        over = self.input_over(plugged)
        if not why and over:
            why = over
        if plugged:
            self.prev_ut = ut
        if why:
            self.usb_latched = True
            self.usb_why = why

        # charging decision
        stop = None
        if temp is None:
            stop = "battery temperature unreadable"
        else:
            self.region = region(temp, self.region)
            r = self.region
            if FCC_MA[r] == 0:
                stop = "battery %.1f C outside -10..53 C" % temp
            elif volt is None:
                stop = "battery voltage unreadable"
            elif volt >= V_OV:
                stop = "over-voltage %.3f V" % volt
                self.v_stop = True
            elif volt is not None and volt > SW_OVER_FV[r]:
                stop = "%.3f V above %.3f V at %.1f C" % (volt, SW_OVER_FV[r], temp)
                self.v_stop = True
            elif self.v_stop and volt is not None and volt >= VBATDET[r]:
                stop = "waiting for %.3f V to recharge" % VBATDET[r]   # stock recharge threshold
            else:
                self.v_stop = False
        limit = self.limit_stop(soc)
        if stop is None:
            stop = limit
        if self.usb_latched:
            stop = why or "%s (unplug to reset)" % (self.usb_why or "USB connector was too hot")
        self.inhibit(stop is not None, stop or "")

        if temp is not None:
            self.cooling = usb_cool(ut, temp, self.cooling)
            cap = FCC_MA[self.region]
            if self.cooling:
                cap = min(cap, USB_COOL_MA)
            tcap = thermal_cap()
            if tcap:
                cap = min(cap, tcap)
            if cap:
                self.set_fcc(cap)
        self.status_line(plugged, temp, volt, soc, vbus)
        return plugged

def main():
    syslog.openlog("iceland-battery-guard")
    if not os.path.isdir(BAT):
        log("no %s, nothing to guard" % BAT)
        return 0
    g = Guard()
    signal.signal(signal.SIGTERM, lambda *a: sys.exit(0))   # so that the sleep block is given back
    g.report_inputs()
    try:
        while True:
            plugged = g.step()
            if ONESHOT:
                return 0
            time.sleep(5 if plugged else 15)
    finally:
        g.keep_awake(False, quiet=True)   # the guard stops: give the block back

if __name__ == "__main__":
    sys.exit(main())
