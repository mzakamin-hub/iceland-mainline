def rd(path, default=None):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default

class _Unknown:
    """an attribute that exists but cannot be read now (a glink timeout, -110): neither a value nor absent"""
    def __repr__(self):
        return "UNKNOWN"
UNKNOWN = _Unknown()

def rdx(path):
    """the attribute's text; None when it does not exist (an older kernel: the old meaning applies); UNKNOWN when it
    exists but the read fails (EIO / ETIMEDOUT while the ADSP stalls): the caller keeps its previous decision"""
    try:
        with open(path) as f:
            return f.read().strip()
    except FileNotFoundError:
        return None
    except OSError as e:
        if e.errno == errno.ENOENT:
            return None
        return UNKNOWN

def wr(path, value):
    if DRYRUN:
        print("DRYRUN: %s <- %s" % (os.path.basename(path), value), flush=True)
    try:
        with open(path, "w") as f:
            f.write(value)
        return True
    except OSError:
        return False

# started by systemd with stdout in the journal (both variables are set for a service, not for a shell)
UNDER_SYSTEMD = bool(os.environ.get("INVOCATION_ID") and os.environ.get("JOURNAL_STREAM"))

def log(msg, prio=syslog.LOG_WARNING):
    syslog.syslog(prio, msg)
    if not UNDER_SYSTEMD:      # a unit's stdout goes to the journal too: the syslog line is enough there
        print(msg, flush=True)

def run(cmd):
    if DRYRUN:
        print("DRYRUN: " + " ".join(cmd), flush=True)
        return 0
    return subprocess.call(cmd)

def usb_zones():
    """the USB-C connector zones present, {type: path}"""
    zs = {}
    for z in glob.glob(THERMAL + "/thermal_zone*"):
        t = rd(z + "/type", "")
        if t in USB_ZONES:
            zs[t] = z
    return zs

def usb_therm():
    """the hottest valid USB-C connector reading, or None"""
    vals = []
    for z in usb_zones().values():
        t = rd(z + "/temp")
        if t and t.lstrip("-").isdigit() and USB_VALID[0] < int(t) / 1000.0 < USB_VALID[1]:
            vals.append(int(t) / 1000.0)
    return max(vals) if vals else None

def conf():
    """the settings in CONF as a dict (read at every use: no restart needed)"""
    c = {}
    for line in (rd(CONF, "") or "").splitlines():
        line = line.split("#", 1)[0]
        if "=" in line:
            k, v = line.split("=", 1)
            c[k.strip()] = v.strip()
    return c

def num(text):
    """an integer sysfs value, or None"""
    return int(text) if isinstance(text, str) and text.lstrip("-").isdigit() else None   # UNKNOWN / None: None

def selected(text):
    """the selected word of a sysfs choice ("Unknown [SDP] DCP" -> "SDP")"""
    if text and "[" in text and "]" in text:
        return text[text.index("[") + 1:text.index("]")]
    return text or "?"

def kernel_limit():
    """the kernel's own charge limit, (end, start) in percent as charge_control_end_threshold and
    charge_control_start_threshold read (end 100 = off); None when the kernel has none or it can't be read"""
    global _klimit_last
    e = rdx(BAT + "/charge_control_end_threshold")
    s = rdx(BAT + "/charge_control_start_threshold")
    if e is UNKNOWN or s is UNKNOWN:       # 0.23: a failed read keeps the last thresholds read (else: unknown)
        return _klimit_last if _klimit_last is not None else UNKNOWN
    s = "0" if s is None else s
    if e is None or not e.isdigit() or not s.isdigit():
        _klimit_last = None
        return None
    _klimit_last = (int(e), int(s))
    return _klimit_last
_klimit_last = None

def limit_from_kernel():
    """the kernel's thresholds if the guard is to follow them, else None (LIMIT_SOURCE=conf in CONF: never)"""
    if conf().get("LIMIT_SOURCE", "kernel") == "conf":
        return None
    return kernel_limit()

def logind_lid_actions():
    """logind's HandleLidSwitchExternalPower and HandleLidSwitchDocked now, or None if they can't be read"""
    v = os.environ.get("ICELAND_LID_ACTIONS")          # tests: "lock ignore", or "" for "can't be read"
    if v is not None:
        return v.split() or None
    try:
        r = subprocess.run(["busctl", "get-property", "org.freedesktop.login1", "/org/freedesktop/login1",
                            "org.freedesktop.login1.Manager", "HandleLidSwitchExternalPower", "HandleLidSwitchDocked"],
                           stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.SubprocessError):
        return None
    acts = [l.split()[1].strip('"') for l in r.stdout.splitlines() if len(l.split()) == 2 and l.split()[0] == "s"]
    return acts if r.returncode == 0 and len(acts) == 2 else None

def awake_what():
    """(what the guard's block covers, why): "sleep" when logind only locks or ignores a closing cover with a
    charger in, else "sleep:handle-lid-switch" (logind would sleep, can't be read, or BLOCK_LID_SWITCH=yes)"""
    if conf().get("BLOCK_LID_SWITCH", "auto") == "yes":
        return "sleep:handle-lid-switch", "BLOCK_LID_SWITCH=yes"
    acts = logind_lid_actions()
    if acts and all(a in LID_SAFE for a in acts):
        return "sleep", "logind: a closing cover with a charger in = %s" % acts[0]
    return "sleep:handle-lid-switch", ("logind would %s on a closing cover with a charger in" % "/".join(acts)
                                        if acts else "logind's lid setting can't be read")

def thermal_cap():
    """the charge-current cap (mA) of the present skin temperature gear from iceland-thermal, or None"""
    if conf().get("THERMAL_CAP", "1") == "0":
        return None
    try:
        if time.time() - os.stat(THERMAL_CAP).st_mtime > THERMAL_CAP_AGE:
            return None
        v = int(rd(THERMAL_CAP, "0"))
    except (OSError, ValueError):
        return None
    return v if v > 0 else None

def charge_limit():
    """(limit, resume) in percent: charging stops at or above limit and starts again at or below resume; None when
    off. From the kernel's thresholds if it has them (the kernel starts again BELOW its start threshold), else from
    CONF (off: CHARGE_LIMIT 0/100/absent or unusable); LIMIT_SOURCE=conf: always from CONF"""
    k = limit_from_kernel()
    if k is UNKNOWN:
        return UNKNOWN                 # 0.23: the kernel's thresholds can't be read and none was read before
    if k is not None:
        end, start = k
        if not 0 < end < 100:
            return None
        if not 0 < start < end:
            start = max(end - 5, 1)        # the kernel's own default distance
        return end, start - 1
    c = conf()
    try:
        lim = int(c.get("CHARGE_LIMIT", "0"))
        res = int(c.get("CHARGE_RESUME", str(lim - 5)))
    except ValueError:
        return None
    if not LIMIT_MIN <= lim < 100:
        return None
    return lim, max(0, min(res, lim - 1))

def read_bypass():
    """the bypass switch's request: (threshold, until) with until in seconds since the epoch, "bad" if the file
    can't be used, None if there is none (BYPASS=0 is handled by Guard.bypass_stop)"""
    try:
        with open(BYPASS_REQ, "rb") as f:
            raw = f.read(4096)
    except OSError:
        return None
    try:
        txt = raw.decode("ascii")
    except UnicodeDecodeError:
        return "bad"
    kv = dict(l.split("=", 1) for l in txt.splitlines() if "=" in l)
    try:
        thr, until = int(kv.get("threshold", "")), float(kv.get("until", ""))
    except ValueError:
        return "bad"
    if not BYPASS_MIN <= thr <= 100 or not math.isfinite(until):
        return "bad"
    return thr, until

def behaviour(value):
    """charge_behaviour as the kernel shows it ("[auto] inhibit-charge") or as a plain word"""
    if value and "[" in value:
        return value[value.index("[") + 1:value.index("]")]
    return value

def lever_present():
    """kernel-iceland's input suspend lever: qcom-battmgr-usb/input_current_limit is a writable attribute"""
    try:
        return bool(stat.S_IMODE(os.stat(USB + "/input_current_limit").st_mode) & 0o200)
    except OSError:
        return False

def alert_class(stop):
    """the class of a safety stop the user should see, or None: no stop, or an expected one (the charge limit,
    the float-voltage stop, the recharge wait)"""
    if not stop:
        return None
    if stop.startswith("USB connector"):
        return "connector"
    if stop.startswith("input current"):
        return "input"
    if stop.startswith("VBUS"):
        return "charger"
    if "outside -10..53 C" in stop:
        return "battery"
    if stop.startswith("over-voltage"):
        return "voltage"
    if "unreadable" in stop:
        return "sensor"
    return None

def region(temp, prev):
    """stock region index; leaving the current region needs HYST_T of margin (OURS)"""
    r = sum(1 for t in REGION_THR if temp >= t)
    if prev is not None and r != prev:
        lo = REGION_THR[prev - 1] if prev > 0 else -1e9
        hi = REGION_THR[prev] if prev < len(REGION_THR) else 1e9
        # moving towards the safe middle needs margin; moving towards an extreme is immediate
        towards_middle = abs(r - 5) < abs(prev - 5)
        if towards_middle and lo - HYST_T < temp < hi + HYST_T:
            return prev
    return r

def usb_stop(ut, temp):
    if ut is None or temp is None:
        return None
    if temp <= USB_BATT_LOW:
        lim, gap = USB_STOP_LOW, USB_GAP_LOW
    elif temp < USB_BATT_OVER_HOT:
        lim, gap = USB_STOP_HIGH, USB_GAP_HIGH
    else:
        lim, gap = USB_STOP_HIGH, USB_GAP_OVER_HOT
    if ut >= lim:
        return "USB connector %.1f C >= %.0f C" % (ut, lim)
    if ut >= USB_GAP_FLOOR and ut - temp >= gap:
        return "USB connector %.1f C is %.1f C above the battery" % (ut, ut - temp)
    return None

def usb_cool(ut, temp, cooling):
    if ut is None or temp is None:
        return False
    low = temp <= USB_BATT_LOW
    if cooling:
        rec, rgap = (USB_REC_LOW, USB_REC_GAP_LOW) if low else (USB_REC_HIGH, USB_REC_GAP_HIGH)
        return not (ut < rec and ut - temp < rgap)
    lim, gap = (USB_COOL_LOW, USB_COOL_GAP_LOW) if low else (USB_COOL_HIGH, USB_COOL_GAP_HIGH)
    return ut >= lim or (ut >= USB_GAP_FLOOR and ut - temp >= gap)

class Guard:
    def __init__(self):
        self.inhibited = None      # the last state written successfully; None = unknown, write on first decision
        self.fcc = None
        self.region = None
        self.usb_latched = False
        self.usb_why = None        # why the USB latch was set (kept for the log until unplugged)
        self.prev_ut = None        # the connector temperature at the previous plugged step (rise-fast rule)
        self.cooling = False
        self.uv_count = 0
        self.warned_at = None      # when "can't stop charging" was last reported
        self.missing_at = None     # when a missing input was last reported while plugged
        self.v_stop = False        # stopped for voltage: resume only below the stock recharge voltage
        self.limit_hold = None     # charge limit: True = held at the limit until the resume level
        self.awake = None          # the logind block held while a charger is in (a child process)
        self.awake_fail_at = None  # when taking the block last failed
        self.what = None           # what the block covers ("sleep" or "sleep:handle-lid-switch")
        self.what_at = None        # when logind's lid setting was last read for it
        self.icl_over = 0          # readings in a row with the input current above its limit
        self.was_plugged = None    # the charger state of the previous step (status line)
        self.status_at = None      # when the status line was last written
        self.bp_level = None       # bypass: the level the hold began at (None = not holding)
        self.bp_topup = False      # bypass: charging again because the level fell BYPASS_DROP below bp_level
        self.bp_state = None       # bypass: the state file's last content
        self.bp_only = False       # bypass: the last decision stopped charging for bypass alone (release_bypass)
        self.bp_end = None         # bypass: why the last request ended (state file "ended=", S4)
        self.suspended = None      # the input cut written successfully; None = unknown (read at the first decision)
        self.icl_before = None     # input_current_limit as read before the cut (written back at the release)
        self.cut_why = None        # the latch reason that cuts the input (connector, input current); None = no cut
        self.lever_at = None       # when a missing or failed input lever was last reported
        self.alert_seq = 0         # the number of the last event written to ALERT
        self.alert_cls = None      # the class of the safety stop in force (its event was written); None = none
        self.alert_read = False    # ALERT read once, to continue an earlier guard's numbering
        self.alert_fail = False    # the last ALERT write failed (said once)
        self.plugged_last = None   # 0.23: the last "a cable is in" decision (kept while online can't be read)
        self.unknown_at = {}       # 0.23: attribute -> when its failed read was last reported (once per REWARN_S)
        self.soc_unknown = False   # 0.23: capacity exists but could not be read this step

    def unreadable(self, what, means):
        """0.23: say once per REWARN_S that an attribute exists but cannot be read, and what the guard does instead"""
        now = time.monotonic()
        last = self.unknown_at.get(what)
        if last is None or now - last >= REWARN_S:
            log("iceland-battery-guard: %s can't be read (glink / ADSP?): %s" % (what, means))
            self.unknown_at[what] = now

    def readable(self, what):
        if self.unknown_at.pop(what, None) is not None:
            log("iceland-battery-guard: %s can be read again" % what, syslog.LOG_NOTICE)

    def keep_awake(self, on, quiet=False):
        """stock keeps the kernel awake while a charger is in; here: a logind block on sleep, and on the lid switch
        unless logind only locks the session when the cover closes with a charger in (awake_what)"""
        if on and conf().get("KEEP_AWAKE", "1") == "0":
            on = False
        if self.awake is not None and self.awake is not True and self.awake.poll() is not None:
            self.awake = None      # the child is gone (logind restarted?)
        now = time.monotonic()
        if on and self.awake is not None and (self.what_at is None or now - self.what_at >= LID_RECHECK_S):
            self.what_at = now
            what, why = awake_what()
            if what != self.what:  # logind's lid setting or BLOCK_LID_SWITCH changed: take the block again
                log("iceland-battery-guard: the block changes from %s to %s (%s)" % (self.what, what, why), syslog.LOG_NOTICE)
                self.keep_awake(False, quiet=True)
        if on == (self.awake is not None):
            return
        if not on:
            if self.awake is not True:
                self.awake.terminate()
                self.awake.wait()
            self.awake = None
            if DRYRUN:
                print("DRYRUN: keep awake off", flush=True)
            if not quiet:
                log("iceland-battery-guard: no charger (or KEEP_AWAKE=0): the tablet may sleep again", syslog.LOG_NOTICE)
            return
        if self.awake_fail_at is not None and now - self.awake_fail_at < REWARN_S:
            return
        what, why = awake_what()
        self.what, self.what_at = what, now
        if DRYRUN:
            print("DRYRUN: keep awake on (%s)" % what, flush=True)
            self.awake = True
        else:
            try:
                self.awake = subprocess.Popen(["systemd-inhibit", "--what=" + what] + INHIBIT_ARGS, stdin=subprocess.DEVNULL,
                                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                time.sleep(0.2)
                if self.awake.poll() is not None:
                    self.awake = None
            except OSError:
                self.awake = None
        if self.awake is None:
            self.awake_fail_at = now
            log("iceland-battery-guard: can't block sleep while the charger is in (systemd-inhibit failed): "
                "a suspend now leaves charging to the firmware alone")
            return
        self.awake_fail_at = None
        if what == "sleep":
            log("iceland-battery-guard: a charger is in: sleep is blocked, the cover only locks the screen (%s; "
                "KEEP_AWAKE=0 turns this off)" % why, syslog.LOG_NOTICE)
        else:
            log("iceland-battery-guard: a charger is in: sleep and the lid switch are blocked (%s; KEEP_AWAKE=0 "
                "turns this off)" % why, syslog.LOG_NOTICE)

    def status_line(self, plugged, temp, volt, soc, vbus):
        """the journal's record of what was plugged in and how it charged (plug-in, 10 s later, every 10 min, unplug)"""
        now = time.monotonic()
        changed = plugged != self.was_plugged
        first = self.was_plugged is None
        self.was_plugged = plugged
        if changed and not plugged:
            self.status_at = None
            if not first:
                log("iceland-battery-guard: charger unplugged at %s %%" % ("?" if soc is None else soc),
                    syslog.LOG_NOTICE)
            return
        if not plugged or (not changed and self.status_at is not None and now - self.status_at < STATUS_S):
            return
        # after the plug-in line the next one comes 10 s later (the kernel's setup has finished by then)
        self.status_at = now - STATUS_S + 10 if changed else now
        lim = num(rd(USB + "/input_current_limit")); cur = num(rd(USB + "/current_now"))
        ib = num(rd(BAT + "/current_now")); cap = num(rd(BAT + "/constant_charge_current_max"))
        ma = lambda v: "?" if v is None else "%d" % round(v / 1000.0)
        log("iceland-battery-guard: charger in: type %s, VBUS %s V, input %s of %s mA; battery %s %%, %s V, %s C, "
            "%s mA, %s; charge cap %s mA, %s" % (
                selected(rd(USB + "/usb_type")), "?" if vbus is None else "%.2f" % vbus, ma(cur), ma(lim),
                "?" if soc is None else soc, "?" if volt is None else "%.3f" % volt,
                "?" if temp is None else "%.1f" % temp, ma(ib), rd(BAT + "/status", "?"), ma(cap),
                selected(rd(BAT + "/charge_behaviour"))), syslog.LOG_NOTICE)

    def input_over(self, plugged):
        """OURS: the measured input current is above the limit the firmware reports, several readings in a row"""
        lr = rdx(USB + "/input_current_limit"); cr = rdx(USB + "/current_now")
        if plugged and (lr is UNKNOWN or cr is UNKNOWN):
            return None            # 0.23: a failed read neither counts nor resets the readings in a row
        lim = num(lr); cur = num(cr)
        if plugged and lim and cur is not None and cur > lim * ICL_OVER_FACTOR + ICL_OVER_UA:
            self.icl_over += 1
        else:
            self.icl_over = 0
        if self.icl_over >= ICL_OVER_COUNT:
            return "input current %d mA above its limit %d mA" % (round(cur / 1000.0), round(lim / 1000.0))
        return None

    def report_inputs(self):
        """log once at start which inputs and knobs exist (a missing one disables its rules)"""
        zones = usb_zones()
        have = {"charge_behaviour": os.path.exists(BAT + "/charge_behaviour"),
                "constant_charge_current_max": os.path.exists(BAT + "/constant_charge_current_max"),
                "input suspend lever": lever_present(),
                "usb-therm zone": bool(zones),
                "battery voltage": rdx(BAT + "/voltage_now") is not None,   # 0.23: unreadable now is not MISSING
                "USB voltage": rdx(USB + "/voltage_now") is not None}
        missing = [k for k, ok in have.items() if not ok]
        log("iceland-battery-guard: inputs " + ", ".join("%s %s" % (k, "ok" if ok else "MISSING") for k, ok in have.items()),
            syslog.LOG_WARNING if missing else syslog.LOG_NOTICE)
        lim = charge_limit(); tcap = thermal_cap()
        log("iceland-battery-guard: USB-C zones %s; charge limit %s%s; awake while a charger is in: %s; "
            "thermal charge cap %s" % (
            " ".join(sorted(zones)) or "none",
            "unknown (the kernel's thresholds can't be read now)" if lim is UNKNOWN else
            "%d %% (resume at %d %%)" % lim if lim else "off",
            ", from the kernel's thresholds" if limit_from_kernel() not in (None, UNKNOWN) else "",
            "off (KEEP_AWAKE=0)" if conf().get("KEEP_AWAKE", "1") == "0" else "on",
            "off (THERMAL_CAP=0)" if conf().get("THERMAL_CAP", "1") == "0" else
            "%d mA" % tcap if tcap else "none now (%s)" % THERMAL_CAP), syslog.LOG_NOTICE)
        log("iceland-battery-guard: with a charger in the block covers %s (%s)" % awake_what(), syslog.LOG_NOTICE)
        log("iceland-battery-guard: bypass charging %s (requests in %s)" % (
            "off (BYPASS=0)" if conf().get("BYPASS", "1") == "0" else "allowed", BYPASS_REQ), syslog.LOG_NOTICE)
        return missing

    def limit_stop(self, soc):
        """the charge limit's stop reason, or None"""
        lim = charge_limit()
        if lim is UNKNOWN or (soc is None and self.soc_unknown and lim is not None):
            # 0.23: the thresholds or the level can't be read now: the hold stays as it was
            if self.limit_hold and lim is not UNKNOWN:
                return "charge limit %d %% (resumes at %d %%)" % lim
            if self.limit_hold:
                return "charge limit (held: the kernel's thresholds can't be read now)"
            return None
        if lim is None or soc is None:
            self.limit_hold = None
            return None
        if soc >= lim[0]:
            self.limit_hold = True
        elif soc <= lim[1]:
            self.limit_hold = False
        elif self.limit_hold is None:
            self.limit_hold = True     # started between the two levels: wait for the resume level
        if self.limit_hold:
            return "charge limit %d %% (resumes at %d %%)" % lim
        return None

    def drop_bypass(self, why):
        """end the bypass request (unplug, lease, BYPASS=0, a bad file)"""
        if DRYRUN:
            print("DRYRUN: remove %s" % os.path.basename(BYPASS_REQ), flush=True)
        try:
            os.remove(BYPASS_REQ)
        except OSError:
            pass
        self.bp_end = why
        log("iceland-battery-guard: bypass charging ended: %s" % why, syslog.LOG_NOTICE)

    def bypass_publish(self, req, plugged, soc, hold):
        """/run/iceland/bypass-state for the toggle, rewritten at every step (its age tells the toggle that the
        guard runs; a tmpfs write every 5 / 15 s)"""
        lines = ["requested=%d" % (req is not None), "threshold=%s" % (req[0] if req else ""),
                 "until=%s" % ("%.0f" % req[1] if req else ""), "plugged=%d" % bool(plugged),
                 "soc=%s" % ("" if soc is None else soc), "holding=%d" % bool(hold),
                 "level=%s" % ("" if self.bp_level is None else self.bp_level), "topup=%d" % self.bp_topup,
                 "ended=%s" % (self.bp_end or "").replace("\n", " ")]
        text = "\n".join(lines) + "\n"
        try:
            os.makedirs(RUN, exist_ok=True)
            with open(BYPASS_STATE + ".tmp", "w") as f:
                f.write(text)
            os.chmod(BYPASS_STATE + ".tmp", 0o644)
            os.replace(BYPASS_STATE + ".tmp", BYPASS_STATE)
            self.bp_state = text
        except OSError:
            pass                   # the toggle then shows no state; charging decisions do not depend on it

    def bypass_stop(self, plugged, soc):
        """bypass charging: the hold reason, or None. Only ever a reason to stop: at or above the threshold the level
        is held (stock simple strategy: 1 % lower -> charge until the level is back); ends at unplug and expiry"""
        req = read_bypass()
        end = None
        if req is not None:
            if conf().get("BYPASS", "1") == "0":
                end = "BYPASS=0 in the configuration"
            elif req == "bad":
                end = "the request file can't be used"
            elif not plugged:
                end = "the charger was unplugged"
            elif self.usb_latched or self.cut_why or self.suspended:
                end = "a charger-input safety stop is in force (%s)" % (self.cut_why or self.usb_why or "input cut")
            elif req[1] <= time.time():
                end = "the request was not renewed (5-minute lease, as stock)"
            elif req[1] - time.time() > BYPASS_LEASE_MAX:
                end = "the request's end time is not plausible"
        if end:
            self.drop_bypass(end)
            req = None
        if req is not None:
            self.bp_end = None
        if req is not None and soc is None and self.soc_unknown and self.bp_level is not None:
            # 0.23: the level can't be read now: a hold in force stays (and a top-up goes on) until it reads again
            hold = not self.bp_topup
            self.bypass_publish(req, plugged, soc, hold)
            return "bypass charging: holding at %d %% (threshold %d %%)" % (self.bp_level, req[0]) if hold else None
        if req is None or soc is None:
            self.bp_level, self.bp_topup = None, False
            self.bypass_publish(req, plugged, soc, False)
            return None
        thr = req[0]
        if self.bp_level is not None and thr > self.bp_level:
            self.bp_level, self.bp_topup = None, False      # a higher threshold: charge up to it first
        if self.bp_level is None:
            if soc >= thr:
                self.bp_level = soc
                log("iceland-battery-guard: bypass charging: holding at %d %% (threshold %d %%), the tablet runs "
                    "from the charger" % (soc, thr), syslog.LOG_NOTICE)
        elif soc <= self.bp_level - BYPASS_DROP:
            self.bp_topup = True
        elif soc >= self.bp_level:
            self.bp_topup = False
        hold = self.bp_level is not None and not self.bp_topup
        self.bypass_publish(req, plugged, soc, hold)
        if hold:
            return "bypass charging: holding at %d %% (threshold %d %%)" % (self.bp_level, thr)
        return None

    def release_bypass(self):
        """the guard stops: a stop that was bypass's alone must not outlive it - the kernel keeps an inhibit until it
        is written again, also across unplugging - so charging is allowed again; any other stop stays (OURS)"""
        if not (self.bp_only and self.inhibited):
            return
        self.bp_only = False
        if os.path.exists(BAT + "/charge_behaviour") and wr(BAT + "/charge_behaviour", "auto"):
            self.inhibited = False
            log("iceland-battery-guard: stopping: bypass charging's hold released, charging allowed", syslog.LOG_NOTICE)

    def inhibit(self, on, why=""):
        cb = BAT + "/charge_behaviour"
        want = "inhibit-charge" if on else "auto"
        # re-read every step: something else may have changed it (or an earlier write failed)
        if self.inhibited == on and behaviour(rd(cb)) == want:
            return
        ok = os.path.exists(cb) and wr(cb, want)
        if not ok:
            now = time.monotonic()
            if on and (self.warned_at is None or now - self.warned_at >= REWARN_S):
                log("iceland-battery-guard: must stop charging (%s) but can't; unplug the charger" % why, syslog.LOG_CRIT)
                run(["wall", "OnePlus Pad 4: unplug the charger (%s)" % why])
                self.warned_at = now
            return                 # not cached: the next step tries again
        if self.inhibited != on:
            log("iceland-battery-guard: " + ("charging stopped: " + why if on else "charging allowed"),
                syslog.LOG_WARNING if on else syslog.LOG_NOTICE)
        self.inhibited = on
        self.warned_at = None

    def attached(self, online):
        """a cable is in: the firmware's online, or - while this guard holds the input cut, when the firmware may
        report the charger offline - the kernel's present (the port's CID, kernel-iceland). A present that exists
        but cannot be read (a glink error) counts as IN: the cut must not end because of a read failure (stock
        holds its stop until the CC detect change). A kernel without the attribute leaves it to online.
        0.23: online None = it exists but cannot be read (-110): UNKNOWN, never "unplugged" - present decides when it
        reads, else the previous decision stays (the first step: in), so no latch, cut or check ends on a failed read"""
        p = USB + "/present"
        if online is None:
            pv = rdx(p)
            if pv is not None and pv is not UNKNOWN:
                self.unreadable("qcom-battmgr-usb/online", "the port's present decides whether a cable is in")
                return pv != "0"
            keep = True if self.plugged_last is None else self.plugged_last
            self.unreadable("qcom-battmgr-usb/online", "a cable counts as %s (the previous decision; latches and the "
                            "input cut stay)" % ("in" if keep else "out"))
            return keep
        self.readable("qcom-battmgr-usb/online")
        if online or not self.suspended:
            return online
        if not os.path.exists(p):
            return online
        return rd(p) != "0"

    def suspend_input(self, on, why=""):
        """stock's input suspend at a connector / input-current stop (header "USB-C input cut") through
        kernel-iceland's qcom-battmgr-usb/input_current_limit: 0 = cut; the value read before the cut (else
        ICL_RELEASE_UA) = allowed again. No lever (older kernel) or INPUT_SUSPEND=0: charging off stays the only
        lever, said once per REWARN_S"""
        p = USB + "/input_current_limit"
        if on and conf().get("INPUT_SUSPEND", "1") == "0":
            on = False
        cur = rdx(p)
        now = time.monotonic()
        if cur is UNKNOWN:
            # 0.23: the lever exists but can't be read now (-110): a cut is never given back on a failed read (the
            # release waits), and a cut that is due is written anyway (the safe direction; icl_before stays)
            ours = self.suspended or os.path.exists(CUT_MARK)
            if not on:
                if ours:
                    self.unreadable("qcom-battmgr-usb/input_current_limit", "the input cut stays, the release waits")
                return
            if self.suspended:
                return             # ours, written before: kept
            self.unreadable("qcom-battmgr-usb/input_current_limit", "the input cut is written without reading it first")
        elif cur is not None:
            self.readable("qcom-battmgr-usb/input_current_limit")
        if cur is None or (on and not lever_present()):
            if on and (self.lever_at is None or now - self.lever_at >= REWARN_S):
                log("iceland-battery-guard: no input suspend lever (%s): the stop (%s) only switches charging off" % (p, why))
                self.lever_at = now
            return
        if on and cur == "0" and self.suspended:
            return                 # ours, in force
        if not on and cur != "0":
            self.suspended = False # the input is allowed: nothing of ours in force
            return
        if not on and not self.suspended and not os.path.exists(CUT_MARK):
            self.suspended = False # a 0 that is not ours (no cut of this boot: the firmware's own value): left to the kernel
            return
        if on:
            if cur != "0" and cur is not UNKNOWN:
                self.icl_before = cur
            self.mark(why, True)   # the marker FIRST: a guard that dies between the two writes leaves no cut without it
            ok = wr(p, "0")
            back = None
            if not ok:
                self.mark(why, False)
        else:
            back = self.icl_before if self.icl_before and self.icl_before.isdigit() and int(self.icl_before) > 0 else str(ICL_RELEASE_UA)
            ok = wr(p, back)
        if not ok:
            if self.lever_at is None or now - self.lever_at >= REWARN_S:
                if on:
                    log("iceland-battery-guard: must cut the charger input (%s) but can't; unplug the charger" % why, syslog.LOG_CRIT)
                else:
                    log("iceland-battery-guard: can't give the charger input back yet (the kernel or the firmware refused "
                        "the release); tried again every step")
                self.lever_at = now
            return                 # not cached: the next step tries again
        if self.suspended != on:   # said at the change only (a lever whose read-back lags would otherwise repeat it)
            if on:
                log("iceland-battery-guard: charger input cut: %s (the tablet runs from its battery until the cable is "
                    "out and the connector reads below %.0f C)" % (why, USB_RELEASE_T))
            else:
                log("iceland-battery-guard: charger input allowed again (input_current_limit %s)" % back, syslog.LOG_NOTICE)
        self.suspended = on
        self.lever_at = None
        if not on:
            self.mark(why, False)

    def mark(self, why, on):
        """this boot's marker of the cut (CUT_MARK on tmpfs): a guard restarted within the boot adopts the cut only
        with it; written before the cut, removed when the cut write fails and after the release"""
        try:
            if on:
                os.makedirs(RUN, mode=0o755, exist_ok=True)
                with open(CUT_MARK, "w") as f:
                    f.write("%s\n%d\n" % (why, int(time.time())))
            elif os.path.exists(CUT_MARK):
                os.remove(CUT_MARK)
        except OSError as e:
            log("iceland-battery-guard: can't keep %s: %s" % (CUT_MARK, e))

    def alert(self, stop, plugged):
        """one event per change of the safety stop in force into ALERT (header "Desktop notice"): a stop the user
        should see begins or changes its class (kind stop), or ends (kind resume; plugged says whether the cable
        is still in)"""
        cls = alert_class(stop)
        if not self.alert_read:
            self.alert_read = True
            for line in (rd(ALERT, "") or "").splitlines():
                if line.startswith("seq=") and line[4:].isdigit():
                    self.alert_seq = int(line[4:])     # continue an earlier guard's numbering
        if cls == self.alert_cls:
            return
        prev, self.alert_cls = self.alert_cls, cls
        self.alert_seq += 1
        why = stop if cls else ("charger unplugged" if not plugged else "charging allowed again")
        text = "seq=%d\nkind=%s\nclass=%s\nwhy=%s\ninput=%s\nplugged=%d\nat=%d\n" % (
            self.alert_seq, "stop" if cls else "resume", cls or prev, why.replace("\n", " "),
            "suspended" if self.suspended else "kept", 1 if plugged else 0, int(time.time()))
        try:
            os.makedirs(RUN, mode=0o755, exist_ok=True)
            with open(ALERT + ".tmp", "w") as f:
                f.write(text)
            os.chmod(ALERT + ".tmp", 0o644)
            os.replace(ALERT + ".tmp", ALERT)
            self.alert_fail = False
        except OSError as e:
            if not self.alert_fail:
                log("iceland-battery-guard: can't write %s: %s" % (ALERT, e))
            self.alert_fail = True

    def set_fcc(self, ma):
        if self.fcc == ma:
            return
        p = BAT + "/constant_charge_current_max"
        if os.path.exists(p) and wr(p, str(ma * 1000)):
            log("iceland-battery-guard: charge current cap %d mA" % ma, syslog.LOG_NOTICE)
            self.fcc = ma          # cached only on success: a failed write is retried next step

    def step(self):
        t = rd(BAT + "/temp"); v = rd(BAT + "/voltage_now"); st = rdx(BAT + "/status")
        st = "" if st is None else st      # absent: as before; UNKNOWN (0.23): the 3.3 V counter is kept below
        temp = int(t) / 10.0 if t and t.lstrip("-").isdigit() else None   # tenths of a degree C (unreadable: a stop)
        volt = int(v) / 1e6 if v and v.isdigit() else None                 # uV (unreadable: a stop)
        o = rdx(USB + "/online")
        online = None if o is UNKNOWN else o == "1"   # 0.23: None = unknown (attached() keeps the decision), never "out"
        vb = rd(USB + "/voltage_now")
        vbus = int(vb) / 1e6 if vb and vb.isdigit() else None               # uV
        # a cut left by an earlier guard of THIS boot (a restart; CUT_MARK is on tmpfs, the kernel's state is fresh at
        # every boot, and the lever also reads 0 when the firmware's own limit is 0, e.g. before the first attach):
        # stock holds its stop until the unplug and the connector below 55 C, so the cut is adopted as a latched
        # connector stop at the first decision, BEFORE "a cable is in" is decided (with the cut adopted, present
        # decides it: a firmware that reports the charger offline while suspended must not turn this into an in-cable
        # release); the normal path then keeps or releases it. A marker without a cut in the kernel is stale.
        if self.suspended is None and os.path.exists(CUT_MARK):
            icl = rdx(USB + "/input_current_limit")
            if icl == "0" or icl is UNKNOWN:  # 0.23: an unreadable lever with this boot's marker: the cut is adopted
                self.suspended = True
                self.usb_latched = True
                self.usb_why = self.cut_why = "USB connector was too hot before this guard started (input cut found at start)"
                log("iceland-battery-guard: the charger input was cut before this guard started: kept until the cable "
                    "is out and the connector reads below %.0f C" % USB_RELEASE_T, syslog.LOG_NOTICE)
            else:
                try:
                    os.remove(CUT_MARK)
                except OSError:
                    pass
        plugged = self.attached(online)
        self.plugged_last = plugged
        c = rdx(BAT + "/capacity")
        self.soc_unknown = c is UNKNOWN    # 0.23: the charge limit's and bypass's holds stay as they were
        soc = int(c) if c and c is not UNKNOWN and c.isdigit() else None
        ut = usb_therm()
        self.keep_awake(plugged)
        if plugged and ut is None:
            now = time.monotonic()
            if self.missing_at is None or now - self.missing_at >= REWARN_S:
                log("iceland-battery-guard: no valid USB-C connector temperature: the connector rules are off")
                self.missing_at = now

        # shutdowns
        if temp is not None and temp >= T_EMERGENCY:
            log("iceland-battery-guard: battery %.1f C, powering off NOW" % temp, syslog.LOG_CRIT)
            run(["systemctl", "poweroff", "-ff"])
        elif temp is not None and temp >= T_POWEROFF:
            log("iceland-battery-guard: battery %.1f C, powering off" % temp, syslog.LOG_CRIT)
            run(["systemctl", "poweroff"])
        if st is UNKNOWN:
            pass                   # 0.23: status can't be read now: the low-voltage count is neither raised nor reset
        elif st == "Discharging" and volt is not None and volt < V_UV:
            self.uv_count += 1
            if self.uv_count >= UV_COUNT:
                log("iceland-battery-guard: battery %.3f V < %.2f V, powering off" % (volt, V_UV), syslog.LOG_CRIT)
                run(["systemctl", "poweroff"])
        else:
            self.uv_count = 0

        # the USB-C connector latch lasts until the charger is unplugged, as on stock
        if not plugged:
            self.usb_latched = False
            self.usb_why = None
            self.prev_ut = None
        why = usb_stop(ut, temp)
        if not why and plugged and ut is not None and self.prev_ut is not None and ut - self.prev_ut >= USB_RISE_FAST:
            why = "USB connector rose %.1f C in one step (%.1f C)" % (ut - self.prev_ut, ut)
        cut = why                  # the connector stops cut the input (stock's usbtemp action); VBUS over-voltage does not
        if not why and (plugged or online is None) and vbus is not None and vbus > VBUS_OV:
            why = "VBUS %.2f V above %.1f V" % (vbus, VBUS_OV)
        over = self.input_over(plugged)
        if not why and over:
            why = over
            cut = over             # OURS: the input over-limit stop cuts the input too (the input is what misbehaves)
        if plugged:
            self.prev_ut = ut
        if why:
            self.usb_latched = True
            self.usb_why = why
            if cut:
                self.cut_why = cut

        # charging decision
        stop = None
        if temp is None:
            stop = "battery temperature unreadable"
        else:
            self.region = region(temp, self.region)
            r = self.region
            if FCC_MA[r] == 0:
                stop = "battery %.1f C outside -10..53 C" % temp
            elif volt is None:
                stop = "battery voltage unreadable"
            elif volt >= V_OV:
                stop = "over-voltage %.3f V" % volt
                self.v_stop = True
            elif volt is not None and volt > SW_OVER_FV[r]:
                stop = "%.3f V above %.3f V at %.1f C" % (volt, SW_OVER_FV[r], temp)
                self.v_stop = True
            elif self.v_stop and volt is not None and volt >= VBATDET[r]:
                stop = "waiting for %.3f V to recharge" % VBATDET[r]   # stock recharge threshold
            else:
                self.v_stop = False
        limit = self.limit_stop(soc)
        if stop is None:
            stop = limit
        try:
            bypass = self.bypass_stop(plugged, soc)  # only ever one more reason to stop
        except Exception as e:                       # OURS: a fault in bypass ends bypass, never the stock rules
            bypass = None
            self.bp_level, self.bp_topup = None, False
            self.drop_bypass("internal error (%s: %s)" % (type(e).__name__, e))
        self.bp_only = stop is None and bypass is not None and not self.usb_latched
        if stop is None:
            stop = bypass
        if self.usb_latched:
            stop = why or "%s (unplug to reset)" % (self.usb_why or "USB connector was too hot")
        self.inhibit(stop is not None, stop or "")
        # the input cut lasts until the cable is out, the connector reads below USB_RELEASE_T (stock's recover)
        # and no connector rule fired this step
        if self.cut_why and not plugged and not cut and (ut is None or ut < USB_RELEASE_T):
            self.cut_why = None
        self.suspend_input(self.cut_why is not None, self.cut_why or "")
        self.alert(stop, plugged)

        if temp is not None:
            self.cooling = usb_cool(ut, temp, self.cooling)
            cap = FCC_MA[self.region]
            if self.cooling:
                cap = min(cap, USB_COOL_MA)
            tcap = thermal_cap()
            if tcap:
                cap = min(cap, tcap)
            if cap:
                self.set_fcc(cap)
        self.status_line(plugged, temp, volt, soc, vbus)
        return plugged

def main():
    syslog.openlog("iceland-battery-guard")
    if not os.path.isdir(BAT):
        log("no %s, nothing to guard" % BAT)
        return 0
    g = Guard()
    signal.signal(signal.SIGTERM, lambda *a: sys.exit(0))   # so that the sleep block is given back
    g.report_inputs()
    try:
        while True:
            plugged = g.step()
            if ONESHOT:
                return 0
            time.sleep(5 if plugged else 15)
    finally:
        if not ONESHOT:
            g.release_bypass()            # OURS: a hold that was bypass's alone ends with the guard
        g.keep_awake(False, quiet=True)   # the guard stops: give the block back

if __name__ == "__main__":
    sys.exit(main())
