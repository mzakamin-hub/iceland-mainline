#!/usr/bin/python3
# SPDX-License-Identifier: GPL-2.0-or-later
#
# iceland-battery-guard: a second safety layer for charging on the OnePlus Pad 4 under mainline Linux.
# On stock, the OnePlus charging stack (oplus_chg) enforces these limits; mainline only has the SoCCP charger
# firmware + qcom_battmgr. Until it is proven that the firmware enforces them by itself (PLAN 5-PM C step 2), this
# service watches the battery and stops charging, lowers the charge current, or shuts down at the stock limits.
#
# Every limit is the Pad 4's stock 11.A.38 value (live stock DT capture 2; KNOWLEDGE rule 13), unless marked OURS.
# The kernel side (qcom_battmgr, Pad 4) already applies the stock per-charger-type input and charge currents.
#
#  oplus,comm  batt-them-thr (decidegC) = -100 0 50 120 160 350 450 530 -> 9 temperature regions R0..R8
#              sw-over-fv-mv  (per region) = 4508 x6, 4488, 4138, 4138   -> stop charging above this
#              wired-vbatdet-mv (per region) = 0 4200 4300 4400 4400 4400 4380 4030 0 -> recharge below this
#              vbatt-ov-thr-mv = 4600                                   -> over-voltage, stop charging
#              poweroff_high_batt_temp = 720, poweroff_emergency_batt_temp = 770 (decidegC); the framework's
#              own high-temperature protection shuts down earlier, at 700 (odm sys_high_temp_protect
#              HighTemperatureProtectShutDown), so the guard powers off at 70 C and forces it at 77 C
#              vbat_uv_thr_mv = 3300                                    -> power off when discharging below it
#  oplus,wired led_on-fccmax-ma (per region) = 0 1959 3300 3300 3300 3300 3300 1000 0 -> charge current cap
#              (the screen-on table, used always: it is the lower one; 0 = no charging, i.e. below -10 C and
#              at/above 53 C)
#  oplus,mms_wired (USB-C connector: stock reads usb_temp_adc_l / _r; the guard takes the hottest valid reading of
#              the usb-temp-l, usb-temp-r and usb-therm zones):
#              stop  : usb >= usbtemp_ntc_temp_low 57 C (battery <= usbtemp_batt_temp_low 50 C),
#                      usb >= usbtemp_ntc_temp_high 69 C (battery above 50 C),
#                      or usb - battery >= 7 / 12 / 15 C (usbtemp_temp_gap_low_with_batt_temp /
#                      _high_with_batt_temp / _with_batt_temp_in_over_hot, the last from battery >= 60 C
#                      usbtemp_batt_temp_over_hot); stock then stays stopped until the charger is unplugged.
#              cool down: usb >= 54 / 65 C or gap >= 12 / 20 C -> 1200 mA (usbtemp_cool_down_*,
#                      cool_down_pdqc_curr_ma level 1); recover below 48 / 60 C and gap below 6 / 15 C.
#              rise fast: the connector warming by rise_fast_temp 3 C -> stop (latched like the other USB stops).
#  VBUS over-voltage: stock's charger OV is 11000 mV -> stop (latched until unplugged).
#  OURS (not stock values): the 45 C floor for the gap rules (stop and cool-down) (as in the OnePlus usbtemp code; PC verifies it in the
#  OnePlusOSS source, relay 013), 2 C temperature hysteresis on region changes, 3 consecutive low-voltage readings
#  before a power-off (load dips), "no charging while the battery temperature or voltage can't be read", the
#  rise-fast window (one 5 s sample; stock counts over 20-30 samples), a failed stop being retried every step
#  with the warning repeated every 5 minutes, connector readings outside -30..125 C treated as a broken channel,
#  and the charge limit (CHARGE_LIMIT / CHARGE_RESUME in /etc/iceland/battery-guard.conf, the user's 85 %): at
#  or above the limit charging stops, and it starts again at or below the resume level.
import glob, os, subprocess, sys, syslog, time

BAT = os.environ.get("ICELAND_BAT", "/sys/class/power_supply/qcom-battmgr-bat")
USB = os.environ.get("ICELAND_USB", "/sys/class/power_supply/qcom-battmgr-usb")
THERMAL = os.environ.get("ICELAND_THERMAL", "/sys/class/thermal")
CONF = os.environ.get("ICELAND_GUARD_CONF", "/etc/iceland/battery-guard.conf")
DRYRUN = os.environ.get("ICELAND_GUARD_DRYRUN") == "1"   # tests: print actions instead of running them
ONESHOT = os.environ.get("ICELAND_GUARD_ONESHOT") == "1"

REGION_THR = [-10.0, 0.0, 5.0, 12.0, 16.0, 35.0, 45.0, 53.0]
SW_OVER_FV = [4.508, 4.508, 4.508, 4.508, 4.508, 4.508, 4.488, 4.138, 4.138]
VBATDET = [0.0, 4.200, 4.300, 4.400, 4.400, 4.400, 4.380, 4.030, 0.0]
FCC_MA = [0, 1959, 3300, 3300, 3300, 3300, 3300, 1000, 0]
V_OV = 4.600
T_POWEROFF = 70.0                         # stock framework (see header); the DT's own step is 72.0
T_EMERGENCY = 77.0
V_UV = 3.300
USB_STOP_LOW, USB_STOP_HIGH = 57.0, 69.0
USB_BATT_LOW, USB_BATT_OVER_HOT = 50.0, 60.0
USB_GAP_LOW, USB_GAP_HIGH, USB_GAP_OVER_HOT = 7.0, 12.0, 15.0
USB_GAP_FLOOR = 45.0                      # OURS (see header)
USB_COOL_LOW, USB_COOL_HIGH = 54.0, 65.0
USB_COOL_GAP_LOW, USB_COOL_GAP_HIGH = 12.0, 20.0
USB_REC_LOW, USB_REC_HIGH = 48.0, 60.0
USB_REC_GAP_LOW, USB_REC_GAP_HIGH = 6.0, 15.0
USB_COOL_MA = 1200
USB_RISE_FAST = 3.0                       # rise_fast_temp (C)
VBUS_OV = 11.0                            # stock charger OV (V)
HYST_T = 2.0                              # OURS
UV_COUNT = 3                              # OURS
REWARN_S = 300                            # OURS: repeat a "can't stop charging" warning every 5 min
USB_ZONES = ("usb-temp-l-thermal", "usb-temp-r-thermal", "usb-therm-thermal", "usb-therm")
USB_VALID = (-30.0, 125.0)                # OURS: outside = a broken channel, not a temperature
LIMIT_MIN = 50                            # OURS: a CHARGE_LIMIT below this is ignored

def rd(path, default=None):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default

def wr(path, value):
    if DRYRUN:
        print("DRYRUN: %s <- %s" % (os.path.basename(path), value), flush=True)
    try:
        with open(path, "w") as f:
            f.write(value)
        return True
    except OSError:
        return False

def log(msg, prio=syslog.LOG_WARNING):
    syslog.syslog(prio, msg)
    print(msg, flush=True)

def run(cmd):
    if DRYRUN:
        print("DRYRUN: " + " ".join(cmd), flush=True)
        return 0
    return subprocess.call(cmd)

def usb_zones():
    """the USB-C connector zones present, {type: path}"""
    zs = {}
    for z in glob.glob(THERMAL + "/thermal_zone*"):
        t = rd(z + "/type", "")
        if t in USB_ZONES:
            zs[t] = z
    return zs

def usb_therm():
    """the hottest valid USB-C connector reading, or None"""
    vals = []
    for z in usb_zones().values():
        t = rd(z + "/temp")
        if t and t.lstrip("-").isdigit() and USB_VALID[0] < int(t) / 1000.0 < USB_VALID[1]:
            vals.append(int(t) / 1000.0)
    return max(vals) if vals else None

def charge_limit():
    """(limit, resume) in percent from CONF, or None when off (CHARGE_LIMIT 0/100/absent or unusable)"""
    c = {}
    for line in (rd(CONF, "") or "").splitlines():
        line = line.split("#", 1)[0]
        if "=" in line:
            k, v = line.split("=", 1)
            c[k.strip()] = v.strip()
    try:
        lim = int(c.get("CHARGE_LIMIT", "0"))
        res = int(c.get("CHARGE_RESUME", str(lim - 5)))
    except ValueError:
        return None
    if not LIMIT_MIN <= lim < 100:
        return None
    return lim, max(0, min(res, lim - 1))

def behaviour(value):
    """charge_behaviour as the kernel shows it ("[auto] inhibit-charge") or as a plain word"""
    if value and "[" in value:
        return value[value.index("[") + 1:value.index("]")]
    return value

def region(temp, prev):
    """stock region index; leaving the current region needs HYST_T of margin (OURS)"""
    r = sum(1 for t in REGION_THR if temp >= t)
    if prev is not None and r != prev:
        lo = REGION_THR[prev - 1] if prev > 0 else -1e9
        hi = REGION_THR[prev] if prev < len(REGION_THR) else 1e9
        # moving towards the safe middle needs margin; moving towards an extreme is immediate
        towards_middle = abs(r - 5) < abs(prev - 5)
        if towards_middle and lo - HYST_T < temp < hi + HYST_T:
            return prev
    return r

def usb_stop(ut, temp):
    if ut is None or temp is None:
        return None
    if temp <= USB_BATT_LOW:
        lim, gap = USB_STOP_LOW, USB_GAP_LOW
    elif temp < USB_BATT_OVER_HOT:
        lim, gap = USB_STOP_HIGH, USB_GAP_HIGH
    else:
        lim, gap = USB_STOP_HIGH, USB_GAP_OVER_HOT
    if ut >= lim:
        return "USB connector %.1f C >= %.0f C" % (ut, lim)
    if ut >= USB_GAP_FLOOR and ut - temp >= gap:
        return "USB connector %.1f C is %.1f C above the battery" % (ut, ut - temp)
    return None

def usb_cool(ut, temp, cooling):
    if ut is None or temp is None:
        return False
    low = temp <= USB_BATT_LOW
    if cooling:
        rec, rgap = (USB_REC_LOW, USB_REC_GAP_LOW) if low else (USB_REC_HIGH, USB_REC_GAP_HIGH)
        return not (ut < rec and ut - temp < rgap)
    lim, gap = (USB_COOL_LOW, USB_COOL_GAP_LOW) if low else (USB_COOL_HIGH, USB_COOL_GAP_HIGH)
    return ut >= lim or (ut >= USB_GAP_FLOOR and ut - temp >= gap)

class Guard:
    def __init__(self):
        self.inhibited = None      # the last state written successfully; None = unknown, write on first decision
        self.fcc = None
        self.region = None
        self.usb_latched = False
        self.usb_why = None        # why the USB latch was set (kept for the log until unplugged)
        self.prev_ut = None        # the connector temperature at the previous plugged step (rise-fast rule)
        self.cooling = False
        self.uv_count = 0
        self.warned_at = None      # when "can't stop charging" was last reported
        self.missing_at = None     # when a missing input was last reported while plugged
        self.v_stop = False        # stopped for voltage: resume only below the stock recharge voltage
        self.limit_hold = None     # charge limit: True = held at the limit until the resume level

    def report_inputs(self):
        """log once at start which inputs and knobs exist (a missing one disables its rules)"""
        zones = usb_zones()
        have = {"charge_behaviour": os.path.exists(BAT + "/charge_behaviour"),
                "constant_charge_current_max": os.path.exists(BAT + "/constant_charge_current_max"),
                "usb-therm zone": bool(zones),
                "battery voltage": rd(BAT + "/voltage_now") is not None,
                "USB voltage": rd(USB + "/voltage_now") is not None}
        missing = [k for k, ok in have.items() if not ok]
        log("iceland-battery-guard: inputs " + ", ".join("%s %s" % (k, "ok" if ok else "MISSING") for k, ok in have.items()),
            syslog.LOG_WARNING if missing else syslog.LOG_NOTICE)
        lim = charge_limit()
        log("iceland-battery-guard: USB-C zones %s; charge limit %s" % (
            " ".join(sorted(zones)) or "none",
            "%d %% (resume at %d %%)" % lim if lim else "off"), syslog.LOG_NOTICE)
        return missing

    def limit_stop(self, soc):
        """the charge limit's stop reason, or None"""
        lim = charge_limit()
        if lim is None or soc is None:
            self.limit_hold = None
            return None
        if soc >= lim[0]:
            self.limit_hold = True
        elif soc <= lim[1]:
            self.limit_hold = False
        elif self.limit_hold is None:
            self.limit_hold = True     # started between the two levels: wait for the resume level
        if self.limit_hold:
            return "charge limit %d %% (resumes at %d %%)" % lim
        return None

    def inhibit(self, on, why=""):
        cb = BAT + "/charge_behaviour"
        want = "inhibit-charge" if on else "auto"
        # re-read every step: something else may have changed it (or an earlier write failed)
        if self.inhibited == on and behaviour(rd(cb)) == want:
            return
        ok = os.path.exists(cb) and wr(cb, want)
        if not ok:
            now = time.monotonic()
            if on and (self.warned_at is None or now - self.warned_at >= REWARN_S):
                log("iceland-battery-guard: must stop charging (%s) but can't; unplug the charger" % why, syslog.LOG_CRIT)
                run(["wall", "OnePlus Pad 4: unplug the charger (%s)" % why])
                self.warned_at = now
            return                 # not cached: the next step tries again
        if self.inhibited != on:
            log("iceland-battery-guard: " + ("charging stopped: " + why if on else "charging allowed"),
                syslog.LOG_WARNING if on else syslog.LOG_NOTICE)
        self.inhibited = on
        self.warned_at = None

    def set_fcc(self, ma):
        if self.fcc == ma:
            return
        p = BAT + "/constant_charge_current_max"
        if os.path.exists(p) and wr(p, str(ma * 1000)):
            log("iceland-battery-guard: charge current cap %d mA" % ma, syslog.LOG_NOTICE)
            self.fcc = ma          # cached only on success: a failed write is retried next step

    def step(self):
        t = rd(BAT + "/temp"); v = rd(BAT + "/voltage_now"); st = rd(BAT + "/status", "")
        temp = int(t) / 10.0 if t and t.lstrip("-").isdigit() else None   # tenths of a degree C
        volt = int(v) / 1e6 if v and v.isdigit() else None                 # uV
        plugged = rd(USB + "/online", "0") == "1"
        vb = rd(USB + "/voltage_now")
        vbus = int(vb) / 1e6 if vb and vb.isdigit() else None               # uV
        c = rd(BAT + "/capacity")
        soc = int(c) if c and c.isdigit() else None
        ut = usb_therm()
        if plugged and ut is None:
            now = time.monotonic()
            if self.missing_at is None or now - self.missing_at >= REWARN_S:
                log("iceland-battery-guard: no valid USB-C connector temperature: the connector rules are off")
                self.missing_at = now

        # shutdowns
        if temp is not None and temp >= T_EMERGENCY:
            log("iceland-battery-guard: battery %.1f C, powering off NOW" % temp, syslog.LOG_CRIT)
            run(["systemctl", "poweroff", "-ff"])
        elif temp is not None and temp >= T_POWEROFF:
            log("iceland-battery-guard: battery %.1f C, powering off" % temp, syslog.LOG_CRIT)
            run(["systemctl", "poweroff"])
        if st == "Discharging" and volt is not None and volt < V_UV:
            self.uv_count += 1
            if self.uv_count >= UV_COUNT:
                log("iceland-battery-guard: battery %.3f V < %.2f V, powering off" % (volt, V_UV), syslog.LOG_CRIT)
                run(["systemctl", "poweroff"])
        else:
            self.uv_count = 0

        # the USB-C connector latch lasts until the charger is unplugged, as on stock
        if not plugged:
            self.usb_latched = False
            self.usb_why = None
            self.prev_ut = None
        why = usb_stop(ut, temp)
        if not why and plugged and ut is not None and self.prev_ut is not None and ut - self.prev_ut >= USB_RISE_FAST:
            why = "USB connector rose %.1f C in one step (%.1f C)" % (ut - self.prev_ut, ut)
        if not why and plugged and vbus is not None and vbus > VBUS_OV:
            why = "VBUS %.2f V above %.1f V" % (vbus, VBUS_OV)
        if plugged:
            self.prev_ut = ut
        if why:
            self.usb_latched = True
            self.usb_why = why

        # charging decision
        stop = None
        if temp is None:
            stop = "battery temperature unreadable"
        else:
            self.region = region(temp, self.region)
            r = self.region
            if FCC_MA[r] == 0:
                stop = "battery %.1f C outside -10..53 C" % temp
            elif volt is None:
                stop = "battery voltage unreadable"
            elif volt >= V_OV:
                stop = "over-voltage %.3f V" % volt
                self.v_stop = True
            elif volt is not None and volt > SW_OVER_FV[r]:
                stop = "%.3f V above %.3f V at %.1f C" % (volt, SW_OVER_FV[r], temp)
                self.v_stop = True
            elif self.v_stop and volt is not None and volt >= VBATDET[r]:
                stop = "waiting for %.3f V to recharge" % VBATDET[r]   # stock recharge threshold
            else:
                self.v_stop = False
        limit = self.limit_stop(soc)
        if stop is None:
            stop = limit
        if self.usb_latched:
            stop = why or "%s (unplug to reset)" % (self.usb_why or "USB connector was too hot")
        self.inhibit(stop is not None, stop or "")

        if temp is not None:
            self.cooling = usb_cool(ut, temp, self.cooling)
            cap = FCC_MA[self.region]
            if self.cooling:
                cap = min(cap, USB_COOL_MA)
            if cap:
                self.set_fcc(cap)
        return plugged

def main():
    syslog.openlog("iceland-battery-guard")
    if not os.path.isdir(BAT):
        log("no %s, nothing to guard" % BAT)
        return 0
    g = Guard()
    g.report_inputs()
    while True:
        plugged = g.step()
        if ONESHOT:
            return 0
        time.sleep(5 if plugged else 15)

if __name__ == "__main__":
    sys.exit(main())
