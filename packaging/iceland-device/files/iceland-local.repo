# iceland-device: kernel-iceland, iceland-device and our other packages from a local repository on the tablet.
# Filled by `iceland-repo-sync` (from the PC over USB network, a USB stick, or a directory) and by the build kits.
# 0.28-50: every package in it is signed with the project's RPM signing key (RSA 4096, fingerprint
# FF9C 6A4E 64CB 38F0 1035  AD7F 939B E983 CCA2 5574, /etc/pki/rpm-gpg/RPM-GPG-KEY-iceland; the private key never
# leaves the build PC), so dnf checks each package's signature (gpgcheck=1) and imports the key on first use. The
# repository metadata itself is not signed (repo_gpgcheck=0): it is root-owned local files.
# Fedora 45's rpm also refuses unsigned packages for a plain `rpm -i/-U` (%_pkgverify_level all); after
#     sudo rpm --import /etc/pki/rpm-gpg/RPM-GPG-KEY-iceland
# our signed packages install with plain rpm too.
[iceland-local]
name=OnePlus Pad 4 (kernel-iceland, iceland-device), local
baseurl=file:///var/lib/iceland/repo/aarch64
enabled=1
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-iceland
repo_gpgcheck=0
skip_if_unavailable=True
priority=10
