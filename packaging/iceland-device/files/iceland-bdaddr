#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# Apply the tablet's own Bluetooth address (stock persist.vendor.service.bdroid.bdaddr, written to
# /etc/iceland/bdaddr by the installer; never shipped) to the WCN7860 controller.
addr=$(tr -d ' \n' < /etc/iceland/bdaddr)
echo "$addr" | grep -Eq '^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$' || { echo "iceland-bdaddr: bad address in /etc/iceland/bdaddr" >&2; exit 1; }
for i in $(seq 1 20); do
	btmgmt --index 0 info >/dev/null 2>&1 && break
	sleep 0.5
done
cur=$(btmgmt --index 0 info 2>/dev/null | sed -n 's/^hci0:.*addr \([0-9A-F:]*\).*/\1/p')
[ "$(echo "$cur" | tr a-f A-F)" = "$(echo "$addr" | tr a-f A-F)" ] && exit 0
btmgmt --index 0 power off >/dev/null 2>&1
btmgmt --index 0 public-addr "$addr"
btmgmt --index 0 power on >/dev/null 2>&1
