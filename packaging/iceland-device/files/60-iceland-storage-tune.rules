# iceland-device 0.28-32 (optimization scan A7, 22 Oct 2026): I/O queue settings of the internal storage.
# - the UFS LUNs (multi-queue, fast): no I/O scheduler (bfq is the costliest per I/O)
# - the loop device over the Fedora carrier: 1 MiB read-ahead (the loop default 128 KiB; the device-mapper maps of
#   iceland.carrier.map=dm get 1 MiB from iceland-dmmap)
ACTION!="add|change", GOTO="iceland_tune_end"
SUBSYSTEM!="block", GOTO="iceland_tune_end"
KERNEL=="sd[a-z]", DEVPATH=="*/1d84000.ufs/*", ATTR{queue/scheduler}="none"
KERNEL=="loop[0-9]*", ENV{DEVTYPE}=="disk", ATTR{loop/backing_file}=="/dev/sd*", ATTR{queue/read_ahead_kb}="1024"
LABEL="iceland_tune_end"
