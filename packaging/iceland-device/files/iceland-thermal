def rd(path, default=None):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default

def rdint(path):
    v = rd(path)
    try:
        return int(v)
    except (TypeError, ValueError):
        return None

def wr(path, value):
    if DRYRUN:
        return True
    try:
        with open(path, "w") as f:
            f.write(str(value))
        return True
    except OSError:
        return False

# started by systemd with stdout in the journal (both variables are set for a service, not for a shell)
UNDER_SYSTEMD = bool(os.environ.get("INVOCATION_ID") and os.environ.get("JOURNAL_STREAM"))

def log(msg, prio=syslog.LOG_NOTICE):
    syslog.syslog(prio, msg)
    if not UNDER_SYSTEMD:      # a unit's stdout goes to the journal too: the syslog line is enough there
        print(msg, flush=True)

def read_conf():
    c = dict(DEFAULTS)
    for line in (rd(CONF, "") or "").splitlines():
        line = line.split("#", 1)[0]
        if "=" in line:
            k, v = line.split("=", 1)
            c[k.strip()] = v.strip()
    return c

def cint(c, key):
    try:
        return int(c[key])
    except (KeyError, ValueError):
        return int(DEFAULTS[key])

def zone_paths():
    """{type: path} of the thermal zones the estimate needs"""
    zs = {}
    for z in glob.glob(THERMAL + "/thermal_zone*"):
        t = rd(z + "/type", "")
        if t in ZONES:
            zs[t] = z
    return zs

def level_step(idx, temp_c):
    """stock's gear walk: up while the next entry threshold is reached, down while below the leave threshold"""
    while idx + 1 < len(UP) and temp_c >= UP[idx + 1]:
        idx += 1
    while idx >= 0 and temp_c < DOWN[idx]:
        idx -= 1
    return idx

def tuned_profile():
    return (rd(TUNED_ACTIVE, "") or "").strip()

def tuned_sysfs(name, seen=None):
    """the [sysfs] entries of a tuned profile, included profiles first"""
    seen = seen if seen is not None else set()
    if not name or name in seen:
        return {}
    seen.add(name)
    for d in TUNED_DIRS:
        text = rd(os.path.join(d, name, "tuned.conf"))
        if text is None:
            continue
        own, inc, sec = {}, None, None
        for line in text.splitlines():
            line = line.strip()
            if not line or line[0] in "#;":
                continue
            if line.startswith("[") and line.endswith("]"):
                sec = line[1:-1]
                continue
            if "=" not in line:
                continue
            k, v = (x.strip() for x in line.split("=", 1))
            if sec == "main" and k == "include":
                inc = v
            elif sec == "sysfs":
                own[k] = v
        out = tuned_sysfs(inc, seen) if inc else {}
        out.update(own)
        return out
    return {}

def mode_of(profile):
    if MODE:
        return MODE
    if "powersave" in profile or "power-saver" in profile:
        return "power-saver"
    if "performance" in profile:
        return "performance"
    return "balanced"

def screen_state():
    """0.28-8: "off" when the panel's DSI connector says dpms Off or a backlight has bl_power != 0, "on" when one
    of them reads and none says off, None when nothing reads (then the screen counts as on)"""
    seen = False
    for p in glob.glob(DRM + "/card*-DSI-*/dpms"):
        v = rd(p)
        if v is not None:
            seen = True
            if v.strip().lower() == "off":
                return "off"
    bls = [BACKLIGHT] if os.path.exists(BACKLIGHT + "/brightness") else glob.glob(BACKLIGHT + "/*")
    for d in bls:
        v = rdint(d + "/bl_power")
        if v is not None:
            seen = True
            if v != 0:
                return "off"
    return "on" if seen else None

def screen_off_entry(gear):
    """0.28-8: stock's screen_off entry for this gear: the nearest listed gear at or below it (Battery.apk o9/h.a0:
    exact lookup, then gear - 1 while nothing is found and gear >= 0); (listed gear, cpu level, gpu level) or None"""
    while gear >= 0:
        if gear in SCREEN_OFF_TABLE:
            return (gear,) + SCREEN_OFF_TABLE[gear]
        gear -= 1
    return None

def lower(a, b):
    """the smaller of two caps, None = no cap"""
    return b if a is None else a if b is None else min(a, b)

def bits(path, word=64):
    """a sysfs capability bitmap (hex words, the most significant first, one unsigned long each) as an int"""
    v = 0
    for w in (rd(path, "") or "").split():
        try:
            v = (v << word) | int(w, 16)
        except ValueError:
            return 0
    return v

EV_KEY, EV_REL, EV_ABS = 1, 2, 3
def input_kind(name):
    """0.28-8: why an evdev node counts as user input (touch, pen, touchpad, mouse, keyboard), or None (sensors,
    switches such as the cover's hall sensor, the power / volume keys)"""
    cap = INPUT_SYS + "/" + name + "/device/capabilities/"
    ev, key, ab, rel = bits(cap + "ev"), bits(cap + "key"), bits(cap + "abs"), bits(cap + "rel")
    has = lambda m, b: bool(m >> b & 1)
    if has(ev, EV_ABS) and has(ab, 0x35):                                     # ABS_MT_POSITION_X
        return "touch"
    if has(ev, EV_ABS) and has(ab, 0) and any(has(key, b) for b in (0x14a, 0x140, 0x145, 0x110)):
        return "pen/touchpad"                                                 # BTN_TOUCH / TOOL_PEN / TOOL_FINGER / LEFT
    if has(ev, EV_REL) and has(rel, 0) and has(key, 0x110):
        return "mouse"
    if has(ev, EV_KEY) and all(has(key, b) for b in (30, 44, 57)):           # KEY_A, KEY_Z, KEY_SPACE
        return "keyboard"
    return None

class Inputs:
    """0.28-8: the user's input devices in one epoll, read only (no grab: GNOME gets every event as before). A
    device that fires is drained and left disarmed (EPOLLONESHOT) until rearm(): at most one wake-up per
    BOOST_DEBOUNCE while input goes on. A signal wakes the poll through the wakeup pipe."""
    def __init__(self):
        self.ep = select.epoll()
        self.fds = {}              # node name -> fd
        self.armed = set()
        self.kinds = {}
        self.rd_pipe, self.wr_pipe = os.pipe()
        for p in (self.rd_pipe, self.wr_pipe):
            os.set_blocking(p, False)
        signal.set_wakeup_fd(self.wr_pipe)
        self.ep.register(self.rd_pipe, select.EPOLLIN)

    def scan(self):
        """open new devices, drop gone ones (called once per period)"""
        try:
            names = set(n for n in os.listdir(INPUT) if n.startswith("event"))
        except OSError:
            names = set()
        for n in list(self.fds):
            if n not in names:
                self.drop(n)
        for n in sorted(names - set(self.fds)):
            kind = input_kind(n)
            if kind is None:
                continue
            try:
                fd = os.open(os.path.join(INPUT, n), os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC)
            except OSError:
                continue
            self.fds[n], self.kinds[n] = fd, kind
            self.ep.register(fd, select.EPOLLIN | select.EPOLLONESHOT)
            self.armed.add(n)
            log("iceland-thermal: boost input %s (%s)" % (n, kind))

    def drop(self, n):
        fd = self.fds.pop(n, None)
        self.armed.discard(n); self.kinds.pop(n, None)
        if fd is not None:
            try:
                self.ep.unregister(fd)
            except (OSError, ValueError):
                pass
            os.close(fd)

    def drain(self, n):
        """read what is queued; True if there was input; a device that is gone is dropped"""
        fd, got = self.fds.get(n), False
        while fd is not None:
            try:
                b = os.read(fd, 4096)
            except BlockingIOError:
                break
            except OSError:
                self.drop(n)
                break
            if not b:
                self.drop(n)
                break
            got = True
        return got

    def wait(self, timeout):
        """True if a user input device fired within timeout (s)"""
        try:
            ev = self.ep.poll(max(0.0, timeout))
        except InterruptedError:
            ev = []
        hit = False
        byfd = {fd: n for n, fd in self.fds.items()}
        for fd, mask in ev:
            if fd == self.rd_pipe:
                try:
                    os.read(self.rd_pipe, 512)
                except OSError:
                    pass
                continue
            n = byfd.get(fd)
            if n is None:
                continue
            self.armed.discard(n)
            if mask & (select.EPOLLHUP | select.EPOLLERR):
                self.drop(n)
                continue
            hit = self.drain(n) or hit
        return hit

    def rearm(self):
        """after the debounce: a device with input queued meanwhile counts as input (and stays disarmed), the
        others are armed again"""
        hit = False
        for n in list(self.fds):
            if n in self.armed:
                continue
            if self.drain(n):
                hit = True
                continue
            if n in self.fds:
                try:
                    self.ep.modify(self.fds[n], select.EPOLLIN | select.EPOLLONESHOT)
                    self.armed.add(n)
                except OSError:
                    self.drop(n)
        return hit

    def all_armed(self):
        return len(self.armed) == len(self.fds)

class Thermal:
    def __init__(self):
        self.idx = -1              # index into UP / DOWN / STATUS; -1 = below the first threshold
        self.hist = []             # newest first: {zone: m C or None}
        self.hist_t = None
        self.zones = {}
        self.model = None
        self.model_mtime = None
        self.capped = {}           # sysfs path -> True while a cap of ours is in place
        self.bl_cdev = None        # the backlight's cooling device (directory), once found
        self.bl_held = False       # True while that device may hold a state of ours (not 0)
        self.bl_checked = False    # the first step clears a state an earlier run left behind
        self.last = None           # (raw gear, effective gear, mode) of the last log line
        self.warned = set()
        self.bat_unknown = False   # 0.23: the battery reading exists but failed in the last sample
        # 0.28-8: screen off and boost
        self.screen = None         # "on" / "off" / None (unreadable = on) at the last step
        self.cpu_paths = []        # the two scaling_max_freq paths
        self.cpu_cap = []          # what the gear wants there without a boost (the values set_max wrote)
        self.cpu_boost = None      # min(mode maximum, boostCeiling) per policy while a boost is allowed, else None
        self.boost_why = "init"    # why no boost is allowed ("" = allowed)
        self.boost_max = 0.0       # longest continuous boost (s): boostBreak2 of the gear
        self.hold = 1.0            # BOOST_HOLD_MS / 1000
        self.boosting = False
        self.boost_t0 = 0.0
        self.last_input = None     # monotonic time of the last input
        self.blocked = False       # a boost reached boost_max: none until the input pauses for hold
        self.boosts = 0

    def warn_once(self, key, msg):
        if key not in self.warned:
            self.warned.add(key)
            log("iceland-thermal: " + msg, syslog.LOG_WARNING)

    def load_model(self):
        try:
            m = os.stat(MODEL).st_mtime
        except OSError:
            if self.model is not None or "model" not in self.warned:
                self.warn_once("model", "no %s: the battery temperature + %.1f C stands in for the shell estimate"
                               % (MODEL, BAT_BIAS / 1000.0))
            self.model, self.model_mtime = None, None
            return
        if m == self.model_mtime:
            return
        try:
            with open(MODEL) as f:
                j = json.load(f)
            models = [x for x in j["models"] if x.get("rows") and len(x["zones"]) == len(x["rows"][0])]
            self.model, self.model_mtime = models, m
            self.warned.discard("model")
            g = j.get("gears") or {}
            if g.get("up") and len(g["up"]) == len(g.get("down", [])) == len(g.get("status", [])) and \
               (g["up"], g["down"], g["status"]) != (UP, DOWN, STATUS):
                log("iceland-thermal: the model file's gear thresholds differ from the built-in ones: using the file's")
                UP[:], DOWN[:], STATUS[:] = g["up"], g["down"], g["status"]
            log("iceland-thermal: shell model %s: %s" % (j.get("version", "?"), ", ".join(x["name"] for x in models)))
        except (OSError, ValueError, KeyError, IndexError) as e:
            self.model, self.model_mtime = None, m
            log("iceland-thermal: %s unusable (%s): battery fallback" % (MODEL, e), syslog.LOG_WARNING)

    def sample(self, period):
        if len(self.zones) < len(ZONES):
            self.zones = zone_paths()
        t = {}
        for z in ZONES:
            p = self.zones.get(z)
            v = rdint(p + "/temp") if p else None
            if v is None and z == BATTERY:
                b = rdint(BAT + "/temp")            # tenths of a degree C
                v = b * 100 if b is not None else None
                # 0.23: the zone or the supply exists, yet no reading: unknown (a glink timeout), not absent
                self.bat_unknown = v is None and bool(p or os.path.exists(BAT + "/temp"))
            elif z == BATTERY:
                self.bat_unknown = False
            t[z] = v
        now = time.monotonic()
        if self.hist_t is not None and now - self.hist_t > 3 * period:
            self.hist = []                          # as stock: a gap in the samples empties the history
        self.hist.insert(0, t)
        del self.hist[4:]
        self.hist_t = now
        return t

    def shell(self):
        """(shell temperature in m C or None, {model: m C}, source)"""
        vals = {}
        for m in self.model or []:
            rows = m["rows"]
            if len(self.hist) < len(rows):
                break
            s, ok = float(m.get("const", 0.0)), True
            for k, row in enumerate(rows):
                for z, c in zip(m["zones"], row):
                    v = self.hist[k].get(z)
                    if v is None:
                        ok = False
                        break
                    s += c * v
                if not ok:
                    break
            if ok and VALID[0] < s < VALID[1]:
                vals[m["name"]] = int(s)
        if vals:
            return max(vals.values()), vals, "model"
        bat = self.hist[0].get(BATTERY) if self.hist else None
        if bat is not None:
            return bat + BAT_BIAS, {}, "battery"
        rest = [v for v in (self.hist[0].values() if self.hist else []) if v is not None]
        return (max(rest) if rest else None), {}, "hottest"

    def set_max(self, path, base, cap):
        """cpufreq / devfreq maximum: the smaller of the mode's value and the thermal cap"""
        if not os.path.exists(path):
            return None
        if cap is None:
            if self.capped.pop(path, None) and base:
                wr(path, base)                       # the cap is gone: the mode's value again, once
            return base
        want = min(base, cap) if base else cap
        wr(path, want)                               # every period: the request cannot be read back
        self.capped[path] = True
        return want

    def bl_cooling(self):
        """the backlight's cooling device (directory), or None: an older kernel, no brightness cap"""
        if BL_COOLING:
            return BL_COOLING if os.path.exists(BL_COOLING + "/cur_state") else None
        if self.bl_cdev and rd(self.bl_cdev + "/type") == BL_TYPE:
            return self.bl_cdev
        self.bl_cdev = None
        for d in sorted(glob.glob(THERMAL + "/cooling_device*")):
            if rd(d + "/type") == BL_TYPE:
                self.bl_cdev = d
                break
        return self.bl_cdev

    def set_bl_state(self, state):
        """0.28-6: the brightness cap = the cooling state (the gear) of the backlight's own cooling device, written only
        when it differs; the kernel lowers what the backlight ICs get, the backlight's brightness stays the user's.
        Returns the state in place, or None without a usable device (then there is no brightness cap at all)"""
        d = self.bl_cooling()
        if d is None:
            self.bl_held = False
            self.warn_once("nobl", "no %s cooling device: no brightness cap (the backlight itself is never written)" % BL_TYPE)
            return None
        mx = rdint(d + "/max_state")
        if mx != len(BL_GEAR) - 1:
            self.warn_once("blmax", "%s has max_state %s, not one state per gear (%d): no brightness cap" % (BL_TYPE, mx, len(BL_GEAR) - 1))
            if self.bl_held:
                self.release_bl()
            return None
        if "nobl" in self.warned or "blmax" in self.warned:
            self.warned.discard("nobl"); self.warned.discard("blmax")
            log("iceland-thermal: brightness cap through %s (%s)" % (BL_TYPE, d))
        if rdint(d + "/cur_state") != state and not wr(d + "/cur_state", state):
            self.warn_once("blwrite", "%s/cur_state cannot be written" % d)
            cur = rdint(d + "/cur_state")
            self.bl_held = cur not in (None, 0)
            return cur
        self.warned.discard("blwrite")
        self.bl_held = state != 0
        return state

    def release_bl(self):
        """the brightness cap handed back: state 0 (the user's brightness again), if a state is set"""
        d = self.bl_cooling()
        if d is not None and rdint(d + "/cur_state") not in (None, 0):
            wr(d + "/cur_state", 0)
        self.bl_held = False

    def set_charge(self, ma):
        p = os.path.join(RUN, "thermal-fcc-ma")
        if DRYRUN:
            return
        try:
            if ma:
                os.makedirs(RUN, exist_ok=True)
                with open(p + ".tmp", "w") as f:
                    f.write("%d\n" % ma)
                os.replace(p + ".tmp", p)            # a fresh file every period: the guard ignores a stale one
            elif os.path.exists(p):
                os.unlink(p)
        except OSError:
            pass

    # ---- 0.28-8: boost
    def kernel_cpu_trip(self):
        """a kernel cpufreq cooling device holds a state: a kernel thermal trip acts on the CPUs"""
        for d in glob.glob(THERMAL + "/cooling_device*"):
            if "cpufreq" in (rd(d + "/type", "") or "") and (rdint(d + "/cur_state") or 0) > 0:
                return True
        return False

    def guard_stop(self):
        """iceland-battery-guard holds a safety stop (its desktop-notice file says kind=stop) or the input cut"""
        if os.path.exists(os.path.join(RUN, "input-cut")):
            return True
        return "kind=stop" in (rd(os.path.join(RUN, "charge-alert"), "") or "").split()

    def boost_gate(self, c, eff, cpu_l, lv):
        """'' when the gear allows a boost now, else why not"""
        if c.get("BOOST") != "1":
            return "BOOST=0"
        if c.get("CPU") != "1" or lv is None or cpu_l not in BOOST_LEVEL:
            return "no CPU cap"
        if self.screen == "off":
            return "screen off"
        if not 0 <= eff < len(BOOST_BREAK) or BOOST_BREAK[eff][0] < 0 or BOOST_BREAK[eff][1] <= 0:
            return "boostBreak -1"
        if self.bat_unknown:
            return "battery unknown"
        if self.kernel_cpu_trip():
            return "kernel trip"
        if self.guard_stop():
            return "guard stop"
        return ""

    def write_boost(self):
        out = []
        for path, v in zip(self.cpu_paths, self.cpu_boost):
            if v is not None and os.path.exists(path):
                wr(path, v)
                self.capped[path] = True
            out.append(v)
        return out

    def end_boost(self):
        if self.boosting:
            self.boosting = False
            for path, v in zip(self.cpu_paths, self.cpu_cap):
                if v is not None and os.path.exists(path):
                    wr(path, v)

    def on_input(self, now):
        """user input at monotonic time now: start (or keep) a boost if the gear allows one"""
        quiet = self.last_input is None or now - self.last_input >= self.hold
        self.last_input = now
        if self.blocked and quiet:
            self.blocked = False
        if self.boosting or self.blocked or not self.cpu_boost:
            return
        if screen_state() == "off":                  # the screen went dark since the last period
            return
        self.boosting, self.boost_t0 = True, now
        self.boosts += 1
        self.write_boost()

    def deadline(self):
        """monotonic time the boost ends at (no further input), or None"""
        if not self.boosting:
            return None
        return min(self.last_input + self.hold, self.boost_t0 + self.boost_max)

    def tick(self, now):
        """end the boost when its hold or its longest continuous time is over"""
        d = self.deadline()
        if d is not None and now >= d:
            if now - self.boost_t0 >= self.boost_max:
                self.blocked = True                  # continuous input: wait for a pause of hold
            self.end_boost()

    def restore(self):
        self.boosting, self.cpu_boost, self.boost_why = False, None, "off"
        prof = tuned_sysfs(tuned_profile())
        for path in list(self.capped):
            base = self.base_of(path, prof)
            if base:
                wr(path, base)
        self.capped = {}
        if self.bl_held:                             # 0.28-6: the brightness cap (cooling state) back to 0
            self.release_bl()
        self.set_charge(None)
        try:
            os.unlink(os.path.join(RUN, "thermal-state"))
        except OSError:
            pass

    def base_of(self, path, prof):
        """the maximum the power mode wants for this knob: from the tuned profile, else the hardware's"""
        tail = "/".join(path.split("/")[-2:])
        for k, v in prof.items():
            if k.endswith(tail) and v.isdigit():
                return int(v)
        d = os.path.dirname(path)
        if path.endswith("scaling_max_freq"):
            return rdint(d + "/cpuinfo_max_freq")
        fr = [int(x) for x in (rd(d + "/available_frequencies", "") or "").split() if x.isdigit()]
        return max(fr) if fr else None

    def step(self, c):
        period = max(1, cint(c, "PERIOD"))
        self.load_model()
        temps = self.sample(period)
        shell, parts, src = self.shell()
        fake = rdint(FAKE) if FAKE else None
        if fake is not None:
            shell, src = fake, "fake"
        if shell is None:
            self.warn_once("blind", "no temperature can be read: the last gear stays")
        else:
            self.warned.discard("blind")
            new = level_step(self.idx, shell / 1000.0)
            if self.bat_unknown and src != "fake" and new < self.idx:
                self.warn_once("batunk", "the battery temperature can't be read: the gear may rise, never fall, until it reads again")
                new = self.idx                       # 0.23: unknown never relaxes a cap
            elif not self.bat_unknown:
                self.warned.discard("batunk")
            self.idx = new
        raw = STATUS[self.idx] if self.idx >= 0 else -2
        profile = tuned_profile()
        mode = mode_of(profile)
        bench = mode == "performance" and c.get("POLICY_PERFORMANCE") == "benchmark"
        off = 0 if bench else cint(c, {"power-saver": "OFFSET_POWERSAVE", "performance": "OFFSET_PERFORMANCE"}.get(mode, "OFFSET_BALANCED"))
        eff = raw + off
        if raw >= SAFETY_GEAR:
            eff = max(eff, raw)
        eff = min(eff, 19)
        # 0.28-8: with the screen off the base table is globalPolicy (stock's screen_off category replaces the app's)
        self.screen = screen_state()
        dark = self.screen == "off" and c.get("SCREEN_OFF") == "1"
        cpu_l, gpu_l, br_l, ch_l = (BENCH if bench and not dark else GLOBAL)[eff] if eff >= 0 else (-1, -1, 0, 0)
        if raw > eff and c.get("CHARGE_SHIFT") != "1":      # OURS: the charging cool-down ignores a negative offset
            ch_l = GLOBAL[min(raw, 19)][3] if raw >= 0 else 0
        prof = tuned_sysfs(profile)
        lv = CPU_LEVEL.get(cpu_l)
        caps = list(lv) if lv and c.get("CPU") == "1" else [None, None]
        gcap = GPU_LEVEL.get(gpu_l) if c.get("GPU") == "1" else None
        so = screen_off_entry(eff) if dark else None
        if so:                                       # 0.28-8: min(globalPolicy, the screen_off entry) per cluster
            if so[1] >= 0 and c.get("CPU") == "1":
                caps = [lower(caps[i], CPU_LEVEL[so[1]][i]) for i in range(2)]
            if so[2] > 0 and c.get("GPU") == "1":
                gcap = lower(gcap, GPU_LEVEL[so[2]])
        # 0.28-8: the boost ceiling the gear allows now (None = no boost) and why not
        self.hold = max(0, cint(c, "BOOST_HOLD_MS")) / 1000.0
        why = self.boost_gate(c, eff, cpu_l, lv)
        self.cpu_paths, bases, boost = [], [], []
        for i, pol in enumerate(("policy0", "policy6")):
            path = os.path.join(CPUFREQ, pol, "scaling_max_freq")
            self.cpu_paths.append(path)
            bases.append(self.base_of(path, prof))
        if not why:
            for i in range(2):
                b = BOOST_LEVEL[cpu_l][i]
                b = min(bases[i], b) if bases[i] else b          # never above the mode's maximum
                capi = lower(bases[i] or None, caps[i])
                boost.append(max(b, capi) if capi is not None else None)
            if all(boost[i] is None or boost[i] <= lower(bases[i] or None, caps[i]) for i in range(2)):
                why = "ceiling not above the cap"
        self.boost_why = why
        self.cpu_boost = None if why else boost
        self.boost_max = float(BOOST_BREAK[eff][1]) if 0 <= eff < len(BOOST_BREAK) else 0.0
        if self.boosting and why:                    # the gear no longer allows it: the cap again, now
            self.boosting = False
            log("iceland-thermal: boost ended (%s)" % why)
        if self.boosting and self.cpu_boost:         # a boost in progress keeps its ceiling (no dip to the cap)
            self.cpu_cap = [lower(bases[i] or None, caps[i]) if caps[i] is not None else bases[i] for i in range(2)]
            out = self.write_boost()
        else:
            out = [self.set_max(self.cpu_paths[i], bases[i], caps[i]) for i in range(2)]
            self.cpu_cap = list(out)
        gpath = os.path.join(GPU, "max_freq")
        gout = self.set_max(gpath, self.base_of(gpath, prof), gcap)
        bl = None
        # 0.28-6: the brightness cap through the backlight's cooling device (state = the effective gear, 0 below gear 0);
        # BRIGHTNESS=0 hands a state of ours back (and, at the first step, one an earlier run left)
        if c.get("BRIGHTNESS") == "1":
            bl = self.set_bl_state(max(0, min(eff, len(BL_GEAR) - 1)))
        elif self.bl_held or not self.bl_checked:
            self.release_bl()
        self.bl_checked = True
        ma = None
        if c.get("CHARGE") == "1" and ch_l > 0:
            ma = CHARGE_MA.get(ch_l, cint(c, "CHARGE_MA_HIGH"))
        self.set_charge(ma)
        state = "shell=%s src=%s gear=%d eff=%d mode=%s%s cpu=%s,%s gpu=%s bl=%s blcap=%s fcc=%s screen=%s so=%s boost=%s boostcap=%s boosts=%d hist=%d %s %s" % (
            shell, src, raw, eff, mode, "(benchmark)" if bench else "", out[0], out[1], gout, bl,
            BL_GEAR[bl] if bl is not None and 0 <= bl < len(BL_GEAR) else 0, ma or 0,
            self.screen or "unknown", so[0] if so else "-", int(self.boosting),
            ",".join(str(x) for x in self.cpu_boost) if self.cpu_boost else self.boost_why.replace(" ", "_"),
            self.boosts, len(self.hist),
            " ".join("%s=%s" % (k, v) for k, v in sorted(parts.items())),
            " ".join("%s=%s" % (k.replace("-thermal", "").replace("qcom-battmgr-bat", "battery"), v) for k, v in temps.items()))
        try:
            os.makedirs(RUN, exist_ok=True)
            with open(os.path.join(RUN, "thermal-state.tmp"), "w") as f:
                f.write(state + "\n")
            os.replace(os.path.join(RUN, "thermal-state.tmp"), os.path.join(RUN, "thermal-state"))
        except OSError:
            pass
        if (raw, eff, mode, self.screen) != self.last:
            log("iceland-thermal: " + state)
            self.last = (raw, eff, mode, self.screen)
        elif DRYRUN:
            print(state, flush=True)
        return period

def main():
    syslog.openlog("iceland-thermal")
    t = Thermal()
    stop = []
    for s in (signal.SIGTERM, signal.SIGINT):
        signal.signal(s, lambda *_: stop.append(1))
    was_on = True
    inp = None
    while not stop:
        c = read_conf()
        period = max(1, cint(c, "PERIOD"))
        try:
            if c.get("ENABLE") == "1":
                period = t.step(c)
                was_on = True
            elif was_on:
                t.restore()
                was_on = False
                log("iceland-thermal: switched off in %s" % CONF)
        except Exception as e:                           # the kernel zones stay underneath whatever happens here
            log("iceland-thermal: step failed: %r" % (e,), syslog.LOG_ERR)
            t.cpu_boost = None                           # 0.28-8: no boost on a step that did not finish
            try:
                t.end_boost()
            except Exception:
                pass
        if ONESHOT:
            return 0
        # 0.28-8: wait for the next period on one epoll: the user's input devices (boost) and the signal pipe
        boost_on = c.get("ENABLE") == "1" and c.get("BOOST") == "1"
        if boost_on and inp is None:
            try:
                inp = Inputs()
            except (OSError, ValueError) as e:
                t.warn_once("noinput", "no input watch (%s): no boost" % e)
        if inp is not None:
            try:
                if boost_on:
                    inp.scan()
                else:
                    for n in list(inp.fds):
                        inp.drop(n)
            except OSError as e:
                log("iceland-thermal: input scan failed: %r" % (e,), syslog.LOG_ERR)
        end = time.monotonic() + period
        # a device left disarmed by the last period's debounce is looked at again at once
        rearm_at = time.monotonic() if inp is not None and not inp.all_armed() else None
        while not stop:
            now = time.monotonic()
            if now >= end:
                break
            wake = end
            for x in (t.deadline(), rearm_at):
                if x is not None:
                    wake = min(wake, x)
            hit = False
            if inp is not None:
                hit = inp.wait(wake - now)
            else:
                time.sleep(max(0.0, min(0.5, wake - now)))
            now = time.monotonic()
            if inp is not None and rearm_at is not None and now >= rearm_at:
                rearm_at = None
                hit = inp.rearm() or hit
            if hit:
                t.on_input(now)
            if inp is not None and rearm_at is None and not inp.all_armed():
                rearm_at = now + BOOST_DEBOUNCE
            t.tick(now)
    if not DRYRUN:
        t.restore()
    log("iceland-thermal: stopped, limits handed back")
    return 0

if __name__ == "__main__":
    sys.exit(main())
