[Unit]
Description=OnePlus Pad 4: stop the CDSP (NPU) at boot - opt-in, see /usr/bin/iceland-npu
After=systemd-modules-load.service systemd-udev-settle.service
# Opt-in since deep-sleep run 66: a stopped CDSP leaves its own CX / DDR votes behind and the SoC no longer reaches
# CX collapse in suspend until the CDSP runs again; a running, idle CDSP does not block it.
ConditionPathExists=/etc/iceland/npu-off-at-boot

[Service]
Type=oneshot
# the remoteproc probes (and auto-boots the CDSP) a few seconds into boot
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do grep -qs cdsp /sys/class/remoteproc/*/firmware && break; sleep 1; done'
ExecStart=/usr/bin/iceland-npu off
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
