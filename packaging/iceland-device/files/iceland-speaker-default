#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# iceland-speaker-default (iceland-device 0.28-3): the protected "Speakers" sink becomes the CONFIGURED default output of
# this account, unless the account chose another output itself (headphones, Bluetooth, HDMI, ...): WirePlumber 0.5 lists
# filter-chain sinks as filters and does not pick them by priority alone (the idea of tb323fu-linux's
# tb323fu-speaker-gain, MIT). Run by the user unit iceland-speaker-default.service when WirePlumber starts.
#   - waits (up to 20 s) for the protected sink; without it (the chain is switched off or its plug-ins are missing)
#     nothing is changed and WirePlumber's own choice stands;
#   - default.configured.audio.sink empty, or naming the raw speaker sink -> effect_input.speakers;
#     anything else = the user's own choice -> kept.
#   iceland-speaker-default [status]
PROT=effect_input.speakers
RAW=alsa_output.platform-sound.HiFi__Speaker__sink
cfg() {
	pw-metadata 0 default.configured.audio.sink 2>/dev/null | grep -o '"name": *"[^"]*"' | head -n 1 | sed 's/.*"name": *"//; s/"$//'
}
if [ "${1:-}" = status ]; then
	echo "configured default output: $(cfg)"
	exit 0
fi
i=0
until pw-cli ls Node 2>/dev/null | grep -q "node.name = \"$PROT\""; do
	i=$((i + 1))
	[ $i -gt 40 ] && { echo "iceland-speaker-default: no $PROT - the default output is left to WirePlumber"; exit 0; }
	sleep 0.5
done
c=$(cfg)
case "$c" in
"" | "$RAW")
	if pw-metadata 0 default.configured.audio.sink "{ \"name\": \"$PROT\" }" Spa:String:JSON > /dev/null; then
		echo "iceland-speaker-default: configured default output $PROT (was '${c:-none}')"
	else
		echo "iceland-speaker-default: could not set the configured default output"
	fi ;;
*)
	echo "iceland-speaker-default: the account's own choice '$c' is kept" ;;
esac
exit 0
