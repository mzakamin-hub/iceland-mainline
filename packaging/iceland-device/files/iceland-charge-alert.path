# iceland-device 0.28-47: starts iceland-charge-alert.service (a oneshot) on each change of the charging guard's
# event file. The guard replaces the file (rename), which PathChanged sees.
[Unit]
Description=OnePlus Pad 4: watch the charging guard's safety events
PartOf=graphical-session.target
After=graphical-session.target

[Path]
PathChanged=/run/iceland/charge-alert
Unit=iceland-charge-alert.service

[Install]
WantedBy=graphical-session.target
