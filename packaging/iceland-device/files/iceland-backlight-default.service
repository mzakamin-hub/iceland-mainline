# iceland-device 0.28-9: stock's default brightness (1417 of 4095) on the first boot only, after systemd-backlight
# (which restores the user's saved brightness from the second boot on) and before the display manager (GNOME reads
# the value when it starts). Pulled in by 70-iceland-backlight-default.rules when the backlight appears; no [Install]
# section, nothing to enable. Off switch: /etc/iceland/backlight-default-off or iceland.nobacklightdefault.
[Unit]
Description=OnePlus Pad 4: stock's default brightness on the first boot
DefaultDependencies=no
After=systemd-remount-fs.service local-fs.target systemd-backlight@backlight:ktz8869-backlight.service
Before=display-manager.service shutdown.target
Conflicts=shutdown.target
ConditionPathExists=!/var/lib/iceland/backlight-default.done

[Service]
Type=oneshot
ExecStart=/usr/libexec/iceland/iceland-backlight-default apply
