# iceland-device: hexagonrpcd's unit stops for a suspend (Conflicts=suspend.target) and nothing starts it again.
# This runs after the resume (ordered after suspend.target, pulled in by it), outside the suspend transaction: it
# starts the sensor hub's file server and, when the sleep hook stopped iio-sensor-proxy (/run/iceland/sensors-stopped),
# the proxy too (0.28-3, A52 / kit 144: the hook's own start inside systemd-suspend left the accelerometer 0/3; 3/3 from here).
[Unit]
Description=OnePlus Pad 4: start the sensor hub's file server again after a suspend
After=suspend.target
ConditionPathIsDirectory=/usr/share/qcom/kaanapali/OnePlus/iceland/sensors/registry
ConditionPathExists=/dev/fastrpc-adsp

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'if [ -e /run/iceland/sensors-stopped ]; then rm -f /run/iceland/sensors-stopped; exec systemctl --no-block start hexagonrpcd-adsp-sensorspd.service iio-sensor-proxy.service; else exec systemctl --no-block start hexagonrpcd-adsp-sensorspd.service; fi'

[Install]
WantedBy=suspend.target
