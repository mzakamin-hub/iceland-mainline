#
# iceland-refresh (GNOME user service): lower the panel refresh rate on battery, raise it on the charger.
# The Pad 4 panel runs 30/60/90/120/144 Hz; the refresh rate is one of the biggest screen-on power costs.
# Defaults: 60 Hz on battery, 120 Hz on AC. Override in /etc/iceland/refresh.conf or ~/.config/iceland/refresh.conf:
#   BATTERY_HZ=60
#   AC_HZ=120
#   ENABLED=1
#   RELIGHT=0
#   RELIGHT_OFF_MS=1000
#   DISCHARGING_IS_BATTERY=0   (0.28-29, P-1; off by default, see refresh.conf)
#   DISCHARGING_DELAY_S=120
# It changes the mode through mutter's DisplayConfig D-Bus API as a *temporary* configuration, so the user's own
# monitors.xml is never rewritten; the resolution, scale and layout are kept.
# It acts only at start and when the power source really changes (UPower OnBattery flips): a rate the user picks
# in GNOME Settings stays until the next plug / unplug (0.28-27; before, every display change re-forced the rate).
# 0.28-29 (GAPS-2026-10-18 P-1): DISCHARGING_IS_BATTERY=1 also counts a battery that discharges on a weak USB source
# (UPower's display device State discharging / pending-discharge while OnBattery is false) as battery; such a change
# waits DISCHARGING_DELAY_S and is checked again. Off by default: enable it only once the kernel switches 120 <-> 60 Hz
# in place (q89v D-1), because every rate change is a full modeset today.
#
# RELIGHT (off by default since 0.12): kernels without queue patch 0058 leave the Pad 4 panel black after a live
# refresh-rate change (one modeset) until the next display off/on (area-display-2). With RELIGHT=1, after every rate
# change of the built-in panel - ours or the user's in GNOME Settings - the display is switched off and on once
# through mutter's PowerSaveMode, which brings the picture and touch back; it runs even with ENABLED=0. 0058
# (area-display-7: 11 of 11 live changes keep the picture) makes it unnecessary.
import os, sys
from gi.repository import Gio, GLib

def conf():
    c = {"BATTERY_HZ": "60", "AC_HZ": "120", "ENABLED": "1", "RELIGHT": "0", "RELIGHT_OFF_MS": "1000",
         "DISCHARGING_IS_BATTERY": "0", "DISCHARGING_DELAY_S": "120"}
    for p in ("/etc/iceland/refresh.conf", os.path.expanduser("~/.config/iceland/refresh.conf")):
        try:
            for line in open(p):
                line = line.strip()
                if "=" in line and not line.startswith("#"):
                    k, v = line.split("=", 1)
                    c[k.strip()] = v.strip()
        except OSError:
            pass
    return c

def pick_mode(modes, cur_w, cur_h, target):
    """modes: [(id, w, h, refresh, ...)]; same resolution, refresh closest to the target"""
    same = [m for m in modes if m[1] == cur_w and m[2] == cur_h]
    if not same:
        return None
    return min(same, key=lambda m: abs(m[3] - target))[0]

def builtin_rate(monitors):
    """refresh rate of the built-in panel's current mode in GetCurrentState's monitor list, or None"""
    for spec, modes, props in monitors:
        if props.get("is-builtin"):
            cur = next((m for m in modes if m[6].get("is-current")), None)
            return round(cur[3], 1) if cur else None
    return None

def relight_needed(old, new, c):
    """a refresh-rate change of the built-in panel with RELIGHT on"""
    return c.get("RELIGHT", "0") == "1" and old is not None and new is not None and old != new

class Refresh:
    def __init__(self):
        self.bus = Gio.bus_get_sync(Gio.BusType.SESSION)
        self.sysbus = Gio.bus_get_sync(Gio.BusType.SYSTEM)
        self.dc = Gio.DBusProxy.new_sync(self.bus, 0, None, "org.gnome.Mutter.DisplayConfig",
                                         "/org/gnome/Mutter/DisplayConfig", "org.gnome.Mutter.DisplayConfig", None)
        self.up = Gio.DBusProxy.new_sync(self.sysbus, 0, None, "org.freedesktop.UPower",
                                         "/org/freedesktop/UPower", "org.freedesktop.UPower", None)
        self.rate = builtin_rate(self.dc.call_sync("GetCurrentState", None, 0, -1, None).unpack()[1])
        self.pending = None
        self.last_ob = None
        self.dis_timer = None
        self.disp = None
        self.up.connect("g-properties-changed", lambda *a: self.apply())
        if conf().get("DISCHARGING_IS_BATTERY", "0") == "1":
            # P-1: the battery's charge state (UPower's display device); only with the switch on
            self.disp = Gio.DBusProxy.new_sync(self.sysbus, 0, None, "org.freedesktop.UPower",
                                               "/org/freedesktop/UPower/devices/DisplayDevice",
                                               "org.freedesktop.UPower.Device", None)
            self.disp.connect("g-properties-changed", lambda *a: self.apply())
        self.dc.connect("g-signal", lambda p, s, sig, a: sig == "MonitorsChanged" and self.changed())

    def changed(self):
        rate = builtin_rate(self.dc.call_sync("GetCurrentState", None, 0, -1, None).unpack()[1])
        if relight_needed(self.rate, rate, conf()):
            # one off/on for a burst of changes (e.g. the user's change and our own correction)
            if self.pending:
                GLib.source_remove(self.pending)
            self.pending = GLib.timeout_add(300, self.relight_off, self.rate, rate)
        self.rate = rate

    def power_save(self, mode):
        self.bus.call_sync("org.gnome.Mutter.DisplayConfig", "/org/gnome/Mutter/DisplayConfig",
                           "org.freedesktop.DBus.Properties", "Set",
                           GLib.Variant("(ssv)", ("org.gnome.Mutter.DisplayConfig", "PowerSaveMode",
                                                  GLib.Variant("i", mode))), None, 0, -1, None)

    def relight_off(self, old, new):
        self.pending = None
        try:
            self.power_save(3)
            print("iceland-refresh: %.0f -> %.0f Hz, display off/on to relight the panel" % (old, new), flush=True)
            GLib.timeout_add(int(conf().get("RELIGHT_OFF_MS", "1000")), self.relight_on)
        except GLib.Error as e:
            print("iceland-refresh: relight: " + e.message, file=sys.stderr, flush=True)
        return False

    def relight_on(self):
        try:
            self.power_save(0)
        except GLib.Error as e:
            print("iceland-refresh: relight: " + e.message, file=sys.stderr, flush=True)
        return False

    def source(self, c):
        """(on battery?, decided by the discharging rule?): UPower's OnBattery; with DISCHARGING_IS_BATTERY=1 (P-1) also
        a battery that discharges while OnBattery is false (a weak USB source): State 2 discharging / 6 pending"""
        ob = self.up.get_cached_property("OnBattery")
        on_battery = bool(ob.unpack()) if ob is not None else False
        if on_battery or c.get("DISCHARGING_IS_BATTERY", "0") != "1":
            return on_battery, False
        disp = getattr(self, "disp", None)
        st = disp.get_cached_property("State") if disp is not None else None
        try:
            return (st is not None and int(st.unpack()) in (2, 6)), True
        except (TypeError, ValueError):
            return False, True

    def cancel_wait(self):
        if getattr(self, "dis_timer", None) is not None:
            GLib.source_remove(self.dis_timer)
            self.dis_timer = None

    def settle(self):
        self.dis_timer = None
        self.apply(settled=True)
        return False

    def apply(self, settled=False):
        c = conf()
        if c.get("ENABLED", "1") != "1":
            return
        on_battery, by_dis = self.source(c)
        if on_battery == self.last_ob:
            self.cancel_wait()
            return
        if by_dis and self.last_ob is not None and not settled:
            # P-1: a change made by the discharging rule waits (UPower's State follows the load) and is checked again
            if getattr(self, "dis_timer", None) is None:
                try:
                    d = max(1, int(c.get("DISCHARGING_DELAY_S", "120")))
                except ValueError:
                    d = 120
                self.dis_timer = GLib.timeout_add_seconds(d, self.settle)
            return
        self.cancel_wait()
        self.last_ob = on_battery
        target = float(c["BATTERY_HZ"] if on_battery else c["AC_HZ"])
        serial, monitors, logical, props = self.dc.call_sync("GetCurrentState", None, 0, -1, None).unpack()
        changed, new_logical = False, []
        for (x, y, scale, transform, primary, lmons, lprops) in logical:
            mons = []
            for spec in lmons:
                mon = next(m for m in monitors if tuple(m[0]) == tuple(spec))
                modes = mon[1]
                cur = next((m for m in modes if m[6].get("is-current")), None)
                if cur is None:
                    return
                mid = pick_mode(modes, cur[1], cur[2], target)
                if mid and mid != cur[0]:
                    changed = True
                mons.append((spec[0], mid or cur[0], {}))
            new_logical.append((x, y, scale, transform, primary, mons))
        if not changed:
            return
        args = GLib.Variant("(uua(iiduba(ssa{sv}))a{sv})", (serial, 1, new_logical, {}))
        try:
            self.dc.call_sync("ApplyMonitorsConfig", args, 0, -1, None)
            print("iceland-refresh: %s -> %.0f Hz%s" % ("battery" if on_battery else "AC", target,
                  " (the battery discharges on a weak USB source)" if on_battery and by_dis else ""), flush=True)
        except GLib.Error as e:
            print("iceland-refresh: " + e.message, file=sys.stderr, flush=True)

def main():
    r = Refresh()
    r.apply()
    GLib.MainLoop().run()

if __name__ == "__main__":
    main()
