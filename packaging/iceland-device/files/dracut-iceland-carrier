#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-or-later
# dracut module "iceland" (initramfs): find the carrier of the Fedora disk and attach it as a partitioned loop
# device, so that udev finds root=UUID=... on loop0p3 like on any disk.
#   carrier = the UFS partition named "fedora" if there is one (dual boot, U-Boot patch 0003 uses the same rule),
#             else the one named "userdata" (UFS LUN 0); iceland.carrier=NAME overrides; the names are the kernel's
#             PARTNAME (sysfs), the node is /dev/<kernel name> (devtmpfs) - since 0.28-25 no udev link is used;
#             in a rehearsal (iceland.rehearsal= on the command line) the network disk from iceland-rehearsal.
# It only reads the carrier here (the GPT check); the loop device is what Fedora then reads and writes.
# ICELAND_ROOT / ICELAND_CMDLINE: test hooks for the PC unit tests (empty on the tablet).
R=${ICELAND_ROOT:-}
cmdline=${ICELAND_CMDLINE:-$(cat /proc/cmdline)}
# 0.28-27 (D5): explicit kernel log levels (/dev/kmsg defaults to 4 = warning): <6> info, <4> a failure
logl() { l=$1; shift; echo "<$l>iceland-carrier: $*" > "$R/dev/kmsg" 2>/dev/null; echo "iceland-carrier: $*"; }
log() { logl 6 "$@"; }
warn() { logl 4 "$@"; }
getarg() { local a; for a in $cmdline; do case $a in "$1="*) echo "${a#*=}"; return 0 ;; "$1") echo 1; return 0 ;; esac; done; return 1; }
reboot_now() { warn "rebooting (rehearsal safety)"; sleep 2; [ -n "$R" ] && exit 3; echo b > /proc/sysrq-trigger; }
# Every UFS block device read-only before anything else opens one (59-iceland-storage-ro.rules does the same once
# udev has processed the devices; this covers the time before it): in a rehearsal ALL of them - the Fedora disk is
# on the PC -, otherwise all but the carrier partition and its LUN (a read-only LUN would make the carrier read-only).
ufs_ro() { # ufs_ro [CARRIER_NAME]
	local b n c=0
	for b in "$R"/sys/class/block/sd*; do
		[ -e "$b" ] || continue
		case "$(readlink -f "$b")" in */1d84000.ufs/*) ;; *) continue ;; esac
		n=${b##*/}
		if [ -n "${1:-}" ] && { [ "$n" = "$1" ] || [ "$n" = "${1%%[0-9]*}" ]; }; then continue; fi
		if [ -n "$R" ]; then echo "$n" >> "$R/setro.log"; else blockdev --setro "/dev/$n" 2>/dev/null; fi
		c=$((c + 1))
	done
	log "$c internal UFS block devices set read-only${1:+ (writable: $1 and its LUN)}"
}

carrier=""
if reh=$(getarg iceland.rehearsal); then
	ufs_ro
	carrier=$("$R/usr/libexec/iceland/iceland-rehearsal" "$reh") || reboot_now
	case "$carrier" in /dev/nbd*) ;; *) warn "rehearsal carrier $carrier is not the network disk: refused"; reboot_now ;; esac
else
	# 0.28-25 (17 Oct, a Fedora start after the split ended in the dracut shell): the carrier is chosen from the
	# KERNEL's partition names (PARTNAME in /sys/class/block/sdXN/uevent, UFS devices only), no longer from udev's
	# by-partlabel links - udev made the userdata link before the fedora link, and the old loop then took userdata
	# (Android's data since the split: no GPT, exit 1, no root). fedora wins whenever it exists; userdata is taken only
	# when no UFS partition is named fedora, confirmed after udev has settled and a second scan 1 s later.
	pname() { # pname NAME -> the kernel name of the UFS partition called NAME (sda16), else nothing
		local u n
		for u in "$R"/sys/class/block/sd*/uevent; do
			[ -e "$u" ] || continue
			n=${u%/uevent}; n=${n##*/}
			case "$(readlink -f "$R/sys/class/block/$n")" in */1d84000.ufs/*) ;; *) continue ;; esac
			[ -e "$R/sys/class/block/$n/partition" ] || continue
			grep -qx "PARTNAME=$1" "$u" 2>/dev/null && { echo "$n"; return 0; }
		done
		return 1
	}
	want=$(getarg iceland.carrier) || want=""
	label=""; name=""; i=0
	while [ $i -lt 150 ]; do   # up to 30 s for the UFS partitions and the carrier's device node
		i=$((i + 1))
		if [ -n "$want" ]; then
			name=$(pname "$want") && label=$want
		elif name=$(pname fedora); then
			label=fedora
		elif name=$(pname userdata); then
			# no fedora partition (yet?): settle udev, look again 1 s later; fedora still wins if it shows up
			command -v udevadm > /dev/null 2>&1 && [ -z "$R" ] && udevadm settle --timeout=10 2>/dev/null
			sleep 1
			if f=$(pname fedora); then name=$f; label=fedora; else name=$(pname userdata) && label=userdata; fi
		fi
		[ -n "$label" ] && { [ -b "$R/dev/$name" ] || [ -n "$R" -a -e "$R/dev/$name" ]; } && break
		label=""; name=""
		sleep 0.2
	done
	[ -n "$label" ] || { warn "no UFS partition named ${want:-fedora or userdata} with a device node within 30 s"; exit 1; }
	carrier=$R/dev/$name   # ICELAND_INSTALL_ONLY (never in a rehearsal)
	log "carrier: partition $label = /dev/$name (kernel PARTNAME${want:+, iceland.carrier=$want}; fedora $(pname fedora > /dev/null && echo present || echo absent))"
	ufs_ro "${carrier##*/}"
fi
[ -b "$carrier" ] || [ -n "$R" -a -f "$carrier" ] || { warn "carrier $carrier is not a block device"; exit 1; }
sig=$(dd if="$carrier" bs=4096 skip=1 count=1 2>/dev/null | head -c 8)
if [ "$sig" != "EFI PART" ]; then
	warn "$carrier holds no Fedora disk (no GPT header in block 1 of 4096 bytes); nothing attached"
	exit 1
fi
for b in "$R"/sys/block/loop*/loop/backing_file; do
	[ -e "$b" ] || continue
	if [ "$(cat "$b")" = "$carrier" ]; then
		l=${b%/loop/backing_file}; log "already attached: ${l##*/}"; exit 0
	fi
done
loop=$(losetup --find --show --partscan --direct-io=on "$carrier") || { warn "losetup failed on $carrier"; exit 1; }
n=${loop##*/}
log "$carrier -> $loop: block size $(blockdev --getss "$loop" 2>/dev/null), direct I/O $(cat "$R/sys/block/$n/loop/dio" 2>/dev/null), partitions $(ls -d "$R/sys/block/$n/$n"p* 2>/dev/null | wc -l)"
exit 0
