"""iceland-camera-focus: a fixed focus position for the rear camera of the OnePlus Pad 4 while it streams.

libcamera's simple pipeline (0.7.1) has no lens control and no autofocus, so nothing moves the focus motor: the
lens rests at its unpowered end. This helper puts the lens at one configured position whenever the rear sensor is
streaming and lets it go back when the stream stops:

  - it finds the motor's V4L2 sub-device by its name ("dw9719 <bus>-000c") and the rear sensor next to it on the
    same I2C bus (address 0x36);
  - it polls the sensor's runtime power state (active = streaming; the sensor driver powers the sensor only for a
    stream) once a second;
  - active: open the motor's node (that powers the motor), ramp to FOCUS; not active: ramp to 0 and close.

Why not set the position once at boot: libcamera keeps the motor's node open for as long as a camera process lives
(WirePlumber: the whole session), so a position set once would keep the coil energised all day. With this helper
the coil only carries current while the camera is in use, as on stock.

Configuration (/etc/iceland/camera-focus.conf, KEY=VALUE): FOCUS (0..1023, default 450 = stock's own start
position, CustomActuatorInitDac of icelandmain_actuator), POLL (seconds, default 1), STEP (codes per 2 ms while
ramping, default 32). ICELAND_CAMERA_FOCUS_CONF names another file (tests).
"""
import fcntl, glob, os, signal, struct, sys, time

VIDIOC_S_CTRL = 0xC008561C
V4L2_CID_FOCUS_ABSOLUTE = 0x009A090A
CONF = os.environ.get("ICELAND_CAMERA_FOCUS_CONF", "/etc/iceland/camera-focus.conf")
# dry run off the tablet: another sysfs / device root, and a file that gets the positions instead of the ioctl
SYSV = os.environ.get("ICELAND_CAMERA_FOCUS_SYSFS", "/sys/class/video4linux")
DEVD = os.environ.get("ICELAND_CAMERA_FOCUS_DEV", "/dev")
DRY = os.environ.get("ICELAND_CAMERA_FOCUS_DRYRUN")


def config():
    c = {"FOCUS": 450, "POLL": 1.0, "STEP": 32}
    try:
        for line in open(CONF):
            line = line.split("#", 1)[0].strip()
            if "=" in line:
                k, v = line.split("=", 1)
                if k.strip() in c:
                    c[k.strip()] = float(v) if k.strip() == "POLL" else int(v)
    except (OSError, ValueError):
        pass
    c["FOCUS"] = max(0, min(1023, int(c["FOCUS"]))); c["STEP"] = max(1, int(c["STEP"])); c["POLL"] = max(0.2, float(c["POLL"]))
    return c


def find():
    """(motor node, the rear sensor's runtime_status file) or None"""
    for n in glob.glob(os.path.join(SYSV, "v4l-subdev*", "name")):
        try:
            if not open(n).read().startswith("dw9719 "):
                continue
        except OSError:
            continue
        d = os.path.dirname(n)
        bus = os.path.dirname(os.path.realpath(os.path.join(d, "device")))
        st = glob.glob(os.path.join(bus, "*-0036", "power", "runtime_status"))
        if st:
            return os.path.join(DEVD, os.path.basename(d)), st[0]
    return None


def set_pos(fd, value):
    if DRY:
        open(DRY, "a").write("%d\n" % value); return
    fcntl.ioctl(fd, VIDIOC_S_CTRL, bytearray(struct.pack("Ii", V4L2_CID_FOCUS_ABSOLUTE, value)))


def ramp(fd, start, end, step):
    v = start
    while v != end:
        v = min(end, v + step) if end > v else max(end, v - step)
        set_pos(fd, v)
        time.sleep(0.002)


def main():
    c = config(); fd = None; pos = 0; where = None
    stop = []
    signal.signal(signal.SIGTERM, lambda *a: stop.append(1)); signal.signal(signal.SIGINT, lambda *a: stop.append(1))
    print("iceland-camera-focus: position %d while the rear camera streams" % c["FOCUS"], flush=True)
    while not stop:
        if where is None:
            where = find()
            if where is None:
                time.sleep(5); continue
            print("iceland-camera-focus: motor %s, sensor state %s" % where, flush=True)
        try:
            active = open(where[1]).read().strip() == "active"
            if active and fd is None:
                fd = os.open(where[0], os.O_RDWR)
                ramp(fd, 0, c["FOCUS"], c["STEP"]); pos = c["FOCUS"]
            elif not active and fd is not None:
                ramp(fd, pos, 0, c["STEP"]); pos = 0
                os.close(fd); fd = None
        except OSError as e:
            print("iceland-camera-focus: %s" % e, flush=True)
            if fd is not None:
                try:
                    os.close(fd)
                except OSError:
                    pass
            fd = None; pos = 0; where = None
        time.sleep(c["POLL"])
    if fd is not None:
        try:
            ramp(fd, pos, 0, c["STEP"]); os.close(fd)
        except OSError:
            pass


if __name__ == "__main__":
    sys.exit(main())
