#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# Kernel options of kernel-iceland's boot entries (every /boot/loader/entries/*.conf and /etc/kernel/cmdline, which
# kernel-install uses for future kernels; 97-iceland-cmdline.install runs this again after each new kernel's entry).
# Idempotent; a file is only rewritten when its options change.
#  1. Up to 0.18 the package added clk_ignore_unused pd_ignore_unused regulator_ignore_unused (keep the boot loader's
#     clocks, power domains and regulators on until every driver takes over). Every install rehearsal (R1d, R2,
#     R2-final, r2g; 2-3 Oct 2026) booted without them with everything working, and the unused clocks, power domains
#     and regulators then switch off: the better power state. They are removed wherever they are.
#  2. 0.28-15, idle power (the settings Android's GKI kernel ships; kernel q89i builds both, queue 0312), each with a
#     switch in /etc/iceland/boot.conf (run this program after a change; it acts at the next boot):
#       IDLE_GOV=teo (default): cpuidle.governor=teo - the TEO idle governor instead of menu (menu has the higher
#                 rating, so without the option menu stays). IDLE_GOV=menu: the option is removed.
#       RCU_LAZY=1 (default): rcu_nocbs=all rcutree.enable_rcu_lazy=1 - RCU callbacks of every CPU offloaded to
#                 kthreads and batched lazily (fewer wake-ups at idle). RCU_LAZY=0: both options are removed.
#     A managed option that is on replaces another value of the same name (e.g. cpuidle.governor=menu); a switch
#     that is off removes only the exact managed option. The options go before $iceland_args, so a value in GRUB's
#     iceland_args (a rehearsal or a one-off test) still wins.
#  3. The GPU firmware (0.28-19; switch GPU_FW in /etc/iceland/boot.conf) and GPU preemption (0.28-20; GPU_PREEMPT):
#       GPU_FW=vendor533 (default since 0.28-20): firmware_class.path=/usr/lib/firmware/iceland-gpu-vendor533 - the
#                 vendor GMU v5.3.33 / SQE 0x094 of iceland-firmware >= 11.A.38-6 (as SuperTurtleDev and the TB323FU
#                 port), with msm.enable_preemption=1 (RAM rehearsal P2, 16 Oct 2026, kernel q89m: 48356 preemption
#                 ring switches, 0 fenced-write failures, 0 preemption timeouts, 0 faults / recoveries).
#       GPU_FW=stock: firmware_class.path=/usr/lib/firmware/iceland-gpu-stock - stock 11.A.38's GMU v5.3.39 /
#                 SQE 0x103 (iceland-firmware >= 11.A.38-5; rehearsal R4: clean with preemption off), and NO
#                 preemption option (kernel-iceland's default is off, queue 0311).
#       GPU_FW=linux-firmware: neither option; Fedora's linux-firmware pair (v5.3.23 / 0x088), preemption off.
#     A pair is used only when both of its files are installed; a missing vendor533 pair falls back to stock's, a
#     missing stock pair to linux-firmware. The kernel searches firmware_class.path first, every other file still
#     comes from the default paths.
#       GPU_PREEMPT=auto (default): msm.enable_preemption=1 exactly when the vendor533 pair is in use; 0: never;
#       1: on, but ONLY with the vendor533 pair. Preemption with stock's pair (rehearsal P1) or linux-firmware's (R3)
#       reset the tablet early in boot, so it is refused there: with preemption off every msm.enable_preemption
#       value other than 0 is removed from the entries (GRUB's $iceland_args is not touched).
#  4. 0.28-29 (GAPS-2026-10-18 K-4), the kernel's own suspend default (switch MEM_SLEEP in /etc/iceland/boot.conf):
#       MEM_SLEEP=s2idle (default, also when the key is missing): mem_sleep_default=s2idle - "mem" (echo mem >
#                 /sys/power/state, rtcwake -m mem) means suspend-to-idle, as systemd's suspend already does
#                 (sleep.conf.d/60-iceland.conf MemorySleepMode=s2idle); without it the kernel picks PSCI SYSTEM_SUSPEND
#                 ("deep"), a path the tablet's suspend tests never covered. Another mem_sleep_default value is replaced.
#       MEM_SLEEP=kernel: the option is removed (the kernel's own choice).
#     Every entry gets it: the kernels' own entries (also a trial kernel's: 97-iceland-cmdline.install) and the
#     "Roll back to ..." entries (iceland-snapshot takes /etc/kernel/cmdline).
#  5. 0.28-32, the display / GPU settings the owner chose on 22 Oct 2026 (until then hand edits of the entries), each
#     with a switch in /etc/iceland/boot.conf; the defaults are the owner's values:
#       IDLE_RR=30 (default): msm.dpu_idle_refresh_ms=1000 msm.dpu_idle_refresh_hz=30 - a static screen drops to
#                 30 Hz after 1 s (kernel q90g+); IDLE_RR=0: both options removed (the kernel's default: off)
#       BW_FLOOR=0 (default): msm.dpu_bw_floor_pct=0 - no display bus-bandwidth floor (the glitch-hunt floor of
#                 20 Oct off since the glitch cause was fixed); BW_FLOOR=100: msm.dpu_bw_floor_pct=100
#       CLX=1 (default): msm.enable_clx=1 - the GPU's current-limit (CLX) table, proven with the vendor533 GPU
#                 firmware only (q90f / q90g, 22 Oct), so it is set only when that pair is in use; CLX=0: removed
#     A switch set to keep leaves every value of its options as it is (not managed).
#  6. 0.28-34, the boot splash: SPLASH=keep (default): rhgb not managed; SPLASH=0: rhgb removed (no Plymouth
#       splash); SPLASH=1: rhgb added.
#  7. 0.28-35, CLX_TZ=1 (default): msm.a8xx_clx_tz_flag=1 - the kernel (q90k+) adds GPU_CLX_EN_REQ to its TZ GPU init
#       request, as Qualcomm's KGSL does; only while CLX is on (CLX=1 with the vendor533 pair), otherwise the option is
#       removed. Owner's decision of 24 Oct 2026 (q90l rows L1-L3: TZ accepted it; GPU burst current mean 3.59 ->
#       3.25 A). CLX_TZ=0: removed; CLX_TZ=keep, or CLX=keep: not managed. Older kernels ignore the option.
#  8. 0.28-38, PSEUDO_NMI=1: irqchip.gicv3_pseudo_nmi=1 - GIC priority masking as NMI (kernel q90n+ has
#       CONFIG_ARM64_PSEUDO_NMI): the lockup detectors and RCU stall reports get the stuck CPU's backtrace.
#       PSEUDO_NMI=0 (default): the option is removed; keep: not managed. 0.28-40: UNSUPPORTED, 1 is refused (below).
#  9. 0.28-40, kernel q90p+ (built-in defaults). A kernel whose config (/usr/lib/modules/<version>/config, the
#     kernel-iceland rpm ships it) has the defaults below already starts with the values the options used to set, so
#     its boot entry no longer carries them; an entry of an older kernel (a fallback, a "Roll back to ..." entry) gets
#     every option as before. Each boot entry is handled for its own kernel (its "linux /vmlinuz-<version>" line);
#     /etc/kernel/cmdline (the template for the next kernel) for the newest installed kernel. An entry whose kernel
#     cannot be found counts as an older one. The defaults, and the option that a switch off writes instead:
#       CONFIG_DRM_MSM_ICELAND_DEFAULTS=y: msm.dpu_dsc_once=1, msm.dpu_idle_refresh_ms=1000 msm.dpu_idle_refresh_hz=30,
#         panel_novatek_nt36536.stock_power_timing=1 / .bl_after_video=1, and - only when the GPU firmware the kernel
#         finds is the vendor533 pair - msm.enable_preemption=1 msm.enable_clx=1. Off switches write the value:
#         IDLE_RR=0 -> msm.dpu_idle_refresh_ms=0; GPU_PREEMPT=0 or a stock / linux-firmware pair ->
#         msm.enable_preemption=0; CLX=0 or no vendor533 pair -> msm.enable_clx=0; CLX_TZ=0 -> msm.a8xx_clx_tz_flag=0
#       CONFIG_CPU_IDLE_GOV_DEFAULT="teo": cpuidle.governor=teo; IDLE_GOV=menu -> cpuidle.governor=menu
#       CONFIG_RCU_NOCB_CPU_DEFAULT_ALL=y + lazy RCU on by default: rcu_nocbs=all rcutree.enable_rcu_lazy=1;
#         RCU_LAZY=0 -> "rcu_nocbs=" (an empty list: no offloaded CPU) rcutree.enable_rcu_lazy=0
#       CONFIG_PM_SLEEP_DEFAULT_S2IDLE=y: mem_sleep_default=s2idle; MEM_SLEEP=kernel -> mem_sleep_default=deep
#     GLITCH=1 (default; new key): the display options of the glitch hunt (/etc/iceland/glitchfix.conf, 20-22 Oct; until
#       now hand edits, not managed) are managed: an older kernel's entry gets all of them, a q90p+ entry loses the
#       ones whose value is now the kernel's default (and the iceland.glitchfix=1 marker); GLITCH=keep: not managed.
#     firmware_class.path stays an option (GPU_FW); msm.dpu_bw_floor_pct=0 is the default of every kernel since q90g
#     (written for older kernels only).
#     PSEUDO_NMI=1 is refused (pseudo-NMI hangs the boot under Gunyah, q90o-run stage C, 24 Oct 2026): it counts as 0.
# 10. 0.28-44, the Wi-Fi regulatory country (replaces the iceland-wifi-country service): WIFI_REGDOM=auto (default,
#     also when the key is missing): cfg80211.ieee80211_regdom=<CC> with the country of /etc/iceland/wifi-country
#     (ISO 3166 alpha-2, written at install), else COUNTRY= of /etc/sysconfig/regdomain; no valid country found:
#     not managed. WIFI_REGDOM=<two letters>: that country; 0: the option is removed (cfg80211's world domain until
#     something sets one); keep: not managed. cfg80211 is a module: it reads the option from the kernel command
#     line when it loads, so the global domain is the country's before ath12k registers its wiphy. The kernel's
#     regulatory hint options (CERTIFICATION_ONUS / ATH_REG_DYNAMIC_USER_REG_HINTS) stay off: the WCN7860 firmware
#     keeps its own (US) domain; this sets the kernel's side, as iw reg set did.
# ICELAND_ROOT (tests only): the root to work on.
R=${ICELAND_ROOT:-}
ARGS="clk_ignore_unused pd_ignore_unused regulator_ignore_unused"
IDLE_GOV=teo; RCU_LAZY=1; GPU_FW=vendor533; GPU_PREEMPT=auto; MEM_SLEEP=s2idle
IDLE_RR=30; BW_FLOOR=0; CLX=1; CLX_TZ=1; SPLASH=keep; PSEUDO_NMI=0; GLITCH=1; WIFI_REGDOM=auto
FW=/usr/lib/firmware
# 0.28-40: the glitch-hunt display options (their values = the q90p+ kernel defaults)
GLITCH_OPTS="msm.dpu_vid_idle_irq_off=0 msm.dpu_dsc_once=1 msm.dpu_pending_flush_clear=1 msm.dpu_vfp_inplace=1
msm.dpu_vfp_window=1 msm.dpu_irq_cpu_latency_us=500 msm.dsi_slave_pll_restore=0 msm.dsi_phy_muxes_first=1
msm.dpu_frame_pending_early=1 msm.dpu_fd_timer_irq_delete=1 msm.dpu_vid_slave_late_cleanup=1 msm.dpu_scanout_frame_vtotal=1
msm.fb_unpin_after_vblank=1 msm.dpu_clk_inefficiency=-1 msm.disable_ifpc=0 panel_novatek_nt36536.stock_power_timing=1
panel_novatek_nt36536.bl_after_video=1 iceland.glitchfix=1"
GLITCH_OPTS=$(echo $GLITCH_OPTS)
if [ -r "$R/etc/iceland/boot.conf" ]; then
	v=$(sed -n 's/^IDLE_GOV=\([a-z]*\)[[:space:]]*$/\1/p' "$R/etc/iceland/boot.conf" | tail -n 1); [ "$v" = menu ] && IDLE_GOV=menu
	v=$(sed -n 's/^RCU_LAZY=\([0-9]*\)[[:space:]]*$/\1/p' "$R/etc/iceland/boot.conf" | tail -n 1); [ "$v" = 0 ] && RCU_LAZY=0
	v=$(sed -n 's/^GPU_FW=\([a-z0-9-]*\)[[:space:]]*$/\1/p' "$R/etc/iceland/boot.conf" | tail -n 1)
	case "$v" in vendor533|stock|linux-firmware) GPU_FW=$v ;; esac
	v=$(sed -n 's/^GPU_PREEMPT=\([a-z0-9]*\)[[:space:]]*$/\1/p' "$R/etc/iceland/boot.conf" | tail -n 1)
	case "$v" in auto|0|1) GPU_PREEMPT=$v ;; esac
	v=$(sed -n 's/^MEM_SLEEP=\([a-z0-9]*\)[[:space:]]*$/\1/p' "$R/etc/iceland/boot.conf" | tail -n 1); [ "$v" = kernel ] && MEM_SLEEP=kernel
	v=$(sed -n 's/^IDLE_RR=\([a-z0-9]*\)[[:space:]]*$/\1/p' "$R/etc/iceland/boot.conf" | tail -n 1); case "$v" in 30|0|keep) IDLE_RR=$v ;; esac
	v=$(sed -n 's/^BW_FLOOR=\([a-z0-9]*\)[[:space:]]*$/\1/p' "$R/etc/iceland/boot.conf" | tail -n 1); case "$v" in 0|100|keep) BW_FLOOR=$v ;; esac
	v=$(sed -n 's/^CLX=\([a-z0-9]*\)[[:space:]]*$/\1/p' "$R/etc/iceland/boot.conf" | tail -n 1); case "$v" in 1|0|keep) CLX=$v ;; esac
	v=$(sed -n 's/^SPLASH=\([a-z0-9]*\)[[:space:]]*$/\1/p' "$R/etc/iceland/boot.conf" | tail -n 1); case "$v" in 1|0|keep) SPLASH=$v ;; esac
	v=$(sed -n 's/^CLX_TZ=\([a-z0-9]*\)[[:space:]]*$/\1/p' "$R/etc/iceland/boot.conf" | tail -n 1); case "$v" in 1|0|keep) CLX_TZ=$v ;; esac
	v=$(sed -n 's/^PSEUDO_NMI=\([a-z0-9]*\)[[:space:]]*$/\1/p' "$R/etc/iceland/boot.conf" | tail -n 1); case "$v" in 1|0|keep) PSEUDO_NMI=$v ;; esac
	v=$(sed -n 's/^GLITCH=\([a-z0-9]*\)[[:space:]]*$/\1/p' "$R/etc/iceland/boot.conf" | tail -n 1); case "$v" in 1|keep) GLITCH=$v ;; esac
	v=$(sed -n 's/^WIFI_REGDOM=\([A-Za-z0-9]*\)[[:space:]]*$/\1/p' "$R/etc/iceland/boot.conf" | tail -n 1)
	case "$v" in auto|keep|0) WIFI_REGDOM=$v ;; [A-Za-z][A-Za-z]) WIFI_REGDOM=$(echo "$v" | tr a-z A-Z) ;; esac
fi
if [ "$PSEUDO_NMI" = 1 ]; then
	echo "iceland-cmdline: PSEUDO_NMI=1 refused: GIC pseudo-NMI hangs the boot under the Gunyah hypervisor (unsupported on the OnePlus Pad 4); the option is removed" >&2
	PSEUDO_NMI=0
fi
# 0.28-44: the country for cfg80211.ieee80211_regdom (REGDOM = CC, off, or empty = not managed)
REGDOM=""
case "$WIFI_REGDOM" in
auto)
	cc=""; [ -r "$R/etc/iceland/wifi-country" ] && cc=$(tr -d ' \t\r\n' < "$R/etc/iceland/wifi-country" | tr a-z A-Z)
	case "$cc" in [A-Z][A-Z]) ;; *) cc=$(sed -n 's/^COUNTRY=\([A-Za-z][A-Za-z]\)[[:space:]]*$/\1/p' "$R/etc/sysconfig/regdomain" 2>/dev/null | tail -n 1 | tr a-z A-Z) ;; esac
	case "$cc" in [A-Z][A-Z]) REGDOM=$cc ;; *) echo "iceland-cmdline: WIFI_REGDOM=auto found no country (/etc/iceland/wifi-country, /etc/sysconfig/regdomain): not managed" >&2 ;; esac ;;
0) REGDOM=off ;;
keep) ;;
*) REGDOM=$WIFI_REGDOM ;;
esac
pair() { [ -f "$R$FW/iceland-gpu-$1/qcom/gen80200_gmu.bin" ] && [ -f "$R$FW/iceland-gpu-$1/qcom/gen80200_sqe.fw" ]; }
GPU=$GPU_FW
[ "$GPU" = vendor533 ] && ! pair vendor533 && GPU=stock
[ "$GPU" = stock ] && ! pair stock && GPU=linux-firmware
PRE=0
case "$GPU_PREEMPT" in
auto) [ "$GPU" = vendor533 ] && PRE=1 ;;
1) if [ "$GPU" = vendor533 ]; then PRE=1
   else echo "iceland-cmdline: GPU_PREEMPT=1 refused with the $GPU GPU firmware (early-boot reset): preemption stays off" >&2; fi ;;
esac
[ "$CLX" = 1 ] && [ "$GPU" != vendor533 ] && echo "iceland-cmdline: CLX=1 needs the vendor533 GPU firmware (proven only there): CLX stays off with $GPU" >&2
# kernel features (0.28-40): kconf VERSION -> D_MSM D_GOV D_NOCB D_S2I (1 / 0) from that kernel's config
kconf() {
	c=$R/usr/lib/modules/$1/config; [ -f "$c" ] || c=$R/boot/config-$1
	D_MSM=0; D_GOV=0; D_NOCB=0; D_S2I=0
	[ -n "$1" ] && [ -f "$c" ] || return 0
	grep -qx 'CONFIG_DRM_MSM_ICELAND_DEFAULTS=y' "$c" && D_MSM=1
	grep -qx 'CONFIG_CPU_IDLE_GOV_DEFAULT="teo"' "$c" && D_GOV=1
	grep -qx 'CONFIG_RCU_NOCB_CPU_DEFAULT_ALL=y' "$c" && grep -qx 'CONFIG_RCU_LAZY=y' "$c" && ! grep -qx 'CONFIG_RCU_LAZY_DEFAULT_OFF=y' "$c" && D_NOCB=1
	grep -qx 'CONFIG_PM_SLEEP_DEFAULT_S2IDLE=y' "$c" && D_S2I=1
	return 0
}
# sets VERSION -> ON OFF DROP DROPN for a kernel (kconf first)
sets() {
	ON=""; OFF=""; DROP=""; DROPN=""
	if [ $D_GOV = 1 ]; then
		if [ "$IDLE_GOV" = teo ]; then OFF="$OFF cpuidle.governor=teo"; else ON="$ON cpuidle.governor=menu"; fi
	elif [ "$IDLE_GOV" = teo ]; then ON="$ON cpuidle.governor=teo"; else OFF="$OFF cpuidle.governor=teo"; fi
	if [ $D_NOCB = 1 ]; then
		if [ "$RCU_LAZY" = 1 ]; then OFF="$OFF rcu_nocbs=all rcutree.enable_rcu_lazy=1 rcu_nocbs= rcutree.enable_rcu_lazy=0"
		else ON="$ON rcu_nocbs= rcutree.enable_rcu_lazy=0"; fi
	elif [ "$RCU_LAZY" = 1 ]; then ON="$ON rcu_nocbs=all rcutree.enable_rcu_lazy=1"
	else OFF="$OFF rcu_nocbs=all rcutree.enable_rcu_lazy=1 rcu_nocbs= rcutree.enable_rcu_lazy=0"; fi
	case "$GPU" in
	vendor533|stock) ON="$ON firmware_class.path=$FW/iceland-gpu-$GPU" ;;
	*) OFF="$OFF firmware_class.path=$FW/iceland-gpu-vendor533 firmware_class.path=$FW/iceland-gpu-stock" ;;
	esac
	if [ $D_MSM = 1 ]; then
		if [ $PRE = 1 ]; then DROPN="$DROPN msm.enable_preemption"; else ON="$ON msm.enable_preemption=0"; fi
	elif [ $PRE = 1 ]; then ON="$ON msm.enable_preemption=1"; else DROP=msm.enable_preemption; fi
	if [ $D_S2I = 1 ]; then
		if [ "$MEM_SLEEP" = s2idle ]; then OFF="$OFF mem_sleep_default=s2idle"; else ON="$ON mem_sleep_default=deep"; fi
	elif [ "$MEM_SLEEP" = s2idle ]; then ON="$ON mem_sleep_default=s2idle"; else OFF="$OFF mem_sleep_default=s2idle"; fi
	# 0.28-32: DROPN = option names removed whatever their value
	if [ $D_MSM = 1 ]; then
		case "$IDLE_RR" in 30) DROPN="$DROPN msm.dpu_idle_refresh_ms msm.dpu_idle_refresh_hz" ;; 0) ON="$ON msm.dpu_idle_refresh_ms=0"; DROPN="$DROPN msm.dpu_idle_refresh_hz" ;; esac
		case "$BW_FLOOR" in 0) OFF="$OFF msm.dpu_bw_floor_pct=0" ;; 100) ON="$ON msm.dpu_bw_floor_pct=100" ;; esac
	else
		case "$IDLE_RR" in 30) ON="$ON msm.dpu_idle_refresh_ms=1000 msm.dpu_idle_refresh_hz=30" ;; 0) DROPN="$DROPN msm.dpu_idle_refresh_ms msm.dpu_idle_refresh_hz" ;; esac
		case "$BW_FLOOR" in 0|100) ON="$ON msm.dpu_bw_floor_pct=$BW_FLOOR" ;; esac
	fi
	case "$CLX" in
	1) if [ "$GPU" = vendor533 ]; then
		if [ $D_MSM = 1 ]; then DROPN="$DROPN msm.enable_clx"; else ON="$ON msm.enable_clx=1"; fi
	   elif [ $D_MSM = 1 ]; then ON="$ON msm.enable_clx=0"
	   else DROPN="$DROPN msm.enable_clx"; fi ;;
	0) if [ $D_MSM = 1 ]; then ON="$ON msm.enable_clx=0"; else DROPN="$DROPN msm.enable_clx"; fi ;;
	esac
	# 0.28-35: the TZ flag follows CLX (on only while CLX=1 is in effect; CLX=keep leaves it unmanaged too); the
	# kernel's default is 1 since q90m, so a q90p+ entry carries only an explicit 0
	if [ $D_MSM = 1 ]; then
		case "$CLX_TZ" in 1) [ "$CLX" != keep ] && DROPN="$DROPN msm.a8xx_clx_tz_flag" ;; 0) ON="$ON msm.a8xx_clx_tz_flag=0" ;; esac
	else
		case "$CLX_TZ" in
		1) if [ "$CLX" = 1 ] && [ "$GPU" = vendor533 ]; then ON="$ON msm.a8xx_clx_tz_flag=1"
		   elif [ "$CLX" != keep ]; then DROPN="$DROPN msm.a8xx_clx_tz_flag"; fi ;;
		0) DROPN="$DROPN msm.a8xx_clx_tz_flag" ;;
		esac
	fi
	# 0.28-38 / 0.28-40: GIC pseudo-NMI (1 is refused above)
	case "$PSEUDO_NMI" in 0) DROPN="$DROPN irqchip.gicv3_pseudo_nmi" ;; esac
	# 0.28-40: the glitch-hunt display options
	if [ "$GLITCH" = 1 ]; then
		if [ $D_MSM = 1 ]; then OFF="$OFF $GLITCH_OPTS"; else ON="$ON $GLITCH_OPTS"; fi
	fi
	case "$SPLASH" in 1) ON="$ON rhgb" ;; 0) OFF="$OFF rhgb" ;; esac
	# 0.28-44: the Wi-Fi regulatory country
	case "$REGDOM" in '') ;; off) DROPN="$DROPN cfg80211.ieee80211_regdom" ;; *) ON="$ON cfg80211.ieee80211_regdom=$REGDOM" ;; esac
	return 0
}
fix() { # stdin: one options line -> the managed line (single spaces)
	out=""; tail=""; set -f
	for w in $(cat); do
		case " $ARGS $OFF " in *" $w "*) continue ;; esac
		[ -n "$DROP" ] && [ "${w%%=*}" = "$DROP" ] && [ "$w" != "$DROP=0" ] && continue
		case " $DROPN " in *" ${w%%=*} "*) continue ;; esac
		keep=1
		for o in $ON; do [ "${w%%=*}" = "${o%%=*}" ] && keep=0; done
		[ $keep = 1 ] || continue
		case "$w" in '$iceland_args') tail=" $w" ;; *) out="$out $w" ;; esac
	done
	set +f
	printf '%s\n' "${out# }$ON$tail" | sed 's/^ //'
}
# the kernel version of an entry: its linux line (/vmlinuz-VERSION), else its version line
ever() {
	v=$(sed -n 's|^linux[[:space:]]\{1,\}.*/vmlinuz-\([^[:space:]]*\).*$|\1|p' "$1" | head -n 1)
	[ -n "$v" ] || v=$(sed -n 's/^version[[:space:]]\{1,\}\([^[:space:]]*\).*$/\1/p' "$1" | head -n 1)
	echo "$v"
}
for e in "$R"/boot/loader/entries/*.conf; do
	[ -f "$e" ] || continue
	# 0.28-31: a one-shot test entry (iceland-coexist's iceland-oneshot) keeps the options it was armed with
	case "${e##*/}" in iceland-oneshot-*) continue ;; esac
	grep -q '^options ' "$e" || continue
	kconf "$(ever "$e")"; sets
	old=$(sed -n 's/^options //p' "$e" | head -n 1)
	new=$(printf '%s\n' "$old" | fix)
	[ "$new" = "$old" ] && [ "$(grep -c '^options ' "$e")" = 1 ] && continue
	t=$(mktemp) && awk -v o="options $new" '/^options / { print o; next } { print }' "$e" > "$t" && cat "$t" > "$e"; rm -f "$t"
done
f=$R/etc/kernel/cmdline
[ -f "$f" ] || exit 0
# the template for the next kernel: the newest installed kernel's features
newest=$(ls "$R/usr/lib/modules" 2>/dev/null | sort -V | tail -n 1)
kconf "$newest"; sets
old=$(head -n 1 "$f")
new=$(printf '%s\n' "$old" | fix)
[ "$new" = "$old" ] && exit 0
printf '%s\n' "$new" > "$f"
