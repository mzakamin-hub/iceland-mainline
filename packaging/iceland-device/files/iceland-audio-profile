#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# iceland-audio-profile (iceland-device 0.28-23; from the audio A/B switch of 16 / 17 Oct 2026): a user-level,
# reversible choice of the OnePlus Pad 4 speaker tone. The packaged default is 'stock'
# (/usr/share/pipewire/pipewire.conf.d/62-iceland-speakers.conf). Any other profile writes ONE PipeWire drop-in for
# this account,
#     ~/.config/pipewire/pipewire.conf.d/63-iceland-audio-profile.conf
# that switches the packaged chain off (context property iceland.speaker-protection = false, the documented off switch
# of 62-iceland-speakers.conf) and loads the chosen chain under the SAME sink name (effect_input.speakers), so the
# default output and the GNOME volume of "Speakers" stay as they are. Then it restarts this account's PipeWire.
# Nothing system-wide, nothing in the kernel, the UCM, the DSP cap or the amplifiers changes.
#
#   iceland-audio-profile stock | classic | warm | bass | warmbass | superturtle | status | print <profile> | help
#
# Profiles (all keep the DSP stream at stock's 0 dB cap and the amplifiers at stock; the kernel side is untouched):
#   stock       THE PACKAGED DEFAULT (0.28-23, the owner's choice of 17 Oct 2026): removes the drop-in. The 150 Hz
#               4th-order high-pass, compressor 2.5:1 @ -24 dBFS + 9 dB make-up, -1 dBFS look-ahead limiter, plus a
#               fitted CUTS-ONLY set matching the measured stock reference (LineageOS 24, vendor DSP; sweeps relative
#               to 1 kHz): extra 4th-order high-pass 228 Hz, peaking -10 dB @ 280 Hz (Q 0.73) and -15 dB @ 612 Hz
#               (Q 1.55), high-shelf -22 dB @ 2.52 kHz, peaking -15 dB @ 3.91 kHz (Q 0.98) and -8.1 dB @ 9.09 kHz
#               (Q 4). Predicted residual rms 1.7 dB, max 4.0 dB (90 Hz-10 kHz). Every band <= classic.
#   classic     the packaged chain of 0.28-3 .. 0.28-21 (called 'ours' in the A/B): the high-pass, compressor,
#               make-up and limiter above, no tone cuts. Brighter and about 9 dB louder at 1 kHz than stock.
#   warm        classic plus two CUTS towards stock's shape: peaking -5 dB @ 650 Hz (Q 1.0) and high-shelf -9 dB
#               @ 2.5 kHz (Q 0.707: no overshoot). Never louder than classic in any band.
#   bass        classic with the high-pass corner lowered 150 -> 100 Hz (same 4th order); compressor, make-up, limiter
#               as classic. Sends 100-150 Hz to the speakers (stock's own DSP rolls that octave off steeply).
#   warmbass    warm + the 100 Hz high-pass of 'bass'.
#   superturtle SuperTurtleDev's userspace: NO processing (their UCM plays the plain ALSA speaker device; no filter
#               chain, no EQ). Pass-through only: 0 dB, no high-pass, NO compressor/limiter = no speaker protection.
#
# Going back to the default: iceland-audio-profile stock   (or delete the drop-in above and log out / in).
# A drop-in written by the A/B test script of 16 / 17 Oct stays in place after the package update (it is this
# account's file): 'iceland-audio-profile stock' removes it.
set -eu

DIR="${XDG_CONFIG_HOME:-$HOME/.config}/pipewire/pipewire.conf.d"
FILE="$DIR/63-iceland-audio-profile.conf"
PKGCONF=/usr/share/pipewire/pipewire.conf.d/62-iceland-speakers.conf
RAW=alsa_output.platform-sound.HiFi__Speaker__sink
LADSPA_DIRS="/usr/lib64/ladspa /usr/lib/ladspa"
PROFILES="stock classic warm bass warmbass superturtle"

usage() {
	sed -n '2,/^set -eu$/p' "$0" | sed '$d; s/^# \{0,1\}//'
	cat <<'EOF'
Listening A/B (same track, same passage, same GNOME volume, ~50 %; pause the player before each switch):
  iceland-audio-profile classic     # listen 30 s
  iceland-audio-profile warm        # same passage
  iceland-audio-profile stock       # back to the packaged default
Stop at once (iceland-audio-profile stock) on any rattle, buzz or a "flapping" sound in bass-heavy passages
(bass, warmbass, superturtle send more low bass to the speakers than stock / classic).
EOF
}

# emit <profile> <hp-Hz or 0> <eq 0|1 warm|2 stock> <protect 0|1> <description>
emit() {
	p=$1 hp=$2 warm=$3 prot=$4 desc=$5
	cat <<EOF
# profile: $p
# Generated by iceland-audio-profile - a user-level drop-in; undo: iceland-audio-profile stock (removes this file).
# Switches the packaged speaker chain (62-iceland-speakers.conf) off and loads this one under the same sink name.
context.properties = { iceland.speaker-protection = false }
context.modules = [
    {   name = libpipewire-module-filter-chain
        flags = [ ifexists nofail ]
        args = {
            node.description = "$desc"
            media.name       = "$desc"
            filter.graph = {
                nodes = [
EOF
	oL="" oR=""
	for c in L R; do
		o=""
		if [ "$prot" = 0 ]; then
			echo "                    { type = builtin name = cp$c label = copy }"
			o="cp$c"
		else
			if [ "$hp" != 0 ]; then
				echo "                    { type = builtin name = hp$c label = bq_highpass control = { \"Freq\" = $hp.0 \"Q\" = 0.541 } }"
				echo "                    { type = builtin name = hp${c}2 label = bq_highpass control = { \"Freq\" = $hp.0 \"Q\" = 1.307 } }"
				o="hp$c hp${c}2"
			fi
			if [ "$warm" = 1 ]; then
				echo "                    { type = builtin name = pk$c label = bq_peaking control = { \"Freq\" = 650.0 \"Q\" = 1.0 \"Gain\" = -5.0 } }"
				echo "                    { type = builtin name = hs$c label = bq_highshelf control = { \"Freq\" = 2500.0 \"Q\" = 0.707 \"Gain\" = -9.0 } }"
				o="$o pk$c hs$c"
			fi
			if [ "$warm" = 2 ]; then
				echo "                    { type = builtin name = sx$c label = bq_highpass control = { \"Freq\" = 228.0 \"Q\" = 0.541 } }"
				echo "                    { type = builtin name = sx${c}2 label = bq_highpass control = { \"Freq\" = 228.0 \"Q\" = 1.307 } }"
				echo "                    { type = builtin name = sa$c label = bq_peaking control = { \"Freq\" = 279.8 \"Q\" = 0.73 \"Gain\" = -10.0 } }"
				echo "                    { type = builtin name = sb$c label = bq_peaking control = { \"Freq\" = 612.4 \"Q\" = 1.55 \"Gain\" = -15.0 } }"
				echo "                    { type = builtin name = sh$c label = bq_highshelf control = { \"Freq\" = 2515.6 \"Q\" = 0.707 \"Gain\" = -22.0 } }"
				echo "                    { type = builtin name = sc$c label = bq_peaking control = { \"Freq\" = 3914.3 \"Q\" = 0.98 \"Gain\" = -15.0 } }"
				echo "                    { type = builtin name = sd$c label = bq_peaking control = { \"Freq\" = 9090.1 \"Q\" = 4.0 \"Gain\" = -8.1 } }"
				o="$o sx$c sx${c}2 sa$c sb$c sh$c sc$c sd$c"
			fi
		fi
		if [ "$c" = L ]; then oL=$o; else oR=$o; fi
	done
	if [ "$prot" = 1 ]; then
		cat <<'EOF'
                    { type = ladspa name = comp plugin = sc4_1882 label = sc4
                        control = {
                            "RMS/peak" = 0.5
                            "Attack time (ms)" = 10
                            "Release time (ms)" = 200
                            "Threshold level (dB)" = -24
                            "Ratio (1:n)" = 2.5
                            "Knee radius (dB)" = 8
                            "Makeup gain (dB)" = 9
                        }
                    }
                    { type = ladspa name = lim plugin = fast_lookahead_limiter_1913 label = fastLookaheadLimiter
                        control = {
                            "Input gain (dB)" = 0
                            "Limit (dB)" = -1
                            "Release time (s)" = 0.25
                        }
                    }
EOF
	fi
	echo "                ]"
	echo "                links = ["
	for c in L R; do
		if [ "$c" = L ]; then o=$oL ci="comp:Left input"; else o=$oR ci="comp:Right input"; fi
		prev=""
		for n in $o; do
			if [ -n "$prev" ]; then echo "                    { output = \"$prev:Out\" input = \"$n:In\" }"; fi
			prev=$n
		done
		if [ "$prot" = 1 ]; then echo "                    { output = \"$prev:Out\" input = \"$ci\" }"; fi
	done
	if [ "$prot" = 1 ]; then
		echo '                    { output = "comp:Left output" input = "lim:Input 1" }'
		echo '                    { output = "comp:Right output" input = "lim:Input 2" }'
	fi
	echo "                ]"
	# shellcheck disable=SC2086
	set -- $oL; fL=$1
	# shellcheck disable=SC2086
	set -- $oR; fR=$1
	echo "                inputs  = [ \"$fL:In\" \"$fR:In\" ]"
	if [ "$prot" = 1 ]; then
		echo '                outputs = [ "lim:Output 1" "lim:Output 2" ]'
	else
		echo "                outputs = [ \"cpL:Out\" \"cpR:Out\" ]"
	fi
	cat <<EOF
            }
            audio.channels = 2
            audio.position = [ FL FR ]
            capture.props = {
                node.name        = "effect_input.speakers"
                media.class      = Audio/Sink
                priority.session = 1000
                priority.driver  = 1000
            }
            playback.props = {
                node.name         = "effect_output.speakers"
                node.passive      = true
                target.object     = "$RAW"
                node.dont-fallback = true
                node.linger       = true
                stream.dont-remix = true
            }
        }
    }
]
EOF
}

# print stock = the packaged chain as a drop-in (the same graph as 62-iceland-speakers.conf; for comparison only:
# 'iceland-audio-profile stock' never writes it, it removes the drop-in)
gen() {
	case "$1" in
	stock) emit stock 150 2 1 "Speakers" ;;
	classic) emit classic 150 0 1 "Speakers (classic: 0.28-21 tone)" ;;
	superturtle) emit superturtle 0 0 0 "Speakers (SuperTurtleDev: no processing)" ;;
	bass) emit bass 100 0 1 "Speakers (bass: high-pass 100 Hz)" ;;
	warm) emit warm 150 1 1 "Speakers (warm: treble and 650 Hz cut)" ;;
	warmbass) emit warmbass 100 1 1 "Speakers (warm + bass)" ;;
	*) return 1 ;;
	esac
}

current() {
	if [ -f "$FILE" ]; then
		p=$(sed -n 's/^# profile: //p' "$FILE" | head -n 1)
		echo "${p:-unknown} (user drop-in $FILE; 'iceland-audio-profile stock' returns to the packaged default)"
	else
		echo "stock (the packaged default, $PKGCONF)"
	fi
}

others() {   # other drop-ins that switch the packaged chain off (not ours)
	for f in /etc/pipewire/pipewire.conf.d/*.conf "$DIR"/*.conf; do
		[ -f "$f" ] && [ "$f" != "$FILE" ] || continue
		if sed 's/#.*//' "$f" | grep -q 'iceland\.speaker-protection[[:space:]]*=[[:space:]]*false'; then
			echo "note: $f switches the packaged speaker chain off (iceland.speaker-protection = false)"
		fi
	done
}

restart() {
	systemctl --user restart pipewire.service pipewire-pulse.service wireplumber.service
	i=0
	until pw-cli ls Node 2>/dev/null | grep -q 'node.name = "effect_input.speakers"'; do
		i=$((i + 1))
		if [ $i -gt 20 ]; then
			echo "iceland-audio-profile: WARNING no protected 'Speakers' sink after 10 s - going back: iceland-audio-profile stock" >&2
			return 1
		fi
		sleep 0.5
	done
	echo "iceland-audio-profile: active profile $(current); speaker sink:"
	wpctl status 2>/dev/null | grep -i 'speakers' | sed 's/^/  /' || true
}

cmd=${1:-help}
case "$cmd" in
help | -h | --help) usage; exit 0 ;;
status) echo "profile: $(current)"; others; exit 0 ;;
print)
	[ -n "${2:-}" ] || { echo "usage: iceland-audio-profile print $(echo "$PROFILES" | tr ' ' '|')" >&2; exit 2; }
	gen "$2" || { echo "unknown profile '$2'" >&2; exit 2; }
	exit 0 ;;
ours)
	echo "iceland-audio-profile: 'ours' was the A/B name of the 0.28-21 chain: now 'classic'; the packaged default is 'stock'" >&2
	exit 2 ;;
esac
[ "$(id -u)" != 0 ] || { echo "iceland-audio-profile: run it as the desktop user, not root (it changes only this account)" >&2; exit 2; }
case " $PROFILES " in
*" $cmd "*) ;;
*) echo "unknown profile '$cmd' (one of: $PROFILES)" >&2; exit 2 ;;
esac
if [ "$cmd" = stock ]; then
	rm -f "$FILE"
else
	if [ "$cmd" != superturtle ]; then
		ok=0
		for d in $LADSPA_DIRS; do
			if [ -e "$d/sc4_1882.so" ] && [ -e "$d/fast_lookahead_limiter_1913.so" ]; then ok=1; fi
		done
		[ $ok = 1 ] || { echo "iceland-audio-profile: the LADSPA plug-ins (ladspa-swh-plugins) are missing - not switching" >&2; exit 1; }
	fi
	mkdir -p "$DIR"
	gen "$cmd" > "$FILE.tmp"
	mv "$FILE.tmp" "$FILE"
fi
others
restart
