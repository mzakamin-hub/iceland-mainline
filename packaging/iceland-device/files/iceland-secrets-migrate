#!/usr/bin/python3 -I
# SPDX-License-Identifier: GPL-2.0-or-later
# iceland-secrets-migrate (iceland-device-kde 0.28-39): copy the items of gnome-keyring's login keyring into KWallet,
# through the freedesktop Secret Service API on both sides. Run AS THE DESKTOP USER inside the Plasma session.
#   iceland-secrets-migrate list       dry run: print each login-keyring item's label and schema (no attribute values,
#                                      no secrets); KWallet is not written
#   iceland-secrets-migrate migrate    the same, then create every item in KWallet's default wallet (labels, attributes,
#                                      secrets), skip items that are already there, read each one back and compare
#   --password-stdin                   read the login keyring's password from stdin (else a KDE password dialog)
# How: gnome-keyring-daemon runs against a temporary COPY of ~/.local/share/keyrings (the original files are never
# opened for writing), unlocked with the login password. With dbus-run-session + dbus-daemon installed it runs on a
# private bus; otherwise it holds org.freedesktop.secrets on the session bus for the few seconds of the read (KWallet's
# ksecretd is stopped for that time and started again right after; close apps that save passwords meanwhile). The
# secrets stay in this program's memory; nothing secret is logged or written to disk.
# KWallet may show its own dialogs: "create the wallet" (use the login password) and "unlock".
# Exit: 0 = done (list printed / every item copied and verified), 1 = an error (the message says which step), 2 = usage.
import base64, json, os, shutil, subprocess, sys, tempfile, time

from gi.repository import Gio, GLib

SS, SSP = "org.freedesktop.secrets", "/org/freedesktop/secrets"
I_SVC, I_COL, I_ITEM, I_PROMPT = ("org.freedesktop.Secret.Service", "org.freedesktop.Secret.Collection",
                                  "org.freedesktop.Secret.Item", "org.freedesktop.Secret.Prompt")
KWALLET = ("ksecretd", "kwalletd6", "kwalletd5")


def say(msg):
    print("iceland-secrets-migrate: " + msg, file=sys.stderr, flush=True)


def call(bus, path, iface, method, args, rtype=None, timeout=60000):
    return bus.call_sync(SS, path, iface, method, args, GLib.VariantType(rtype) if rtype else None, 0, timeout, None).unpack()


def prop(bus, path, iface, name):
    return bus.call_sync(SS, path, "org.freedesktop.DBus.Properties", "Get", GLib.Variant("(ss)", (iface, name)),
                         GLib.VariantType("(v)"), 0, 30000, None).unpack()[0]


def dbus(bus, method, args, timeout=5000):
    return bus.call_sync("org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus", method, args, None, 0,
                         timeout, None).unpack()


def owner_comm(bus):
    """the process name of org.freedesktop.secrets' owner, "" when nobody owns it"""
    try:
        pid = dbus(bus, "GetConnectionUnixProcessID", GLib.Variant("(s)", (SS,)))[0]
        return open("/proc/%d/comm" % pid).read().strip()
    except (GLib.Error, OSError):
        return ""


def run_prompt(bus, prompt, what):
    """a Secret Service prompt: show it, wait (up to 10 min) for Completed; returns (dismissed, result)"""
    if prompt in ("/", ""):
        return False, None
    loop = GLib.MainLoop(); res = {}
    def done(conn, sender, path, iface, signal, params):
        res["v"] = params.unpack(); loop.quit()
    sid = bus.signal_subscribe(None, I_PROMPT, "Completed", prompt, None, 0, done)
    say("a dialog asks you to %s ..." % what)
    bus.call_sync(SS, prompt, I_PROMPT, "Prompt", GLib.Variant("(s)", ("",)), None, 0, 30000, None)
    GLib.timeout_add_seconds(600, loop.quit)
    loop.run()
    bus.signal_unsubscribe(sid)
    if "v" not in res:
        raise SystemExit("iceland-secrets-migrate: no answer to the dialog (%s) within 10 min" % what)
    return res["v"][0], res["v"][1]


def password(args):
    if "--password-stdin" in args:
        return sys.stdin.readline().rstrip("\n")
    r = subprocess.run(["kdialog", "--title", "Copy your saved passwords to KWallet",
                        "--password", "Password of the login keyring (your login password):"],
                       capture_output=True, text=True)
    if r.returncode != 0:
        raise SystemExit("iceland-secrets-migrate: cancelled")
    return r.stdout.rstrip("\n")


# ---------------------------------------------------------------- gnome-keyring (on a copy of the keyrings)
def start_gk(pw, env, ctl):
    d = subprocess.Popen(["gnome-keyring-daemon", "--start", "--foreground", "--components=secrets", "--unlock",
                          "--control-directory=" + ctl], stdin=subprocess.PIPE, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, text=True, env=env)
    d.stdin.write(pw + "\n"); d.stdin.close()
    return d


def stop(proc):
    proc.terminate()
    try:
        proc.wait(5)
    except subprocess.TimeoutExpired:
        proc.kill()


def read_gk(bus, mode):
    """the login collection of the gnome-keyring that owns org.freedesktop.secrets on bus: [{label, attributes, ...}]"""
    col = call(bus, SSP, I_SVC, "ReadAlias", GLib.Variant("(s)", ("login",)), "(o)")[0]
    if col == "/":
        col = call(bus, SSP, I_SVC, "ReadAlias", GLib.Variant("(s)", ("default",)), "(o)")[0]
    if col == "/":
        raise SystemExit("iceland-secrets-migrate: no login keyring in ~/.local/share/keyrings")
    if prop(bus, col, I_COL, "Locked"):
        raise SystemExit("iceland-secrets-migrate: the login keyring stays locked: wrong password?")
    sess = call(bus, SSP, I_SVC, "OpenSession", GLib.Variant("(sv)", ("plain", GLib.Variant("s", ""))), "(vo)")[1] \
        if mode == "secrets" else None
    out = []
    for it in prop(bus, col, I_COL, "Items"):
        rec = {"label": prop(bus, it, I_ITEM, "Label"), "attributes": dict(prop(bus, it, I_ITEM, "Attributes"))}
        if sess:
            s = call(bus, it, I_ITEM, "GetSecret", GLib.Variant("(o)", (sess,)), "((oayays))")[0]
            rec["secret"] = base64.b64encode(bytes(s[2])).decode(); rec["content_type"] = s[3]
        out.append(rec)
    return out


def wait_gk_owner(bus, secs=10):
    for _ in range(secs * 10):
        if owner_comm(bus).startswith("gnome-keyring"):
            time.sleep(0.5)
            return True
        time.sleep(0.1)
    return False


def inner(mode):
    """on the private bus (dbus-run-session): print the items as JSON lines"""
    pw = sys.stdin.readline().rstrip("\n")
    ctl = tempfile.mkdtemp(prefix="gk-ctl-", dir=os.environ.get("XDG_RUNTIME_DIR"))
    d = start_gk(pw, dict(os.environ), ctl); del pw
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SESSION)
        if not wait_gk_owner(bus):
            print(json.dumps({"error": "gnome-keyring-daemon did not come up"})); return 1
        try:
            for rec in read_gk(bus, mode):
                print(json.dumps(rec), flush=True)
        except SystemExit as e:
            print(json.dumps({"error": str(e).replace("iceland-secrets-migrate: ", "")})); return 1
        return 0
    finally:
        stop(d); shutil.rmtree(ctl, ignore_errors=True)


def export(mode, pw):
    src = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"), "keyrings")
    if not os.path.isfile(os.path.join(src, "login.keyring")):
        raise SystemExit("iceland-secrets-migrate: no %s/login.keyring" % src)
    tmp = tempfile.mkdtemp(prefix="iceland-secrets-", dir=os.environ.get("XDG_RUNTIME_DIR"))
    try:
        os.chmod(tmp, 0o700)
        shutil.copytree(src, os.path.join(tmp, "keyrings"))
        env = dict(os.environ, XDG_DATA_HOME=tmp)
        if shutil.which("dbus-run-session") and shutil.which("dbus-daemon"):
            env.pop("DBUS_SESSION_BUS_ADDRESS", None)
            r = subprocess.run(["dbus-run-session", "--", sys.executable, "-I", os.path.abspath(__file__), "--inner", mode],
                               input=pw + "\n", capture_output=True, text=True, env=env, timeout=300)
            items = [json.loads(l) for l in r.stdout.splitlines() if l.strip()]
            if items and "error" in items[0]:
                raise SystemExit("iceland-secrets-migrate: " + items[0]["error"])
            if r.returncode != 0:
                raise SystemExit("iceland-secrets-migrate: reading the login keyring failed (rc %d)" % r.returncode)
            return items
        return export_swap(mode, pw, env, tmp)
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def export_swap(mode, pw, env, tmp):
    """no private bus available: gnome-keyring (on the copy) holds org.freedesktop.secrets for the read, then KWallet
    gets it back"""
    bus = Gio.bus_get_sync(Gio.BusType.SESSION)
    uid = str(os.getuid())
    ctl = os.path.join(tmp, "control"); os.mkdir(ctl, 0o700)
    d = None
    try:
        for attempt in range(3):
            subprocess.run(["pkill", "-u", uid, "-x", "ksecretd"]); subprocess.run(["pkill", "-u", uid, "-x", "kwalletd6"])
            for _ in range(30):
                if owner_comm(bus) == "":
                    break
                time.sleep(0.1)
            d = start_gk(pw, env, ctl)
            if wait_gk_owner(bus, 5):
                break
            stop(d); d = None
            say("another program took org.freedesktop.secrets first (%s): again" % (owner_comm(bus) or "?"))
        if d is None:
            raise SystemExit("iceland-secrets-migrate: gnome-keyring could not hold org.freedesktop.secrets for the read")
        return read_gk(bus, mode)
    finally:
        if d is not None:
            stop(d)
        for _ in range(30):
            if not owner_comm(bus).startswith("gnome-keyring"):
                break
            time.sleep(0.1)
        try:
            dbus(bus, "StartServiceByName", GLib.Variant("(su)", (SS, 0)), 30000)
        except GLib.Error as e:
            say("could not start KWallet's secret service again: %s" % e.message)
        say("org.freedesktop.secrets is served by '%s' again" % (owner_comm(bus) or "nobody"))


# ---------------------------------------------------------------- KWallet (the real session bus)
def prepare_kwallet():
    """no first-run wizard (it offers GPG): First Use=false for this account if no wallet exists yet"""
    wl = os.path.expanduser("~/.local/share/kwalletd/kdewallet.kwl")
    r = subprocess.run(["kreadconfig6", "--file", "kwalletrc", "--group", "Wallet", "--key", "First Use"],
                       capture_output=True, text=True)
    if not os.path.exists(wl) and r.stdout.strip().lower() == "true":
        subprocess.run(["kwriteconfig6", "--file", "kwalletrc", "--group", "Wallet", "--key", "First Use", "false"])
        subprocess.run(["kwriteconfig6", "--file", "kwalletrc", "--group", "Wallet", "--key", "Enabled", "true"])
        subprocess.run(["pkill", "-u", str(os.getuid()), "-x", "ksecretd"])
        subprocess.run(["pkill", "-u", str(os.getuid()), "-x", "kwalletd6"])
        time.sleep(1)
        say("KWallet's first-run wizard switched off for this account (First Use=false): a plain password dialog creates "
            "a Blowfish wallet")


def import_items(items):
    bus = Gio.bus_get_sync(Gio.BusType.SESSION)
    dbus(bus, "StartServiceByName", GLib.Variant("(su)", (SS, 0)), 30000)
    who = owner_comm(bus)
    if who not in KWALLET:
        raise SystemExit("iceland-secrets-migrate: org.freedesktop.secrets is served by '%s', not KWallet: stop" % who)
    sess = call(bus, SSP, I_SVC, "OpenSession", GLib.Variant("(sv)", ("plain", GLib.Variant("s", ""))), "(vo)")[1]
    col = call(bus, SSP, I_SVC, "ReadAlias", GLib.Variant("(s)", ("default",)), "(o)")[0]
    if col == "/":
        col, pr = call(bus, SSP, I_SVC, "CreateCollection",
                       GLib.Variant("(a{sv}s)", ({"org.freedesktop.Secret.Collection.Label": GLib.Variant("s", "kdewallet")},
                                                 "default")), "(oo)", timeout=600000)
        if col == "/":
            dismissed, res = run_prompt(bus, pr, "create the wallet (use your login password)")
            if dismissed:
                raise SystemExit("iceland-secrets-migrate: the wallet was not created (dialog dismissed)")
            col = res
    unl, pr = call(bus, SSP, I_SVC, "Unlock", GLib.Variant("(ao)", ([col],)), "(aoo)", timeout=600000)
    if col not in unl:
        dismissed, _ = run_prompt(bus, pr, "unlock the wallet")
        if dismissed:
            raise SystemExit("iceland-secrets-migrate: the wallet stays locked (dialog dismissed)")
    made = skipped = bad = 0
    for rec in items:
        attrs = {str(k): str(v) for k, v in rec["attributes"].items()}
        sec = base64.b64decode(rec["secret"])
        found = call(bus, col, I_COL, "SearchItems", GLib.Variant("(a{ss})", (attrs,)), "(ao)")[0]
        same = [p for p in found if prop(bus, p, I_ITEM, "Label") == rec["label"]]
        if same:
            skipped += 1; item = same[0]
        else:
            props = {"org.freedesktop.Secret.Item.Label": GLib.Variant("s", rec["label"]),
                     "org.freedesktop.Secret.Item.Attributes": GLib.Variant("a{ss}", attrs)}
            item, pr = call(bus, col, I_COL, "CreateItem",
                            GLib.Variant("(a{sv}(oayays)b)", (props, (sess, b"", sec, rec.get("content_type") or "text/plain"),
                                                               False)), "(oo)", timeout=600000)
            if item == "/":
                dismissed, res = run_prompt(bus, pr, "allow the new entry")
                item = "/" if dismissed else res
            if item == "/":
                bad += 1; say("NOT copied: '%s'" % rec["label"]); continue
            made += 1
        back = bytes(call(bus, item, I_ITEM, "GetSecret", GLib.Variant("(o)", (sess,)), "((oayays))")[0][2])
        if back != sec:
            bad += 1; say("read-back DIFFERS for '%s'" % rec["label"])
    say("KWallet: %d created, %d already there, %d failed (of %d)" % (made, skipped, bad, len(items)))
    return 0 if bad == 0 else 1


def main(a):
    if a[:1] == ["--inner"]:
        return inner(a[1])
    if not a or a[0] not in ("list", "migrate"):
        print(open(__file__).read().split("\nimport ")[0].replace("# ", ""), file=sys.stderr); return 2
    if os.geteuid() == 0:
        raise SystemExit("iceland-secrets-migrate: run it as the desktop user, not root")
    if not shutil.which("gnome-keyring-daemon"):
        raise SystemExit("iceland-secrets-migrate: gnome-keyring-daemon is missing")
    pw = password(a)
    items = export("labels" if a[0] == "list" else "secrets", pw); del pw
    say("login keyring: %d items" % len(items))
    for i, rec in enumerate(items, 1):
        print("%3d  %s  [%s]" % (i, rec["label"], rec["attributes"].get("xdg:schema", "-")))
    if a[0] == "list":
        return 0
    prepare_kwallet()
    return import_items(items)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
