#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# iceland-device: set the bfq I/O scheduler on one internal UFS LUN (called by 61-iceland-ufs-scheduler.rules).
#   iceland-ufs-scheduler sdX
# The LUNs share one blk-mq tag set; the kernel refuses a scheduler change with -EBUSY while another LUN of the set is
# changing (block/elevator.c elv_iosched_store(): down_write_trylock of update_nr_hwq_lock). So one LUN at a time
# (a lock over all LUNs), with a short retry for any other holder of the set's lock.
# ICELAND_SYSFS / ICELAND_RUN (tests only): /sys and /run.
set -u
S=${ICELAND_SYSFS:-/sys}/block/$1/queue/scheduler
[ -e "$S" ] || exit 0
exec 9> "${ICELAND_RUN:-/run}/iceland-ufs-scheduler.lock"
flock 9
i=0
while [ $i -lt 30 ]; do
	grep -q '\[bfq\]' "$S" 2>/dev/null && exit 0
	{ echo bfq > "$S"; } 2>/dev/null && exit 0
	i=$((i + 1)); sleep 0.1
done
echo "iceland-ufs-scheduler: $1: bfq not set after 30 tries ($(cat "$S" 2>/dev/null))" >&2
exit 1
