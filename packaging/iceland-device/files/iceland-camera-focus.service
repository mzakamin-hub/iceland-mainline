# iceland-device: /usr/lib/systemd/system/iceland-camera-focus.service
# libcamera's simple pipeline has no lens control and no autofocus yet: this unit puts the rear camera's lens at
# one fixed position while the rear sensor streams (see /usr/libexec/iceland/iceland-camera-focus and
# /etc/iceland/camera-focus.conf). It needs the focus motor in the kernel's device tree (queue 0087-0089).
[Unit]
Description=OnePlus Pad 4: fixed focus position of the rear camera while it streams

[Service]
ExecStart=/usr/libexec/iceland/iceland-camera-focus
Restart=on-failure
RestartSec=5
Nice=5
# only sysfs and the V4L2 sub-device nodes are needed
ProtectSystem=strict
ProtectHome=yes
PrivateNetwork=yes
NoNewPrivileges=yes
DevicePolicy=closed
DeviceAllow=char-video4linux rw

[Install]
WantedBy=multi-user.target
