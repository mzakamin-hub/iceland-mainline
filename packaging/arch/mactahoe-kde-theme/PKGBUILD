# iceland project build of vinceliuice/MacTahoe-kde (based on AUR mactahoe-plasma-theme-git, reworked):
# Plasma part only (icons, cursors and GTK are their own packages). Pinned to an upstream commit (no tags upstream).
# Installs: look-and-feel (MacTahoe-Dark/-Light, WITHOUT the layout script: applying the global theme can never
#           replace the owner's panel layout), Plasma desktop themes, colour schemes, Kvantum theme, Aurorae
#           window decorations (1x only: KWin scales them). Not installed: SDDM themes (we use Plasma Login
#           Manager), MacOS dock/panel layout templates, MacTahoe wallpapers.
pkgname=mactahoe-kde-theme
_commit=cbf6a1f71b591d143184855d62f6272ce533e7c3
pkgver=20260816.cbf6a1f
pkgrel=2
pkgdesc='MacTahoe (macOS 26 Tahoe) theme for KDE Plasma 6: global theme, desktop theme, colours, Kvantum, Aurorae'
arch=('any')
url='https://github.com/vinceliuice/MacTahoe-kde'
license=('GPL-3.0-only')
depends=('plasma-workspace' 'kwin')
optdepends=('kvantum: Kvantum widget style (translucent windows)'
            'mactahoe-icon-theme: matching icons'
            'mactahoe-cursor-theme: matching cursors'
            'iceland-wallpaper-goldengate: default wallpaper of the desktop theme')
makedepends=('git')
provides=('mactahoe-plasma-theme')
conflicts=('mactahoe-plasma-theme' 'mactahoe-plasma-theme-git')
options=('!strip' '!debug')
source=("MacTahoe-kde::git+https://github.com/vinceliuice/MacTahoe-kde.git#commit=${_commit}")
sha256sums=('SKIP')

package() {
  cd MacTahoe-kde
  local s=/usr/share c
  install -d "$pkgdir$s"/{color-schemes,plasma/desktoptheme,plasma/look-and-feel,Kvantum,aurorae/themes}
  cp -r Kvantum/MacTahoe "$pkgdir$s/Kvantum/"
  for c in Dark Light; do
    cp color-schemes/MacTahoe$c.colors "$pkgdir$s/color-schemes/"
    cp -r plasma/desktoptheme/MacTahoe-$c "$pkgdir$s/plasma/desktoptheme/"
    cp -r plasma/desktoptheme/icons "$pkgdir$s/plasma/desktoptheme/MacTahoe-$c/"
    cp -r plasma/look-and-feel/com.github.vinceliuice.MacTahoe-$c "$pkgdir$s/plasma/look-and-feel/"
    # owner decision 26 Nov: the global theme must never replace the panel layout
    rm -rf "$pkgdir$s/plasma/look-and-feel/com.github.vinceliuice.MacTahoe-$c/contents/layouts"
    # the MacTahoe wallpapers are not shipped: the theme's default wallpaper becomes the Golden Gate package
    sed -i -e 's/^defaultWallpaperTheme=.*/defaultWallpaperTheme=GoldenGate/' -e 's/^defaultFileSuffix=.*/defaultFileSuffix=.jpg/' \
           -e 's/^defaultWidth=.*/defaultWidth=3392/' -e 's/^defaultHeight=.*/defaultHeight=2400/' \
           "$pkgdir$s/plasma/desktoptheme/MacTahoe-$c/plasmarc"
    # Aurorae (same steps as upstream install_aurorae, 1x scale only)
    local a="$pkgdir$s/aurorae/themes/MacTahoe-$c"
    install -d "$a"
    cp aurorae/MacTahoe-$c/*.svg "$a/"
    cp aurorae/${c}rc "$a/MacTahoe-${c}rc"
    cp aurorae/icons-$c/*.svg "$a/"
    cp aurorae/metadata.desktop aurorae/metadata.json "$a/"
    sed -i "s/theme_name/MacTahoe-$c/g" "$a/metadata.desktop" "$a/metadata.json"
  done
  find "$pkgdir" -type d -exec chmod 755 {} + ; find "$pkgdir" -type f -exec chmod 644 {} +
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
