# iceland project build of vinceliuice/MacTahoe-gtk-theme (based on AUR mactahoe-gtk-theme, rebuilt from the sass
# sources so the accent can be the Golden Gate's International Orange). Tag 2026-09-10, pinned by commit.
# Installs /usr/share/themes/MacTahoe-{Dark,Light}-red (translucent "normal" opacity; the "red" accent variant is
# recoloured from #ED5F5D to #C0362C). GTK 2/3/4 + xfwm/metacity parts as upstream ships them.
pkgname=mactahoe-gtk-theme
_tag=2026-09-10
_commit=0aa2a2ba1e07277a49dae9a3b90881c899d2afbe
pkgver=2026.09.10
pkgrel=1
pkgdesc='MacTahoe (macOS 26 Tahoe) GTK theme, International Orange (#C0362C) accent, translucent'
arch=('any')
url='https://github.com/vinceliuice/MacTahoe-gtk-theme'
license=('MIT')
makedepends=('git' 'sassc' 'glib2' 'libxml2')
optdepends=('gtk-engine-murrine: GTK2 apps')
options=('!strip' '!debug')
source=("MacTahoe-gtk-theme::git+https://github.com/vinceliuice/MacTahoe-gtk-theme.git#commit=${_commit}")
sha256sums=('SKIP')

prepare() {
  cd MacTahoe-gtk-theme
  grep -q '^\$theme_color_red: *#ED5F5D;' src/sass/_colors-palette.scss
  sed -i 's/^\$theme_color_red: *#ED5F5D;/$theme_color_red:     #C0362C;/' src/sass/_colors-palette.scss
  grep -q '#C0362C' src/sass/_colors-palette.scss
  # under fakeroot install.sh thinks it is root and copies its gnome-theme-switcher app to /usr/bin: not packaged
  grep -q '^  install_app$' install.sh
  sed -i 's/^  install_app$/  : # install_app (gnome-theme-switcher not packaged)/' install.sh
  # its progress animation calls setterm, which fails without a terminal (TERM unset in the build) -> error trap
  sed -i 's/setterm -cursor \(on\|off\)/true/g' libs/lib-core.sh
  ! grep -q 'setterm -cursor' libs/lib-core.sh
}

package() {
  cd MacTahoe-gtk-theme
  install -d "$pkgdir/usr/share/themes"
  # HOME points into srcdir so nothing of the build user's home is touched
  HOME="$srcdir/home" ./install.sh -d "$pkgdir/usr/share/themes" -c dark -c light -o normal -t red
  test -d "$pkgdir/usr/share/themes/MacTahoe-Dark-red"
  install -Dm644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
}
