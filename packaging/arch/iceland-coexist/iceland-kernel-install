#!/bin/bash
# reads the vmlinuz paths pacman passes on stdin and calls kernel-install for each module dir
set -u
op=$1
while read -r t; do
  d=/${t%/vmlinuz}; v=${d##*/}
  [ -f "$d/pkgbase" ] || continue
  if [ "$op" = add ]; then kernel-install add "$v" "/$t" || echo "iceland-kernel-install: add $v failed" >&2
  else kernel-install remove "$v" || :; fi
done
