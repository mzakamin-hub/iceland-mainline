# iceland-coexist (Arch, 1.0.9-3): rebuild the iceland kernels' initramfs through kernel-install (58-iceland-initrd +
# 60-iceland-coexist: /boot/initramfs-K.img + the entry) when what goes into an initramfs changes. Takes over the
# triggers of Arch's 90-dracut-install.hook, which this package masks (/etc/pacman.d/hooks/90-dracut-install.hook ->
# /dev/null): that hook wrote /boot/initramfs-<pkgbase>.img + /boot/vmlinuz-<pkgbase>, which no arch1 entry uses.
# Kernel installs / upgrades themselves are 95-iceland-kernel-install.hook's (vmlinuz trigger); this hook skips a kernel
# whose vmlinuz is part of the same transaction.
[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Operation = Remove
Target = usr/lib/dracut/*
Target = etc/dracut.conf.d/*
Target = usr/lib/firmware/*
Target = usr/src/*/dkms.conf
Target = usr/lib/systemd/systemd
Target = usr/bin/cryptsetup
Target = usr/bin/lvm
Target = usr/lib/modules/*/vmlinuz

[Trigger]
Type = Package
Operation = Install
Operation = Upgrade
Target = dracut

[Action]
Description = Rebuilding the iceland kernels' initramfs (kernel-install)...
When = PostTransaction
Exec = /usr/share/libalpm/scripts/iceland-initramfs-refresh
NeedsTargets
