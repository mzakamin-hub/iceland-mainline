  install -Dm0644 "$srcdir/60-iceland-wifi-powersave.conf" "$pkgdir"/usr/lib/NetworkManager/conf.d/60-iceland-wifi-powersave.conf
  install -Dm0755 "$srcdir/iceland-battery-guard" "$pkgdir"/usr/libexec/iceland/iceland-battery-guard
