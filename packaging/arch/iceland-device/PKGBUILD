  install -Dm0644 "$srcdir/iceland-npu-off.service" "$pkgdir"/usr/lib/systemd/system/iceland-npu-off.service
  install -Dm0644 "$srcdir/iceland-regdomain" "$pkgdir"/etc/sysconfig/regdomain
  install -Dm0644 "$srcdir"/audioreach-topology/OnePlus-Pad4-tplg.bin "$pkgdir"/usr/lib/firmware/qcom/kaanapali/OnePlus-Pad4-tplg.bin
  install -Dm0644 "$srcdir"/audio/ucm/OnePlus-Pad4/OnePlus-Pad4.conf "$pkgdir"/usr/share/alsa/ucm2/Qualcomm/kaanapali/OnePlus-Pad4/OnePlus-Pad4.conf
