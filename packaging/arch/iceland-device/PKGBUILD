package_iceland-device-hypr() {
  pkgdesc='OnePlus Pad 4 (iceland): the Hyprland / Omarchy session parts (refresh switch, bypass toggle, ambient
brightness, idle policy, rotation, cover mode)'
  depends=('iceland-device>=0.28.53-20' hyprland wlr-randr brightnessctl python python-gobject iio-sensor-proxy-iceland
           libnotify grim sddm nftables sddm-theme-omarchy-iceland iceland-shell-extras jq
           # pkgrel 7: what Omarchy 4.5's session itself starts / enables but our lean image left out: herdr (autostart
           # `herdr server` -> "App failure"), owe (owed.service + /usr/share/owe/10-owe-sync: without them first-run's
           # enable-user-units step fails, first-run never marks itself done and repeats its notifications every
           # login), bluez-tools (bt-agent.service), udiskie (autostart); omarchy-hyprland-titlebars (Omarchy's
           # close / maximize / minimize bars on floating workspaces: the touch controls of tablet mode)
           herdr owe bluez-tools udiskie omarchy-hyprland-titlebars
           # pkgrel 8: the shell warns that magick / inotifywait are missing (triage 24 Nov)
           imagemagick inotify-tools)
  optdepends=('floatkey: the on-screen keyboard in the session' 'omarchy-pad-lock: the keyboard on the lock screen'
              'wvkbd: the old greeter keyboard (GREETER_OSK=wvkbd in /etc/iceland/greeter-osk.conf; not installed)')
  backup=(etc/sddm.conf.d/20-iceland-greeter.conf etc/nftables.d/iceland-greeter-nonet.nft etc/iceland/greeter-osk.conf)
  install=iceland-device-hypr.install
  bsdtar -xf "$srcdir/hypr.tar" -C "$pkgdir"
}

package_iceland-device-kde() {
  pkgdesc='OnePlus Pad 4 (iceland): the KDE Plasma session parts (power defaults, Bypass Charging item, KWallet secrets,
Plasma login screen, plasma-keyboard)'
  # hard dependencies kept minimal (owner 26 Nov: the Plasma package set is chosen separately: plasma-meta + apps)
  depends=("iceland-device=$pkgver-$pkgrel" plasma-workspace kwin powerdevil)
  optdepends=('plasma-meta: the Plasma desktop set the owner chose (D1)'
              'plasma-login-manager: the login screen preset by /etc/plasmalogin.conf.d/30-iceland.conf'
              'plasma-keyboard: the on-screen keyboard named in /etc/xdg/kwinrc (session and login screen)'
              'kscreen: kscreen-doctor for iceland-kde-defaults and the KWin backend of iceland-refresh'
              'plasma5support: the executable data engine of the Bypass Charging item'
              'kwallet: ksecretd, the secrets service named by 50-iceland-kde-secrets.conf'
              'kwallet-pam: opens the wallet at a password login'
              'xdg-desktop-portal-kde: file chooser, camera permission, screen cast'
              'spectacle: iceland-shot'
              'discover: software centre (PackageKit backend only, see iceland-kde-discover)'
              'packagekit-qt6: the PackageKit backend of Discover'
              'gnome-keyring: iceland-secrets-migrate (copies its login keyring into KWallet)')
  backup=(etc/xdg/powerdevilrc etc/xdg/kwalletrc etc/xdg/kwinrc etc/plasmalogin.conf.d/30-iceland.conf)
  install=iceland-device-kde.install
  bsdtar -xf "$srcdir/kde.tar" -C "$pkgdir"
  install -dm0700 "$pkgdir"/var/lib/iceland/kde-curve
  install -d "$pkgdir"/usr/share/iceland/session-first/applications
}
