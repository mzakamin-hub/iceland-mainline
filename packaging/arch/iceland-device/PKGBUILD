prepare() {
  # audio overlay and tuned profiles travel as directories next to the PKGBUILD
  cp -a "$startdir/audio" "$startdir/tuned" "$srcdir/"
  # Arch: iceland-cmdline only manages the Arch entries (arch1-*-a1.conf); Fedora's copy manages its own.
  # The two /etc/iceland/boot.conf must stay identical (ROOTFS-PLAN: copied from Fedora at rehearsal build).
  sed -i 's#"$R"/boot/loader/entries/\*.conf#"$R"/boot/loader/entries/arch1-*-a1.conf#' "$srcdir/iceland-cmdline"
  # pkgrel 2: the Arch form of iceland-snapshot. Fedora and Arch share the btrfs top level and its snapshots/ folder:
  # Arch's snapshots are named arch-root-DATE-REASON (Fedora's root-DATE-REASON), so neither side's KEEP pruning ever
  # deletes the other's; the root subvolume is the one mounted at / (arch-root); iceland-coexist's layout writes no
  # "Roll back" entries (roll back with: iceland-snapshot rollback arch-root-...)
  sed -i -e 's#name=root-\$(date#name=arch-root-$(date#' \
         -e 's#"\$TOP"/snapshots/root-\*#"$TOP"/snapshots/arch-root-*#' \
         -e 's#^\(\t*title="Roll back to .*\)\^root-#\1^arch-root-#' \
         -e 's#\${name\#root-}#${name\#arch-root-}#' \
         -e 's#as snapshots/root-YYYY#as snapshots/arch-root-YYYY#' \
         -e 's#before a dnf / GNOME Software transaction (libdnf5 actions plugin)#before a pacman transaction (pacman hook 05-iceland-snapshot.hook)#' \
         "$srcdir/iceland-snapshot"
  # pkgrel 3: the dracut file lists name Fedora paths. Arch Linux ARM has no /usr/lib64 and ships linux-firmware
  # UNcompressed (Fedora: .xz); with the Fedora names dracut-install failed on the GPU microcode and libseccomp
  # (rootfs build 23 Nov, logs/r5-rootfs-run-3-dracutpaths.log), so the initramfs would lack gen80200_aqe.fw
  sed -i -e 's#/usr/lib/firmware/qcom/\(gen80200_[a-z]*\.[a-z]*\)\.xz#/usr/lib/firmware/qcom/\1#g' \
         -e 's#/usr/lib64/libseccomp\.so\.2#/usr/lib/libseccomp.so.2#g' \
         "$srcdir/90-iceland-dracut.conf" "$srcdir/91-iceland-install-dracut.conf"
  ! grep -nE '^[^#]*(\.xz|/usr/lib64/)' "$srcdir/90-iceland-dracut.conf" "$srcdir/91-iceland-install-dracut.conf"
  grep -q 'install_items+=" /usr/lib/firmware/qcom/gen80200_sqe.fw /usr/lib/firmware/qcom/gen80200_gmu.bin /usr/lib/firmware/qcom/gen80200_aqe.fw ' "$srcdir/90-iceland-dracut.conf"
  grep -q 'name=arch-root-$(date' "$srcdir/iceland-snapshot"
  grep -q '"$TOP"/snapshots/arch-root-\*' "$srcdir/iceland-snapshot"
  ! grep -nE 'snapshots/root-|name=root-' "$srcdir/iceland-snapshot"
}

build() {
  cp -a "$srcdir"/audio/topology/. "$srcdir"/audioreach-topology/
  cd "$srcdir"/audioreach-topology
  m4 -I . OnePlus-Pad4.m4 > OnePlus-Pad4.conf
  alsatplg -c OnePlus-Pad4.conf -o OnePlus-Pad4-tplg.bin
  grep -q 'max "8192"' OnePlus-Pad4.conf
}

package_iceland-device() {
  depends=(linux-iceland 'iceland-firmware>=11.A.38.6' iceland-coexist bluez python python-gobject polkit iw ethtool
           qbootctl iproute2 alsa-utils alsa-ucm-conf iceland-ppd hexagonrpc libssc iio-sensor-proxy-iceland
           upower-iceland libcamera-ipa pipewire-libcamera 'wireplumber>=0.5.18' swh-plugins pipewire fuse3
           btrfs-progs util-linux device-mapper dracut nbd busybox irqbalance zram-generator chrony
           networkmanager diffutils
           # pkgrel 20: the nftables ruleset / drop-in moved here from -hypr (DroidLoom egress, the VM app NAT)
           nftables)
  optdepends=('iceland-device-kde: the KDE Plasma session parts'
              'iceland-device-hypr: the Hyprland / Omarchy session parts')
  backup=(etc/iceland/boot.conf etc/iceland/battery-guard.conf etc/iceland/thermal.conf etc/iceland/refresh.conf etc/iceland/launchboost.conf etc/iceland/cover-detect.conf etc/iceland/snapshot.conf
          etc/NetworkManager/conf.d/zz-iceland-wifi-powersave.conf etc/dbus-1/system.d/iceland-logind-unlock.conf)
  install=iceland-device.install
  cd "$srcdir"
  install -Dm0644 "$srcdir/sleep-iceland.conf" "$pkgdir"/usr/lib/systemd/sleep.conf.d/60-iceland.conf
  install -Dm0644 "$srcdir/journald-iceland.conf" "$pkgdir"/usr/lib/systemd/journald.conf.d/60-iceland.conf
