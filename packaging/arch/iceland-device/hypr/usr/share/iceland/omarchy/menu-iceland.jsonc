  // iceland-device-hypr: the Tablet section of the Omarchy menu (merged into the user's
  // ~/.config/omarchy/extensions/omarchy-menu.jsonc by iceland-menu-extension, between its BEGIN / END lines)
  "tablet": {"icon":"󰓶","label":"Tablet","aliases":["pad"]},
  "tablet.settings": {"icon":"","label":"Settings","action":"omarchy-menu summon setup"},
  "tablet.rotation": {"icon":"󰑓","label":"Rotation Lock","checked":"[[ $(omarchy-pad-rotate-lock status) == on ]]","action":"omarchy-pad-rotate-lock toggle"},
  "tablet.mode": {"icon":"󰌢","label":"Mode","title":"Tablet / Laptop Mode"},
  "tablet.mode.auto": {"icon":"󰁨","label":"Auto (follow the cover)","checked":"iceland-mode state | grep -qx mode=auto","action":"iceland-mode set auto"},
  "tablet.mode.tablet": {"icon":"󰓶","label":"Tablet","checked":"iceland-mode state | grep -qx mode=tablet","action":"iceland-mode set tablet"},
  "tablet.mode.laptop": {"icon":"󰌢","label":"Laptop","checked":"iceland-mode state | grep -qx mode=laptop","action":"iceland-mode set laptop"},
  "tablet.keyboard": {"icon":"","label":"On-screen Keyboard","action":"iceland-osk toggle"},
  // pkgrel 16 (round 10): Display = the refresh-rate choice and the effective resolution (iceland-display-mode)
  "tablet.display": {"icon":"󰍹","label":"Display","title":"Display: Refresh Rate & Resolution"},
  "tablet.display.rate": {"icon":"󰑓","label":"Refresh Rate","title":"Refresh Rate"},
  "tablet.display.rate.auto": {"icon":"󰁹","label":"Auto (60 Hz on battery, 120 Hz on the charger)","checked":"iceland-display-mode is rate auto","action":"iceland-display-mode rate auto"},
  "tablet.display.rate.hz60": {"icon":"󰍹","label":"60 Hz","checked":"iceland-display-mode is rate 60","action":"iceland-display-mode rate 60"},
  "tablet.display.rate.hz90": {"icon":"󰍹","label":"90 Hz","checked":"iceland-display-mode is rate 90","action":"iceland-display-mode rate 90"},
  "tablet.display.rate.hz120": {"icon":"󰍹","label":"120 Hz","checked":"iceland-display-mode is rate 120","action":"iceland-display-mode rate 120"},
  "tablet.display.rate.hz144": {"icon":"󰍹","label":"144 Hz (most power)","checked":"iceland-display-mode is rate 144","action":"iceland-display-mode rate 144"},
  "tablet.display.rate.now": {"icon":"󰋼","label":"Current Rate","action":"/usr/libexec/iceland/iceland-refresh-info"},
  "tablet.display.resolution": {"icon":"󰍺","label":"Resolution","title":"Resolution (scale)"},
  "tablet.display.resolution.s100": {"icon":"󰍺","label":"3392 x 2400 (scale 1)","checked":"iceland-display-mode is scale 1","action":"iceland-display-mode scale 1"},
  "tablet.display.resolution.s133": {"icon":"󰍺","label":"2544 x 1800 (scale 1.33)","checked":"iceland-display-mode is scale 1.333333","action":"iceland-display-mode scale 1.333333"},
  "tablet.display.resolution.s160": {"icon":"󰍺","label":"2120 x 1500 (scale 1.6)","checked":"iceland-display-mode is scale 1.6","action":"iceland-display-mode scale 1.6"},
  "tablet.display.resolution.s200": {"icon":"󰍺","label":"1696 x 1200 (scale 2, default)","checked":"iceland-display-mode is scale 2","action":"iceland-display-mode scale 2"},
  "tablet.display.resolution.s267": {"icon":"󰍺","label":"1272 x 900 (scale 2.67)","checked":"iceland-display-mode is scale 2.666667","action":"iceland-display-mode scale 2.666667"},
  "tablet.power": {"icon":"󰐥","label":"Power Screen","action":"omarchy-shell shell summon omarchy-pad.power '{}'"},
  "tablet.battery": {"icon":"󰁹","label":"Battery & Charging","action":"omarchy-shell omarchy.power open"},
  "tablet.android": {"icon":"󰀲","label":"Android (DroidLoom)","title":"Android (DroidLoom)","aliases":["droidloom","android"]},
  "tablet.android.open": {"icon":"󰀲","label":"Open Android","action":"/usr/libexec/iceland/iceland-droidloom open"},
  "tablet.android.settings": {"icon":"","label":"Android Settings","action":"/usr/libexec/iceland/iceland-droidloom launch com.android.settings"},
  "tablet.android.autostart": {"icon":"󰐥","label":"Start with the Session","checked":"systemctl --user -q is-enabled droidloom.service","action":"/usr/libexec/iceland/iceland-droidloom autostart toggle"},
  "tablet.android.status": {"icon":"󰋼","label":"Status","action":"/usr/libexec/iceland/iceland-droidloom status"},
  "tablet.android.stop": {"icon":"󰓛","label":"Stop Android","action":"/usr/libexec/iceland/iceland-droidloom stop"}
