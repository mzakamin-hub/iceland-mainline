# iceland-device-hypr (Omarchy port): auto-rotation from iio-sensor-proxy (wlr-output-management)
[Unit]
Description=OnePlus Pad 4: auto-rotation from iio-sensor-proxy (wlr-output-management)
PartOf=graphical-session.target
After=graphical-session.target
ConditionEnvironment=HYPRLAND_INSTANCE_SIGNATURE

[Service]
ExecStart=/usr/libexec/iceland/iceland-rotate
Restart=on-failure
RestartSec=5


[Install]
WantedBy=graphical-session.target
