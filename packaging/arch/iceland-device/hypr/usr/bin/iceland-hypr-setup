#!/bin/bash
# iceland-hypr-setup: once per user (and harmless again): load the Pad 4 Hyprland settings after Omarchy's, seed
# floatkey's settings (focus-driven show, no raw touch), and turn on the omarchy-pad lock keyboard.
set -u
cfg=${XDG_CONFIG_HOME:-$HOME/.config}
line='dofile("/usr/share/iceland/hypr/iceland.lua")'
# pkgrel 6 (24 Nov, first arch1 boots): a home NOT made from /etc/skel (W2 creates the owner's user and twtest with
# useradd -M; any user added without -m) has no Omarchy config. Hyprland then writes its own AUTOGENERATED
# hyprland.lua, which loads none of Omarchy's defaults (no Omarchy shell, no ecosystem.no_update_news) and is the one
# case where Hyprland starts hyprland-welcome ("[welcome] skipping, not autogen" otherwise) and the update news. So:
# Hyprland's autogenerated file is moved aside (hyprland.lua.autogenerated), and Omarchy's per-user defaults are
# copied in the way useradd -m does; a file the user already has is never overwritten. This unit runs before
# graphical-session-pre.target, i.e. before Hyprland reads its config.
hl=$cfg/hypr/hyprland.lua
if [[ -f $hl ]] && grep -qE '^[[:space:]]*hl\.config\(\{[[:space:]]*autogenerated[[:space:]]*=[[:space:]]*(true|1)' "$hl"; then
  mv -f "$hl" "$hl.autogenerated"
fi
if [[ ! -e $hl && -d /etc/skel && $cfg == "$HOME/.config" ]]; then
  cp -a --update=none /etc/skel/. "$HOME/" 2> /dev/null || cp -an /etc/skel/. "$HOME/" 2> /dev/null || :
fi
if [[ -f $cfg/hypr/hyprland.lua ]] && ! grep -qF "$line" "$cfg/hypr/hyprland.lua"; then
  printf '\n-- OnePlus Pad 4 (iceland-device-hypr)\n%s\n' "$line" >> "$cfg/hypr/hyprland.lua"
fi
mkdir -p "$cfg/floatkey"
if [[ ! -f $cfg/floatkey/floatkey.conf ]]; then
  printf '[General]\nautoShow=true\nautoShowAfterTap=false\nautoShowWithKeyboard=false\nautoShowInTerminals=true\n' \
    > "$cfg/floatkey/floatkey.conf"
fi
# Chromium / Electron report text fields over text-input-v3 only with these flags (OSK auto-show, TEST-PLAN OSK5)
for f in chromium-flags.conf electron-flags.conf; do
  grep -qs -- '--wayland-text-input-version=3' "$cfg/$f" || \
    printf -- '--enable-wayland-ime\n--wayland-text-input-version=3\n' >> "$cfg/$f"
done
# pkgrel 8 (from upstream omarchy-pad's tablet setup): Chromium-family browsers draw extension popups (Bitwarden, ...)
# as platform widgets that never enable text input, so floatkey never shows for them; this feature off fixes it.
# Added to every existing flags file once (merged into an existing --disable-features line), at each login, so a
# browser installed later or a flags file Omarchy rewrites gets it again.
feature=OzoneBubblesUsePlatformWidgets
shopt -s nullglob
for flags in "$cfg"/{chromium,chrome,google-chrome,google-chrome-*,brave,brave-*,vivaldi,vivaldi-*,microsoft-edge-*,thorium,helium,helium-browser}-flags.conf; do
  [[ -f $flags && ! -L $flags ]] || continue
  grep -q "$feature" "$flags" && continue
  if grep -q '^--disable-features=' "$flags"; then
    sed -i "s/^--disable-features=.*/&,$feature/" "$flags"
  else
    printf -- '--disable-features=%s\n' "$feature" >> "$flags"
  fi
done
shopt -u nullglob
command -v omarchy-pad-lock-setup >/dev/null && omarchy-pad-lock-setup --first-login || :
# pkgrel 9 (owner 24 Nov ~04:20, "like KDE"): logind's Unlock ends the shell lock. Injected into the user's
# omarchy-pad.lock clone (never into /usr/share/omarchy) before the shell starts, again after an Omarchy update
# refreshed the clone (our post-update hook). Only root can make logind send Unlock (/etc/dbus-1/system.d).
# pkgrel 13 (24 Nov, audit of Omarchy main fee089f's 106 migrations newer than the image: logs/a1fix-migrations-audit.tsv):
# Omarchy runs these per user at `omarchy update`; on the Pad 4 (detected as aarch64-qualcomm) they would rebuild a
# limine / UKI boot image we do not have, or change the Wi-Fi board data / browser GPU flags, and the FIRST one that
# fails stops omarchy-migrate for good. Each is marked done for this user (Omarchy's own marker file), once:
#   1793663784  dtb-uki: installs systemd-ukify (IgnorePkg), writes /etc/kernel/uki.conf, runs limine-mkinitcpio
#               (not installed: the migration fails and blocks every later one)
#   1794060269  mkinitcpio hook + /etc/mkinitcpio.conf.d/qualcomm-platform.conf (no mkinitcpio here; iceland-omarchy-guard
#               removes that file anyway)
#   1794065688  RebootWatchdogSec=off (60-omarchy-qualcomm-reboot-watchdog.conf): our 30 s reboot watchdog stays
#   1793809102, 1794417300  ath12k-board-fallback (fix-ath12k-board-data.sh, 17cb:1103/1107/1112 cards): our WCN7860 board
#               data comes from iceland-firmware
#   1795099916  Chromium --use-angle=gles-egl + AcceleratedVideoDecoder: untested on the Adreno 840 / Pad 4 decoder
#               (owner decision, not a silent change)
skipd=$HOME/.local/state/omarchy/migrations
mkdir -p "$skipd" "$cfg/iceland"
for m in 1793663784 1794060269 1794065688 1793809102 1794417300 1795099916; do
  [[ -e $skipd/$m.sh ]] || { : > "$skipd/$m.sh" && echo "$m.sh $(date -Is)" >> "$cfg/iceland/omarchy-migrations-skipped"; }
done
# pkgrel 14 (owner 24 Nov ~12:50): the Tablet section in the Omarchy menu (the user's menu extension file; only our
# BEGIN / END block is managed, the owner's own rows stay)
[[ -x /usr/libexec/iceland/iceland-menu-extension ]] && /usr/libexec/iceland/iceland-menu-extension > /dev/null 2>&1
# pkgrel 16 (round 10): the user's DSI-1 rule in ~/.config/hypr/monitors.lua names an explicit mode instead of
# Omarchy's "preferred" (= the panel's 144 Hz mode); scale / position stay. Before Hyprland reads its config, so this
# write causes no reload. 144 Hz only by the user's own choice (iceland-display-mode rate 144).
[[ -x /usr/libexec/iceland/iceland-monitors-mode-fix ]] && /usr/libexec/iceland/iceland-monitors-mode-fix > /dev/null 2>&1
lockf=$cfg/omarchy/plugins/omarchy-pad.lock/Service.qml
[[ -f $lockf ]] && /usr/libexec/iceland/iceland-lock-unlock-inject "$lockf" > /dev/null 2>&1
command -v omarchy-hook-install > /dev/null && \
  omarchy-hook-install post-update /usr/share/iceland/omarchy-hooks/zz-iceland-lock-unlock > /dev/null 2>&1 || :
# round 6: the Auto / Tablet / Laptop tile's mode file (auto if none) and the polkit lock-keys fallback refresh
# (only if the owner turned it on with iceland-polkit-osk enable)
command -v iceland-shell-extras-setup >/dev/null && iceland-shell-extras-setup --first-login || :
# round 6 (research REFS-TOUCH-2 A5, coordinator 23 Nov): Omarchy's terminal screensaver ends only on a key press,
# which a slate cannot send: off by default (idle.screensaver = 0), seeded ONCE into Omarchy's own shell.json (the
# owner may turn it on again; we never touch it a second time). Before Omarchy has written its shell.json, nothing
# is done and the next login tries again.
# pkgrel 8 (24 Nov, arch1: idle.screensaver was 150 again): Omarchy's first-run rewrites shell.json AFTER our first
# login seeding, so the value is re-asserted at every login until Omarchy's first-run is done, and only then marked
# (a new mark name: the old one was set too early). Omarchy's own off switch, the screensaver-off toggle
# (omarchy-toggle-screensaver / omarchy-launch-screensaver), is also set once. The owner may turn either on again.
sj=$cfg/omarchy/shell.json; mark=$cfg/iceland/.screensaver-off-seeded-2
if [[ ! -e $mark && -f $sj ]] && command -v jq >/dev/null; then
  tmp=$(mktemp "$sj.XXXXXX") && jq '.idle = ((.idle // {}) + {"screensaver": 0})' "$sj" > "$tmp" && mv -f "$tmp" "$sj" || rm -f "$tmp"
  [[ -e $HOME/.local/state/omarchy/done/first-run-user ]] && mkdir -p "$cfg/iceland" && : > "$mark"
fi
tmark=$cfg/iceland/.screensaver-toggle-seeded
if [[ ! -e $tmark ]]; then
  mkdir -p "$HOME/.local/state/omarchy/toggles" "$cfg/iceland" && : > "$HOME/.local/state/omarchy/toggles/screensaver-off" && : > "$tmark"
fi
exit 0
