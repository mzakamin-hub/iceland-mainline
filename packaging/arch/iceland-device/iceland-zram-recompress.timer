# iceland-device 0.28-46: recompress the zram pages idle for an hour (iceland-zram-recompress), hourly. The first run
# is an hour after boot (nothing in zram has been idle for an hour before that). CLOCK_MONOTONIC: time asleep does not
# count, so a sleeping tablet is not woken for it.
[Unit]
Description=OnePlus Pad 4: recompress idle zram pages hourly

[Timer]
OnBootSec=1h
OnUnitActiveSec=1h
AccuracySec=10min
