#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-or-later
# iceland-droidloom (iceland-device (0.28.53-20: moved from iceland-device-hypr, not tied to Hyprland / Omarchy) pkgrel 14; owner 24 Nov ~13:00: DroidLoom "only with the launcher entries"):
# the touch entry points to DroidLoom (upstream droidloom 0.1.0-49) for the "DroidLoom" launcher and the Tablet menu's
# "Android (DroidLoom)" section. Upstream's own commands only (docs/INSTALL.md of release 49):
#   open                start Android if it is not running (droidloomctl start: waits for Android's readiness,
#                       upstream shows its own "Droidloom is starting" notification), then show Omarchy's Apps grid,
#                       where droidloom-applications lists each Android app (~/.local/share/applications)
#   launch PACKAGE      the same start, then one Android app (droidloomctl launch PACKAGE)
#   status              droidloomctl status as a notification
#   stop                droidloomctl stop (closes the Android windows, releases the runtime)
#   autostart on|off|toggle|status   start Android with the graphical session (systemctl --user enable droidloom.service)
# It never runs the first-time setup (/etc/droidloom, Android data under /var/lib/droidloom): before that setup has
# been done, every action only says so (no administrator prompt from a tap).
set -u
note() { notify-send -a DroidLoom -i applications-android "$@" > /dev/null 2>&1 || :; }
command -v droidloomctl > /dev/null || { note "DroidLoom is not installed"; exit 1; }
set_up() {
  [[ -e /etc/droidloom/cell.json ]] && return 0
  note "Android is not set up yet" "DroidLoom's first start (its setup and Android's first boot) has not been run on this tablet yet."
  return 1
}
running() { systemctl --user -q is-active droidloom.service; }
start() {
  running && return 0
  local out rc
  exec 9> "${XDG_RUNTIME_DIR:-/tmp}/iceland-droidloom.lock"
  flock -n 9 || { note "Android is starting" "Please wait a moment."; return 1; }
  out=$(timeout 300 droidloomctl start 2>&1); rc=$?
  flock -u 9
  if (( rc != 0 )); then
    note -u critical "Android did not start" "$(tail -n 3 <<< "$out")"
    return 1
  fi
}
show_apps() {
  command -v omarchy-shell > /dev/null || return 0
  sleep 0.4   # a launch from the Apps grid closes it first: the toggle below must not close it again
  omarchy-shell omarchy.dock apps > /dev/null 2>&1 || :
}
case ${1:-open} in
  open) set_up && start && show_apps ;;
  launch)
    [[ -n ${2:-} ]] || { echo "usage: iceland-droidloom launch PACKAGE" >&2; exit 2; }
    set_up && start && { droidloomctl launch "$2" > /dev/null 2>&1 || note -u critical "Android app did not open" "$2"; } ;;
  status) note "DroidLoom" "$(droidloomctl status 2>&1 | tail -n 4)" ;;
  stop) running || [[ -e /run/droidloom/control.sock ]] || { note "DroidLoom" "Android is not running."; exit 0; }
    droidloomctl stop > /dev/null 2>&1 && note "DroidLoom" "Android stopped." || note -u critical "DroidLoom" "Android did not stop: see droidloomctl status" ;;
  autostart)
    case ${2:-status} in
      on) set_up && systemctl --user enable droidloom.service > /dev/null 2>&1 && note "DroidLoom" "Android now starts with the session." ;;
      off) systemctl --user disable droidloom.service > /dev/null 2>&1; note "DroidLoom" "Android no longer starts with the session." ;;
      toggle) if systemctl --user -q is-enabled droidloom.service 2> /dev/null; then "$0" autostart off; else "$0" autostart on; fi ;;
      status) systemctl --user -q is-enabled droidloom.service 2> /dev/null && echo on || echo off ;;
      *) echo "usage: iceland-droidloom autostart on|off|toggle|status" >&2; exit 2 ;;
    esac ;;
  *) echo "usage: iceland-droidloom open|launch PACKAGE|status|stop|autostart on|off|toggle|status" >&2; exit 2 ;;
esac
