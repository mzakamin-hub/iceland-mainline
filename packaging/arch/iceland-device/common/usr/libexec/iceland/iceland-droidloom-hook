# iceland-droidloom-hook (iceland-device 0.28.53-20; run by 04-iceland-droidloom-guard.hook, owner 26 Nov 2026:
# mitigation (b)): a transaction that INSTALLS or UPGRADES a droidloom-* package is aborted unless
# iceland-droidloom-pacman started it. DroidLoom's repository is unsigned (OPEN-DECISIONS D6); only that guard checks
# what [droidloom] supplies (allow-list, last repository, HTTPS). This closes the other routes: a plain
# "pacman -Syu" that would pick up a new droidloom-* version, "pacman -S droidloom-...", Pamac and Discover /
# PackageKit (they run hooks through libalpm too).
# The proof is /run/iceland/droidloom-pacman.allow ("PID EPOCH"): a regular file owned by root, not writable by
# group / others, younger than 10 minutes, and its PID is a running iceland-droidloom-pacman. A file and not an
# environment variable, because the Pamac and PackageKit daemons start hooks without the caller's environment.
# Not guarded: REMOVING droidloom-* (no code from the unsigned repository is installed by a removal; removing
# iceland-device or DroidLoom must never be blocked) and transactions without droidloom-* (the hook is not run).
set -u
F=/run/iceland/droidloom-pacman.allow
refuse() {
  echo "iceland-droidloom-guard: REFUSED: $*" >&2
  echo "iceland-droidloom-guard: droidloom-* packages come from the unsigned [droidloom] repository; install or update" >&2
  echo "iceland-droidloom-guard: them only with:  sudo iceland-droidloom-pacman plan   then   sudo iceland-droidloom-pacman install" >&2
  echo "iceland-droidloom-guard: (a full upgrade without DroidLoom: add --ignore 'droidloom-*' to pacman -Syu)" >&2
  exit 1
}
[ -f "$F" ] && [ ! -L "$F" ] || refuse "this transaction was not started by iceland-droidloom-pacman"
read -r owner mode < <(stat -c '%u %a' "$F")
[ "$owner" = 0 ] || refuse "the marker is not root's"
case "$mode" in ???) [ $(( 8#$mode & 8#022 )) = 0 ] || refuse "the marker is writable by others" ;; *) refuse "odd marker mode $mode" ;; esac
read -r pid t < "$F" 2>/dev/null || refuse "unreadable marker"
case "$pid$t" in *[!0-9]*|'') refuse "malformed marker" ;; esac
now=$(date +%s)
[ $(( now - t )) -ge 0 ] && [ $(( now - t )) -lt 600 ] || refuse "the marker is older than 10 minutes"
tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null | grep -q 'iceland-droidloom-pacman install' \
  || refuse "the marker's process ($pid) is not a running iceland-droidloom-pacman install"
echo "iceland-droidloom-guard: allowed (iceland-droidloom-pacman, pid $pid)"
exit 0
