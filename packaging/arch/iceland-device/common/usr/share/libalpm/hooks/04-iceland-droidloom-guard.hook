# iceland-device 0.28.53-20 (owner 26 Nov 2026, mitigation (b)): droidloom-* is installed / upgraded only through
# iceland-droidloom-pacman (pacman, Pamac and Discover / PackageKit alike). Sorts before 05-iceland-snapshot.hook:
# a refused transaction takes no snapshot. Removal is not guarded (see /usr/libexec/iceland/iceland-droidloom-hook).
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = droidloom-*

[Action]
Description = Checking that DroidLoom packages come through iceland-droidloom-pacman...
When = PreTransaction
Exec = /usr/libexec/iceland/iceland-droidloom-hook
AbortOnFail
