From b7694be54ffc296b0011f43f9787ec8e5f691292 Mon Sep 17 00:00:00 2001
From: Birk Skyum <birk.skyum@pm.me>
Date: Wed, 4 Nov 2026 16:52:54 +0100
Subject: [PATCH] ir3: keep separate dominance stacks in merge_sets_interfere

merge_sets_interfere() walks the definitions of both merge sets in
dominance order and keeps a stack of definitions that dominate the
current definition. The stack held definitions from both sets, so each
call also tested pairs where both definitions came from the same set.
The largest set in the reproducer has 11,565 definitions: 2,720 phis,
5,440 parallel copies made for them, 2,720 splits and 685 others. Every
merge into that set walked the whole set and retested it against itself.
On an Adreno X1-85 (Lenovo Yoga Slim 7x, Mesa main 81d869ccd50),
register allocation accounted for about 97% of a 43.8 s pipeline
compile, roughly 42.6 s.

Keep one dominance stack per merge set and test the current definition
only against the other set's stack. Pairs from the same set cannot
change the result of this merge, because both definitions stay in that
set whether the merge succeeds or not. Pairs with one definition from
each set are tested exactly as before: popping each stack until its top
dominates the current definition leaves each stack holding exactly that
set's entries from the old shared stack.

The capture comes from ir3-switch.html, which rebuilds the shader shape
of the WebGPU CTS test
webgpu:api,operation,sampling,sampler_texture:sample_texture_combos. It
is one pipeline with two shaders, vertex and fragment, each with a
768-case switch. Compiling it with fossilize-replay drops from 43.8 s to
2.2 s (one thread, shader cache disabled). The generated ir3 is identical
across 830 pipelines, and the old and new functions agree on all
513,557 merges (575,919 with IR3_SHADER_DEBUG=spillall).

Chromium's 15 s GPU watchdog kills the GPU process when that test
creates the pipeline synchronously; with createRenderPipelineAsync the
process survives, at about 46 s before this change. With this change,
the WebGPU CTS test passes in Chromium in 9 s including startup, while
unpatched main still fails after 33 s with the watchdog.

Generated-by: LLM
---
 src/freedreno/ir3/ir3_merge_regs.c | 37 +++++++++++++++++++++---------
 1 file changed, 26 insertions(+), 11 deletions(-)

diff --git a/src/freedreno/ir3/ir3_merge_regs.c b/src/freedreno/ir3/ir3_merge_regs.c
index 593790a4a60..92ea9f5e923 100644
--- a/src/freedreno/ir3/ir3_merge_regs.c
+++ b/src/freedreno/ir3/ir3_merge_regs.c
@@ -241,9 +241,10 @@ merge_sets_interfere(struct ir3_liveness *live, struct ir3_merge_set *a,
    if (b_offset < 0)
       return merge_sets_interfere(live, b, a, -b_offset);
 
-   struct merge_def dom[a->regs_count + b->regs_count];
+   struct merge_def a_dom[a->regs_count];
+   struct merge_def b_dom[b->regs_count];
    unsigned a_index = 0, b_index = 0;
-   int dom_index = -1;
+   int a_dom_index = -1, b_dom_index = -1;
 
    /* Reject trying to merge the sets if the alignment doesn't work out */
    if ((a->alignment + b_offset) % b->alignment != 0)
@@ -251,29 +252,38 @@ merge_sets_interfere(struct ir3_liveness *live, struct ir3_merge_set *a,
 
    while (a_index < a->regs_count || b_index < b->regs_count) {
       struct merge_def current;
+      bool current_in_b;
       if (a_index == a->regs_count) {
          current.reg = b->regs[b_index];
          current.offset = current.reg->merge_set_offset + b_offset;
+         current_in_b = true;
          b_index++;
       } else if (b_index == b->regs_count) {
          current.reg = a->regs[a_index];
          current.offset = current.reg->merge_set_offset;
+         current_in_b = false;
          a_index++;
       } else {
          if (def_after(b->regs[b_index], a->regs[a_index])) {
             current.reg = a->regs[a_index];
             current.offset = current.reg->merge_set_offset;
+            current_in_b = false;
             a_index++;
          } else {
             current.reg = b->regs[b_index];
             current.offset = current.reg->merge_set_offset + b_offset;
+            current_in_b = true;
             b_index++;
          }
       }
 
-      while (dom_index >= 0 &&
-             !def_dominates(dom[dom_index].reg, current.reg)) {
-         dom_index--;
+      while (a_dom_index >= 0 &&
+             !def_dominates(a_dom[a_dom_index].reg, current.reg)) {
+         a_dom_index--;
+      }
+      while (b_dom_index >= 0 &&
+             !def_dominates(b_dom[b_dom_index].reg, current.reg)) {
+         b_dom_index--;
       }
 
       /* TODO: in the original paper, just dom[dom_index] needs to be
@@ -290,19 +300,24 @@ merge_sets_interfere(struct ir3_liveness *live, struct ir3_merge_set *a,
        * allowing values to contain subregisters. For now we just test
        * everything in the stack.
        */
-      for (int i = 0; i <= dom_index; i++) {
-         if (can_skip_interference(&current, &dom[i]))
+      struct merge_def *other_dom = current_in_b ? a_dom : b_dom;
+      int other_dom_index = current_in_b ? a_dom_index : b_dom_index;
+      for (int i = 0; i <= other_dom_index; i++) {
+         if (can_skip_interference(&current, &other_dom[i]))
             continue;
 
          /* Ok, now we actually have to check interference. Since we know
-          * that dom[i] dominates current, this boils down to checking
-          * whether dom[i] is live after current.
+          * that other_dom[i] dominates current, this boils down to checking
+          * whether other_dom[i] is live after current.
           */
-         if (ir3_def_live_after(live, dom[i].reg, current.reg->instr))
+         if (ir3_def_live_after(live, other_dom[i].reg, current.reg->instr))
             return true;
       }
 
-      dom[++dom_index] = current;
+      if (current_in_b)
+         b_dom[++b_dom_index] = current;
+      else
+         a_dom[++a_dom_index] = current;
    }
 
    return false;
