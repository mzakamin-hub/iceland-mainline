# shared with scripts/blk-mesa-cfgtest-in.sh (configure-only trial)
_meson_options=(
  -D b_ndebug=true
  -D platforms=x11,wayland
  -D gallium-drivers=freedreno,zink,llvmpipe,softpipe,virgl
  -D vulkan-drivers=freedreno,swrast,virtio
  -D freedreno-kmds=msm,virtio
  -D gallium-va=enabled
  -D gallium-mediafoundation=disabled
  -D teflon=false
  -D gallium-rusticl=$_rusticl
  -D vulkan-layers=device-select
  -D gles1=enabled
  -D gles2=enabled
  -D opengl=true
  -D gbm=enabled
  -D glx=dri
  -D egl=enabled
  -D glvnd=enabled
  -D intel-rt=disabled
  -D microsoft-clc=disabled
  -D llvm=enabled
  -D shared-llvm=enabled
  -D valgrind=enabled
  -D build-tests=false
  -D libunwind=enabled
  -D lmsensors=enabled
  -D android-libbacktrace=disabled
  -D spirv-tools=enabled
  -D vulkan-loader-rpath=
  -D vulkan-manifest-per-architecture=false
)

prepare() {
  cd mesa-$_ver
  local p
  for p in ../91[0-9][0-9]-*.patch; do
    echo "Applying ${p##*/}"
    patch -Np1 -i "$p"
  done
  cp ../Mesa-MLAA-License-Clarification-Email.txt docs/
  # venus-protocol for the virtio Vulkan driver (git archive does not bundle it; no wrap download)
  mkdir -p subprojects/venus-protocol-1.1.3
  tar -xzf ../venus-protocol-v1.1.3.tar.gz -C subprojects/venus-protocol-1.1.3 --strip-components=1
  # release string carries the package release (Chromium GPU cache invalidation, as Arch)
  [ "$(cat VERSION)" = 26.3.1 ]
  echo "26.3.1-iceland$_epoch.$pkgrel" > VERSION
}

build() {
  arch-meson mesa-$_ver build "${_meson_options[@]}"
  meson compile -C build
}

_pick() {
  local p="$1" f d; shift
  for f; do
    d="$srcdir/$p/${f#$pkgdir/}"
    mkdir -p "$(dirname "$d")"
    mv -v "$f" "$d"
    rmdir -p --ignore-fail-on-non-empty "$(dirname "$f")"
  done
}

package_mesa-iceland() {
  depends=(
    expat
    glibc
    libdrm
    libelf
    libgcc
    libglvnd
    libstdc++
    libunwind
    libx11
    libxcb
    libxext
    libxfixes
    libxshmfence
    libxxf86vm
    llvm-libs
    lm_sensors
    spirv-tools
    wayland
    zlib
    zstd
  )
  optdepends=(
    "vulkan-freedreno-iceland: Vulkan (turnip) for the Adreno 840"
    "opengl-man-pages: for the OpenGL API man pages"
  )
  provides=(
    "mesa=$_epoch:$pkgver-$pkgrel"
    "mesa-libgl=$_epoch:$pkgver-$pkgrel"
    "libva-mesa-driver=$_epoch:$pkgver-$pkgrel"
    "vulkan-mesa-implicit-layers=$_epoch:$pkgver-$pkgrel"
    "vulkan-mesa-device-select=$_epoch:$pkgver-$pkgrel"
    libgl
    libegl
    libgles
    libva-driver
    opengl-driver
  )
  conflicts=(
    mesa
    mesa-libgl
    libva-mesa-driver
    vulkan-mesa-implicit-layers
    vulkan-mesa-device-select
  )

  meson install -C build --destdir "$pkgdir" --no-rebuild

  (
    local libdir=usr/lib
    cd "$pkgdir"

    if [[ $_rusticl == true ]]; then
      _pick opencl $libdir/libRusticlOpenCL*
      _pick opencl etc/OpenCL/vendors/rusticl.icd
    fi

    _pick vkfdreno $libdir/libvulkan_freedreno.so
    _pick vkfdreno usr/share/vulkan/icd.d/freedreno_icd.json

    _pick vkswrast $libdir/libvulkan_lvp.so
    _pick vkswrast usr/share/vulkan/icd.d/lvp_icd.json

    _pick vkvirtio $libdir/libvulkan_virtio.so
    _pick vkvirtio usr/share/vulkan/icd.d/virtio_icd.json

    rm -rf usr/share/doc

    # indirect rendering
    ln -sr $libdir/libGLX_{mesa,indirect}.so.0
  )

  install -Dm644 mesa-$_ver/docs/license.rst -t "$pkgdir/usr/share/licenses/$pkgname"
}

_vkdepends=(
  expat
  glibc
  libdisplay-info
  libdrm
  libgcc
  libstdc++
  libx11
  libxcb
  libxshmfence
  systemd-libs
  vulkan-icd-loader
  wayland
  xcb-util-keysyms
  zlib
  zstd
)

package_vulkan-freedreno-iceland() {
  pkgdesc="Open-source Vulkan driver for Adreno GPUs (turnip), OnePlus Pad 4 build"
  depends=("${_vkdepends[@]}" spirv-tools "mesa-iceland=$pkgver-$pkgrel")
  optdepends=("vulkan-mesa-layers: additional vulkan layers")
  provides=("vulkan-freedreno=$_epoch:$pkgver-$pkgrel" vulkan-driver)
  conflicts=(vulkan-freedreno)
  mv vkfdreno/* "$pkgdir"
  install -Dm644 mesa-$_ver/docs/license.rst -t "$pkgdir/usr/share/licenses/$pkgname"
}

package_vulkan-swrast-iceland() {
  pkgdesc="Open-source Vulkan driver for CPUs (lavapipe), OnePlus Pad 4 mesa build"
  depends=("${_vkdepends[@]}" llvm-libs spirv-tools "mesa-iceland=$pkgver-$pkgrel")
  optdepends=("vulkan-mesa-layers: additional vulkan layers")
  provides=("vulkan-swrast=$_epoch:$pkgver-$pkgrel" vulkan-driver)
  conflicts=(vulkan-swrast vulkan-mesa)
  mv vkswrast/* "$pkgdir"
  install -Dm644 mesa-$_ver/docs/license.rst -t "$pkgdir/usr/share/licenses/$pkgname"
}

package_vulkan-virtio-iceland() {
  pkgdesc="Open-source Vulkan driver for Virtio-GPU (Venus), OnePlus Pad 4 mesa build"
  depends=("${_vkdepends[@]}" "mesa-iceland=$pkgver-$pkgrel")
  optdepends=("vulkan-mesa-layers: additional vulkan layers")
  provides=("vulkan-virtio=$_epoch:$pkgver-$pkgrel" vulkan-driver)
  conflicts=(vulkan-virtio)
  mv vkvirtio/* "$pkgdir"
  install -Dm644 mesa-$_ver/docs/license.rst -t "$pkgdir/usr/share/licenses/$pkgname"
}

package_opencl-mesa-iceland() {
  pkgdesc="Open-source OpenCL drivers (rusticl), OnePlus Pad 4 mesa build"
  # Arch x86 has a separate clang-libs; Arch Linux ARM ships libclang-cpp in "clang" itself (1st build: the
  # clang-libs dependency was unresolvable at install, 23 Nov)
  depends=(
    clang
    expat
    glibc
    libdrm
    libelf
    libgcc
    libstdc++
    llvm-libs
    spirv-llvm-translator
    spirv-tools
    zlib
    zstd
    libclc
    "mesa-iceland=$pkgver-$pkgrel"
  )
  optdepends=("opencl-headers: headers necessary for OpenCL development")
  provides=("opencl-mesa=$_epoch:$pkgver-$pkgrel" opencl-driver)
  conflicts=(opencl-mesa opencl-clover-mesa opencl-rusticl-mesa)
  mv opencl/* "$pkgdir"
  install -Dm644 mesa-$_ver/docs/license.rst -t "$pkgdir/usr/share/licenses/$pkgname"
}
