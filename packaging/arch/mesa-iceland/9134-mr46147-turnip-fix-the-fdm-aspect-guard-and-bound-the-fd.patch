From 4f1d4467aff17974f4e78de21f7377e251765882 Mon Sep 17 00:00:00 2001
From: Dhruv Mark Collins <mark@igalia.com>
Date: Tue, 10 Nov 2026 10:38:06 +0000
Subject: [PATCH 3/3] tu: Bound the FDM offset LRZ padding by all layers of the
 image

GMEM holds every layer a render pass renders, so its tiles can have at
most usable_gmem_size_gmem / (cpp * layers) pixels of an attachment.
Images with FDM offsets are typically rendered with multiview, one view
per layer, so bound their LRZ padding by the tiles of a render pass that
renders all of their layers. A render pass that renders fewer layers is
still bound to tiles that fit the padding, but may get more of them.

An imageless framebuffer only knows the layers of its attachment views,
so with a view of fewer layers than the image it derives a larger bound
than the image was padded by. Fall back to sysmem when the tiles exceed
the padding of an attachment.

Signed-off-by: Dhruv Mark Collins <mark@igalia.com>
Assisted-by: LLM
---
 src/freedreno/vulkan/tu_cmd_buffer.cc | 24 ++++++++++++++++++++++++
 src/freedreno/vulkan/tu_device.cc     |  3 ++-
 src/freedreno/vulkan/tu_image.cc      | 20 +++++++++++---------
 src/freedreno/vulkan/tu_image.h       |  2 +-
 4 files changed, 38 insertions(+), 11 deletions(-)

diff --git a/src/freedreno/vulkan/tu_cmd_buffer.cc b/src/freedreno/vulkan/tu_cmd_buffer.cc
index a3a6e796ec3..9c1bdba774a 100644
--- a/src/freedreno/vulkan/tu_cmd_buffer.cc
+++ b/src/freedreno/vulkan/tu_cmd_buffer.cc
@@ -1453,6 +1453,25 @@ use_hw_binning(struct tu_cmd_buffer *cmd)
    return vsc->binning_possible && vsc->binning_useful;
 }
 
+/* An imageless framebuffer bounds its tiles by the layers of its attachment
+ * views, which can let them outgrow the LRZ padding of an image with more
+ * layers.
+ */
+static bool
+fdm_offset_tiles_exceed_lrz_padding(const struct tu_cmd_buffer *cmd)
+{
+   const VkExtent2D tile0 = cmd->state.tiling->tile0;
+
+   for (unsigned i = 0; i < cmd->state.pass->attachment_count; i++) {
+      const struct tu_image_view *iview = cmd->state.attachments[i];
+      if (iview && (tile0.width > iview->image->max_tile_w_constraint_fdm ||
+                    tile0.height > iview->image->max_tile_h_constraint_fdm))
+         return true;
+   }
+
+   return false;
+}
+
 static bool
 use_sysmem_rendering(struct tu_cmd_buffer *cmd,
                      tu_autotune::rp_ctx_t *rp_ctx,
@@ -1469,6 +1488,11 @@ use_sysmem_rendering(struct tu_cmd_buffer *cmd,
       return true;
    }
 
+   if (cmd->state.pass->has_fdm && fdm_offset_tiles_exceed_lrz_padding(cmd)) {
+      cmd->state.rp.force_render_mode_reason = "Tiles exceed the FDM offset LRZ padding";
+      return true;
+   }
+
    /* Use sysmem for empty render areas */
    if (cmd->state.per_layer_render_area) {
       for (unsigned i = 0; i < tu_fdm_num_layers(cmd); i++) {
