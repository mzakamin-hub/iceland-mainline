From fb9867449590762053b8b60b99c8949711e5d859 Mon Sep 17 00:00:00 2001
From: Dhruv Mark Collins <mark@igalia.com>
Date: Fri, 28 Aug 2026 12:52:48 +0000
Subject: [PATCH 1/3] tu: Check the FDM tile aspect guard against the tile
 height used

The FDM aspect guard was checked before the tile height is re-derived from
the tile count, which only ever lowers it, so a tile inside 2:1 at the GMEM
budget's height could be outside it once chosen. A 1024x1024 framebuffer
whose budget allows 576x288 tiles passes the guard with them and renders
576x256.

Check the guard after the re-derivation, against the height that's
rendered. It stays a penalty rather than a veto, so a framebuffer without
any tile inside 2:1 still gets a tiling.

Signed-off-by: Dhruv Mark Collins <mark@igalia.com>
Assisted-by: LLM
---
 src/freedreno/vulkan/tu_util.cc | 18 +++++++++---------
 1 file changed, 9 insertions(+), 9 deletions(-)

diff --git a/src/freedreno/vulkan/tu_util.cc b/src/freedreno/vulkan/tu_util.cc
index 76e4f4afedd..0606b0ff7d2 100644
--- a/src/freedreno/vulkan/tu_util.cc
+++ b/src/freedreno/vulkan/tu_util.cc
@@ -304,6 +304,15 @@ tu_tiling_config_update_tile_layout(struct tu_framebuffer *fb,
       if (!tile_size.height)
          continue;
 
+      tile_count.width = DIV_ROUND_UP(fb->width, tile_size.width);
+      tile_count.height = DIV_ROUND_UP(fb->height, tile_size.height);
+
+      /* Drop the height of the tile down to split tiles more evenly across the
+       * screen for a given tile count.
+       */
+      tile_size.height =
+         align(DIV_ROUND_UP(fb->height, tile_count.height), tile_align_h);
+
       /* When using FDM, we need approximately square tiles to maintain
        * proper density distribution across the framebuffer.
        * Way to wide or tall tiles would distort the density mapping, causing
@@ -317,15 +326,6 @@ tu_tiling_config_update_tile_layout(struct tu_framebuffer *fb,
          fdm_penalty = 1000;
       }
 
-      tile_count.width = DIV_ROUND_UP(fb->width, tile_size.width);
-      tile_count.height = DIV_ROUND_UP(fb->height, tile_size.height);
-
-      /* Drop the height of the tile down to split tiles more evenly across the
-       * screen for a given tile count.
-       */
-      tile_size.height =
-         align(DIV_ROUND_UP(fb->height, tile_count.height), tile_align_h);
-
       /* Pick the layout with the minimum number of bins (lowest CP overhead
        * and amount of cache flushing), but the most square tiles in the case
        * of a tie (likely highest cache locality).

From 0487dc102357b2c856a5521e382f67415857200f Mon Sep 17 00:00:00 2001
From: Dhruv Mark Collins <mark@igalia.com>
Date: Mon, 9 Nov 2026 17:57:42 +0000
Subject: [PATCH 2/3] tu: Bound the FDM offset LRZ padding by what GMEM can
 hold

An LRZ image used with FDM offsets is shifted by however far the bin grid
slides, so it's padded by that much. The slide is less than a tile, so
fdl6_lrz_get_max_fdm_extra_size() searches for the largest tile that
still keeps LRZ fast clear covered, and that size bounds both the padding
and the tile search. Where no tile keeps fast clear covered, it falls
back to the device's largest tile, and the image is then padded for, and
every render pass clears and walks, LRZ that no slide can reach.

No render pass using the image can have a tile with more pixels than
GMEM holds of the image alone, the FDM aspect guard keeps tiles within
2:1, and tile sides are multiples of the tile alignment. Bound the search
and the fallback by the longest side of a tile that meets all three
rather than by the device's largest tile.

Imageless framebuffers now also take the sample count from the depth
attachment rather than the first one, so they derive the same bound as
the image.

Signed-off-by: Dhruv Mark Collins <mark@igalia.com>
Assisted-by: LLM
---
 src/freedreno/fdl/freedreno_lrz_layout.h | 14 +++++++----
 src/freedreno/vulkan/tu_device.cc        |  9 ++++---
 src/freedreno/vulkan/tu_image.cc         | 30 ++++++++++++++++++++----
 src/freedreno/vulkan/tu_image.h          |  3 +++
 4 files changed, 41 insertions(+), 15 deletions(-)

diff --git a/src/freedreno/fdl/freedreno_lrz_layout.h b/src/freedreno/fdl/freedreno_lrz_layout.h
index 594358e7261..535eb59583b 100644
--- a/src/freedreno/fdl/freedreno_lrz_layout.h
+++ b/src/freedreno/fdl/freedreno_lrz_layout.h
@@ -280,15 +280,19 @@ struct fdl_lrz_fdm_extra_size {
 };
 
 /* Get maximum size of the extra tile for VK_QCOM_fragment_density_map_offset,
- * that keeps LRZ fast-clear enabled, if possible.
+ * that keeps LRZ fast-clear enabled, if possible. No tile is larger than
+ * max_tile_size, so neither is the extra size.
  */
 template <chip CHIP>
 static struct fdl_lrz_fdm_extra_size
 fdl6_lrz_get_max_fdm_extra_size(const struct fd_dev_info *dev_info,
                                 uint32_t width, uint32_t height,
-                                uint32_t nr_samples, uint32_t array_layers)
+                                uint32_t nr_samples, uint32_t array_layers,
+                                uint32_t max_tile_size)
 {
    constexpr uint32_t MIN_TILE_SIZE_FOR_FDM_OFFSET = 192;
+   const uint32_t max_tile_w = MIN2(dev_info->tile_max_w, max_tile_size);
+   const uint32_t max_tile_h = MIN2(dev_info->tile_max_h, max_tile_size);
 
    struct fdl_layout layout = {
       .width0 = width,
@@ -299,10 +303,10 @@ fdl6_lrz_get_max_fdm_extra_size(const struct fd_dev_info *dev_info,
    fdl6_lrz_layout_init<CHIP>(&lrz_layout, &layout, 0, 0, dev_info, 0,
                               array_layers);
    if (!fdl6_lrz_fc_fully_covered(&lrz_layout)) {
-      return {dev_info->tile_max_w, dev_info->tile_max_h};
+      return {max_tile_w, max_tile_h};
    }
 
-   uint32_t max_extra_size = MIN2(dev_info->tile_max_w, dev_info->tile_max_h);
+   uint32_t max_extra_size = MIN2(max_tile_w, max_tile_h);
    uint32_t step = MIN2(dev_info->gmem_align_w, dev_info->gmem_align_h);
    uint32_t min_extra_size = MAX2(step, MIN_TILE_SIZE_FOR_FDM_OFFSET);
 
@@ -317,7 +321,7 @@ fdl6_lrz_get_max_fdm_extra_size(const struct fd_dev_info *dev_info,
       max_extra_size -= step;
    }
 
-   return {dev_info->tile_max_w, dev_info->tile_max_h};
+   return {max_tile_w, max_tile_h};
 }
 #endif
 
