---
 src/freedreno/vulkan/tu_shader.cc | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/src/freedreno/vulkan/tu_shader.cc b/src/freedreno/vulkan/tu_shader.cc
index 9ad75ff08cc..ece319aadfc 100644
--- a/src/freedreno/vulkan/tu_shader.cc
+++ b/src/freedreno/vulkan/tu_shader.cc
@@ -4142,6 +4142,14 @@ tu_empty_shader_create(struct tu_device *dev,
    if (!shader)
       return VK_ERROR_OUT_OF_HOST_MEMORY;
 
+   /* Empty shaders don't access any descriptor set, so they know nothing
+    * about the dynamic descriptor sizes of the layout. Mark them unknown so
+    * that they don't override the sizes from real shaders when the program
+    * state is assembled from libraries.
+    */
+   for (unsigned i = 0; i < MAX_SETS; i++)
+      shader->dynamic_descriptor_sizes[i] = -1;
+
    pthread_mutex_lock(&dev->pipeline_mutex);
    VkResult result = tu_suballoc_bo_alloc(&shader->bo, &dev->pipeline_suballoc,
                                           32 * 4, 128);
