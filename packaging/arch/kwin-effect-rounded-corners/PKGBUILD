# iceland project build of matinlotfali/KDE-Rounded-Corners (based on AUR kwin-effect-rounded-corners-git),
# pinned to a commit and built for aarch64 against the container's kwin. Wayland build (KWIN_X11=OFF).
# Rebuild whenever kwin changes minor version (the effect links against kwin's private effect API).
pkgname=kwin-effect-rounded-corners
_commit=66d7ce91a4f26062bba91bc7274ba85b6211391f   # tag v0.11.0
pkgver=0.11.0
pkgrel=1
pkgdesc='KWin effect: rounded window corners with outlines and shadows (Wayland)'
arch=('aarch64' 'x86_64')
url='https://github.com/matinlotfali/KDE-Rounded-Corners'
license=('GPL-3.0-only')
depends=('kwin')
makedepends=('git' 'cmake' 'extra-cmake-modules' 'ninja' 'vulkan-headers' 'qt6-tools' 'kcmutils' 'kconfigwidgets' 'ki18n')
provides=('kwin-effect-rounded-corners-git')
conflicts=('kwin-effect-rounded-corners-git')
source=("kde-rounded-corners::git+https://github.com/matinlotfali/KDE-Rounded-Corners.git#commit=${_commit}")
sha256sums=('SKIP')

build() {
  cmake -B build -S kde-rounded-corners -G Ninja -Wno-dev -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 kde-rounded-corners/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
