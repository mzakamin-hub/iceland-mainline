From 1ea9676ee48d2357e085d3623da3d6e86e0f8f52 Mon Sep 17 00:00:00 2001
From: Emma Anholt <anholt@igalia.com>
Date: Fri, 9 Oct 2026 14:42:09 -0700
Subject: [PATCH 1/6] ir3: Add support for (not) as a source modifier name.

blob disasm prints the flag as (not) on and.b/or.b in some actual a540
instruction examples I have.  I've verified not-vs-neg behavior on all the
opcodes documented for a530/a660/a750.

Assisted-by: LLM
Part-of: <https://gitlab.freedesktop.org/mesa/mesa/-/merge_requests/45464>
(cherry picked from commit 10839580a96a52bdf3f5ec49f622420747a075d8)
---
 src/freedreno/ir3/ir3_lexer.l    |  1 +
 src/freedreno/ir3/ir3_parser.y   |  2 ++
 src/freedreno/ir3/ir3_print.c    | 12 +++++---
 src/freedreno/ir3/tests/disasm.c | 21 ++++++++++++++
 src/freedreno/isa/ir3-cat2.xml   | 50 ++++++++++++++++++++++++++++++++
 src/freedreno/isa/ir3-cat4.xml   |  2 ++
 src/freedreno/isa/ir3-common.xml | 22 +++++++++-----
 7 files changed, 98 insertions(+), 12 deletions(-)

diff --git a/src/freedreno/ir3/ir3_lexer.l b/src/freedreno/ir3/ir3_lexer.l
index 2aef2f52a52..6b8acbbfa75 100644
--- a/src/freedreno/ir3/ir3_lexer.l
+++ b/src/freedreno/ir3/ir3_lexer.l
@@ -162,6 +162,7 @@ static int parse_reg(const char *str)
 "(ss)"                            return TOKEN(T_SS);
 "(absneg)"                        return TOKEN(T_ABSNEG);
 "(neg)"                           return TOKEN(T_NEG);
+"(not)"                           return TOKEN(T_NOT);
 "(abs)"                           return TOKEN(T_ABS);
 "(r)"                             return TOKEN(T_R);
 "(last)"                          return TOKEN(T_LAST);
diff --git a/src/freedreno/ir3/ir3_parser.y b/src/freedreno/ir3/ir3_parser.y
index 60b9ecec6c9..31db579ebc5 100644
--- a/src/freedreno/ir3/ir3_parser.y
+++ b/src/freedreno/ir3/ir3_parser.y
@@ -93,6 +93,7 @@ static void print_token(FILE *file, int type, YYSTYPE value)
 /* src register flags */
 %token <tok> T_ABSNEG
 %token <tok> T_NEG
+%token <tok> T_NOT
 %token <tok> T_ABS
 %token <tok> T_R
 %token <tok> T_LAST
@@ -1370,6 +1371,7 @@ dst_reg:           dst                 { $1->flags |= IR3_REG_R; }
 
 src_reg_flag:      T_ABSNEG       { rflags.flags |= IR3_REG_ABS|IR3_REG_NEGATE; }
 |                  T_NEG          { rflags.flags |= IR3_REG_NEGATE; }
+|                  T_NOT          { rflags.flags |= IR3_REG_BNOT; }
 |                  T_ABS          { rflags.flags |= IR3_REG_ABS; }
 |                  T_R            { rflags.flags |= IR3_REG_R; }
 |                  T_LAST         { rflags.flags |= IR3_REG_LAST_USE; }
diff --git a/src/freedreno/ir3/ir3_print.c b/src/freedreno/ir3/ir3_print.c
index 274e677d98a..e1f60e7eeda 100644
--- a/src/freedreno/ir3/ir3_print.c
+++ b/src/freedreno/ir3/ir3_print.c
@@ -336,12 +336,16 @@ print_reg_name(struct log_stream *stream, struct ir3_instruction *instr,
                struct ir3_register *reg, bool dest)
 {
    if ((reg->flags & (IR3_REG_FABS | IR3_REG_SABS)) &&
-       (reg->flags & (IR3_REG_FNEG | IR3_REG_SNEG | IR3_REG_BNOT)))
+       (reg->flags & (IR3_REG_FNEG | IR3_REG_SNEG)))
       mesa_log_stream_printf(stream, "(absneg)");
-   else if (reg->flags & (IR3_REG_FNEG | IR3_REG_SNEG | IR3_REG_BNOT))
+   else if (reg->flags & (IR3_REG_FNEG | IR3_REG_SNEG))
       mesa_log_stream_printf(stream, "(neg)");
-   else if (reg->flags & (IR3_REG_FABS | IR3_REG_SABS))
-      mesa_log_stream_printf(stream, "(abs)");
+   else {
+      if (reg->flags & (IR3_REG_FABS | IR3_REG_SABS))
+         mesa_log_stream_printf(stream, "(abs)");
+      if (reg->flags & (IR3_REG_BNOT))
+         mesa_log_stream_printf(stream, "(not)");
+   }
 
    if (reg->flags & IR3_REG_FIRST_KILL)
       mesa_log_stream_printf(stream, "(kill)");
