@@ -208,7 +208,7 @@ fdl6_lrz_layout_init(struct fdl_lrz_layout *lrz_layout,
          DIV_ROUND_UP(layout->height0 + extra_height, lrz_block->height);
 
       lrz_layout->lrz_pitch =
-         align(surface_width_in_blocks * per_slice_block_width_in_tiles, 64);
+         align(surface_width_in_blocks * per_slice_block_width_in_tiles, 32);
 
       /* Construct a "fake" height to use for fallback lrz clear on
        * the blitter.  Since we use lrz_pitch as the width, this is
diff --git a/src/freedreno/vulkan/tu_clear_blit.cc b/src/freedreno/vulkan/tu_clear_blit.cc
index 46147b75067..0b6ccc80656 100644
--- a/src/freedreno/vulkan/tu_clear_blit.cc
+++ b/src/freedreno/vulkan/tu_clear_blit.cc
@@ -2563,16 +2563,12 @@ tu6_clear_lrz_partial(struct tu_cmd_buffer *cmd,
          if (first >= lrz->lrz_layer_size)
             continue;
 
-         const uint32_t clear_block_bytes = 2048;
          if constexpr (CHIP < A8XX) {
             /* LRZ FC layer stride alignment is 64 bytes, or 512 bits. Each bit
              * is a FC block that covers 128 bytes.
              */
             assert(first % (512 * 128) == 0);
          }
