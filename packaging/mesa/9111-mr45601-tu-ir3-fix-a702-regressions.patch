From fe5332563400808c3e2f17779a4341e5d45d4150 Mon Sep 17 00:00:00 2001
From: Valentine Burley <valentine.burley@collabora.com>
Date: Sat, 24 Oct 2026 15:24:13 +0200
Subject: [PATCH] tu: Fix software multiview with indirect draws

Restore the SW multiview handling that was dropped in 69f1f21f025.

The original change assumed that this would avoid calling
tu6_emit_vs_params() twice. However, the call in tu_CmdDrawIndirect() is
gated by need_ubo, which is always false on a6xx_gen1_low and a702.

Fixes: 69f1f21f025 ("tu: upload draw_id_offset through driver_params UBO")
Signed-off-by: Valentine Burley <valentine.burley@collabora.com>
Signed-off-by: Dmitry Baryshkov <dmitry.baryshkov@oss.qualcomm.com>
Part-of: <https://gitlab.freedesktop.org/mesa/mesa/-/merge_requests/45601>
(cherry picked from commit c8c572b018fd3eee8ff63bc2353d226522498f05)
---
 src/freedreno/vulkan/tu_cmd_buffer.cc | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/src/freedreno/vulkan/tu_cmd_buffer.cc b/src/freedreno/vulkan/tu_cmd_buffer.cc
index ccff3ea46c1..43deb8ea876 100644
--- a/src/freedreno/vulkan/tu_cmd_buffer.cc
+++ b/src/freedreno/vulkan/tu_cmd_buffer.cc
@@ -9202,6 +9202,16 @@ template <chip CHIP>
 static void
 tu6_emit_empty_vs_params(struct tu_cmd_buffer *cmd)
 {
+   if (cmd->state.sw_multiview && vs_params_offset(cmd)) {
+      /* We still have to upload the view index of the current replay. Skip the
+       * VFD registers though: CP_DRAW_INDIRECT_MULTI sources VFD_INDEX_OFFSET
+       * and VFD_INSTANCE_START_OFFSET from the indirect buffer, and a draw
+       * state writing them would clobber those values.
+       */
+      tu6_emit_vs_params(cmd, NULL, 0, 0, 0, 0, /* indirect = */ true);
+      return;
+   }
+
    if (cmd->state.last_vs_params.empty)
       return;
 
