From 713494ef045265c167170799eac39511530cae23 Mon Sep 17 00:00:00 2001
From: Job Noorman <jnoorman@igalia.com>
Date: Fri, 6 Nov 2026 17:20:20 +0100
Subject: [PATCH 2/3] ir3: only fold fsat to (sat) on cat2/3 float instructions

We use is_sat_compatible to fold fsat into a (sat) on its src. (sat)
only performs floating point saturation (fsat) on  floating point
instructions and produces a wrong result (e.g., integer saturation) or
is ignored (e.g., bitwise ops) on other instructions. Fix this by only
marking floating point instructions as is_sat_compatible.

Signed-off-by: Job Noorman <jnoorman@igalia.com>
Fixes: 942341bcd01 ("freedreno/ir3: don't lower fsat")
Part-of: <https://gitlab.freedesktop.org/mesa/mesa/-/merge_requests/46027>
(cherry picked from commit 5a9db0be64e090164930593c6cd13d08ad45123f)
---
 src/freedreno/ir3/instr-a3xx.h | 19 +------------------
 1 file changed, 1 insertion(+), 18 deletions(-)

diff --git a/src/freedreno/ir3/instr-a3xx.h b/src/freedreno/ir3/instr-a3xx.h
index f4cf75e83e8..92a39b5711f 100644
--- a/src/freedreno/ir3/instr-a3xx.h
+++ b/src/freedreno/ir3/instr-a3xx.h
@@ -651,24 +651,7 @@ static inline bool
 is_sat_compatible(opc_t opc)
 {
    /* On a6xx saturation doesn't work on cat4 */
-   if (opc_cat(opc) != 2 && opc_cat(opc) != 3)
-      return false;
-
-   switch (opc) {
-   /* On a3xx and a6xx saturation doesn't work on bary.f/flat.b */
-   case OPC_BARY_F:
-   case OPC_FLAT_B:
-   /* On a6xx saturation doesn't work on sel.* */
-   case OPC_SEL_B16:
-   case OPC_SEL_B32:
-   case OPC_SEL_S16:
-   case OPC_SEL_S32:
-   case OPC_SEL_F16:
-   case OPC_SEL_F32:
-      return false;
-   default:
-      return true;
-   }
+   return is_cat2_float(opc) || is_cat3_float(opc);
 }
 
 static inline bool

From cb9ad8b6ff3016f8c58611576bfb6d84ee6c44d1 Mon Sep 17 00:00:00 2001
From: Job Noorman <jnoorman@igalia.com>
Date: Fri, 6 Nov 2026 17:20:20 +0100
Subject: [PATCH 3/3] ir3: rename is_sat_compatible to sat_is_fsat

The name of the helper was confusing because it isn't used to check
whether an instruction supports (sat) but whether (sat) is equivalent to
fsat.

Signed-off-by: Job Noorman <jnoorman@igalia.com>
Part-of: <https://gitlab.freedesktop.org/mesa/mesa/-/merge_requests/46027>
(cherry picked from commit 05ff917628f471beb2d3ead484c7110354a1fb64)
---
 src/freedreno/ir3/instr-a3xx.h       | 3 ++-
 src/freedreno/ir3/ir3_compiler_nir.c | 6 +++---
 2 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/src/freedreno/ir3/instr-a3xx.h b/src/freedreno/ir3/instr-a3xx.h
index 92a39b5711f..83539f250fe 100644
--- a/src/freedreno/ir3/instr-a3xx.h
+++ b/src/freedreno/ir3/instr-a3xx.h
@@ -647,8 +647,9 @@ is_cat3_float(opc_t opc)
    }
 }
 
+/* Is (sat) equivalent to fsat? */
 static inline bool
-is_sat_compatible(opc_t opc)
+sat_is_fsat(opc_t opc)
 {
    /* On a6xx saturation doesn't work on cat4 */
    return is_cat2_float(opc) || is_cat3_float(opc);
diff --git a/src/freedreno/ir3/ir3_compiler_nir.c b/src/freedreno/ir3/ir3_compiler_nir.c
index 949cf448e5d..462185ecbec 100644
--- a/src/freedreno/ir3/ir3_compiler_nir.c
+++ b/src/freedreno/ir3/ir3_compiler_nir.c
@@ -534,10 +534,10 @@ emit_alu_dot_4x8_as_dp2acc(struct ir3_context *ctx, nir_alu_instr *alu,
 }
 
 static bool
-all_sat_compatible(struct ir3_instruction *instrs[], unsigned n)
+all_sat_is_fsat(struct ir3_instruction *instrs[], unsigned n)
 {
    for (unsigned i = 0; i < n; i++) {
-      if (!is_sat_compatible(instrs[i]->opc))
+      if (!sat_is_fsat(instrs[i]->opc))
          return false;
    }
 
@@ -709,7 +709,7 @@ emit_alu(struct ir3_context *ctx, nir_alu_instr *alu)
        * src instruction and create a mov.  This is easier for cp
        * to eliminate.
        */
-      if (all_sat_compatible(src[0].rpts, dst_sz) &&
+      if (all_sat_is_fsat(src[0].rpts, dst_sz) &&
           is_unique_use(&alu->src[0].src)) {
          set_instr_flags(src[0].rpts, dst_sz, IR3_INSTR_SAT);
          dst = ir3_MOV_rpt(b, dst_sz, src[0], dst_type);
