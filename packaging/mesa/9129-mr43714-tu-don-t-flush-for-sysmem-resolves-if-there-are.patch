From 014bd66ffaf8a3326ed3bea398b70a09252c21a1 Mon Sep 17 00:00:00 2001
From: Connor Abbott <cwabbott0@gmail.com>
Date: Wed, 12 Aug 2026 14:55:09 -0400
Subject: [PATCH] tu: Don't flush for sysmem resolves if there are no resolves

We were accidentally flushing way too much because in the
dynamic-rendering case we always set resolve_attachments, even if all
the resolve attachments were NULL.

Part-of: <https://gitlab.freedesktop.org/mesa/mesa/-/merge_requests/43714>
---
 src/freedreno/vulkan/tu_cmd_buffer.cc | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/src/freedreno/vulkan/tu_cmd_buffer.cc b/src/freedreno/vulkan/tu_cmd_buffer.cc
index c3a15fba837..b9598fd0055 100644
--- a/src/freedreno/vulkan/tu_cmd_buffer.cc
+++ b/src/freedreno/vulkan/tu_cmd_buffer.cc
@@ -1919,7 +1919,21 @@ tu6_emit_sysmem_resolves(struct tu_cmd_buffer *cmd,
                          struct tu_cs *cs,
                          const struct tu_subpass *subpass)
 {
+   /* Every slot can be UNUSED if there are no resolves. Don't pay the flushes
+    * below for an empty one.
+    */
+   bool any_resolves = false;
    if (subpass->resolve_attachments) {
+      for (unsigned i = 0; i < subpass->resolve_count; i++) {
+         if (subpass->resolve_attachments[i].attachment !=
+             VK_ATTACHMENT_UNUSED) {
+            any_resolves = true;
+            break;
+         }
+      }
+   }
+
+   if (any_resolves) {
       /* From the documentation for vkCmdNextSubpass, section 7.4 "Render Pass
        * Commands":
        *
