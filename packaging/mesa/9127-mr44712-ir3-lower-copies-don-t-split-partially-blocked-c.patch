From 05298538b0358fd5cde3b0e7e7a55d2f065316eb Mon Sep 17 00:00:00 2001
From: Job Noorman <jnoorman@igalia.com>
Date: Thu, 22 Oct 2026 09:54:09 +0200
Subject: [PATCH 1/5] ir3/lower_copies: add mark_done helper

Signed-off-by: Job Noorman <jnoorman@igalia.com>
---
 src/freedreno/ir3/ir3_lower_parallelcopy.c | 19 +++++++++++++------
 1 file changed, 13 insertions(+), 6 deletions(-)

diff --git a/src/freedreno/ir3/ir3_lower_parallelcopy.c b/src/freedreno/ir3/ir3_lower_parallelcopy.c
index 60e062ae52a..9a39525ba8c 100644
--- a/src/freedreno/ir3/ir3_lower_parallelcopy.c
+++ b/src/freedreno/ir3/ir3_lower_parallelcopy.c
@@ -264,6 +264,18 @@ entry_blocked(struct copy_entry *entry, struct copy_ctx *ctx)
    return false;
 }
 
+static void
+mark_done(struct copy_entry *entry, struct copy_ctx *ctx)
+{
+   for (unsigned j = 0; j < copy_entry_size(entry); j++) {
+      if (!entry->src.flags)
+         ctx->physreg_use_count[entry->src.reg + j]--;
+      ctx->physreg_dst[entry->dst + j] = NULL;
+   }
+
+   entry->done = true;
+}
+
 static void
 split_32bit_copy(struct copy_ctx *ctx, struct copy_entry *entry)
 {
@@ -326,14 +338,9 @@ _handle_copies(struct ir3_compiler *compiler, struct ir3_instruction *instr,
       for (unsigned i = 0; i < ctx->entry_count; i++) {
          struct copy_entry *entry = &ctx->entries[i];
          if (!entry->done && !entry_blocked(entry, ctx)) {
-            entry->done = true;
             progress = true;
             do_copy(compiler, instr, entry);
-            for (unsigned j = 0; j < copy_entry_size(entry); j++) {
-               if (!entry->src.flags)
-                  ctx->physreg_use_count[entry->src.reg + j]--;
-               ctx->physreg_dst[entry->dst + j] = NULL;
-            }
+            mark_done(entry, ctx);
          }
       }
 

From 27097e278d3154288f1a0f7baafdcc79050f91a7 Mon Sep 17 00:00:00 2001
From: Job Noorman <jnoorman@igalia.com>
Date: Thu, 22 Oct 2026 09:54:09 +0200
Subject: [PATCH 2/5] ir3/lower_copies: make physreg_dst a bool array

Even though we stored pointers to copy_entry there, we only used it to
check whether a pending copy_entry exists that writes a physreg.
Moreover, since we started sorting entries, the pointers here wouldn't
be valid anymore making them a potential footgun. Just make the array
store bool.

Signed-off-by: Job Noorman <jnoorman@igalia.com>
---
 src/freedreno/ir3/ir3_lower_parallelcopy.c | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/src/freedreno/ir3/ir3_lower_parallelcopy.c b/src/freedreno/ir3/ir3_lower_parallelcopy.c
index 9a39525ba8c..974715b9e83 100644
--- a/src/freedreno/ir3/ir3_lower_parallelcopy.c
+++ b/src/freedreno/ir3/ir3_lower_parallelcopy.c
@@ -246,8 +246,8 @@ struct copy_ctx {
     */
    unsigned physreg_use_count[RA_MAX_FILE_SIZE];
 
-   /* For each physreg, the pending copy_entry that uses it as a dest. */
-   struct copy_entry *physreg_dst[RA_MAX_FILE_SIZE];
+   /* For each physreg, whether it is the dst of a pending copy_entry. */
+   bool physreg_dst[RA_MAX_FILE_SIZE];
 
    struct copy_entry entries[RA_MAX_FILE_SIZE];
    unsigned entry_count;
@@ -270,7 +270,7 @@ mark_done(struct copy_entry *entry, struct copy_ctx *ctx)
    for (unsigned j = 0; j < copy_entry_size(entry); j++) {
       if (!entry->src.flags)
          ctx->physreg_use_count[entry->src.reg + j]--;
-      ctx->physreg_dst[entry->dst + j] = NULL;
+      ctx->physreg_dst[entry->dst + j] = false;
    }
 
    entry->done = true;
@@ -318,7 +318,7 @@ _handle_copies(struct ir3_compiler *compiler, struct ir3_instruction *instr,
 
          /* Copies should not have overlapping destinations. */
          assert(!ctx->physreg_dst[entry->dst + j]);
-         ctx->physreg_dst[entry->dst + j] = entry;
+         ctx->physreg_dst[entry->dst + j] = true;
       }
    }
 

From aba97de1b34960fb314856ed4f0f518f66857448 Mon Sep 17 00:00:00 2001
From: Job Noorman <jnoorman@igalia.com>
Date: Thu, 22 Oct 2026 09:54:09 +0200
Subject: [PATCH 3/5] ir3/lower_copies: filter-out self copies earlier

This already happens when resolving cycles so isn't strictly necessary.
However, there's no point wasting earlier CPU cycles on them.

Signed-off-by: Job Noorman <jnoorman@igalia.com>
---
 src/freedreno/ir3/ir3_lower_parallelcopy.c | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/src/freedreno/ir3/ir3_lower_parallelcopy.c b/src/freedreno/ir3/ir3_lower_parallelcopy.c
index 974715b9e83..90df95873ad 100644
--- a/src/freedreno/ir3/ir3_lower_parallelcopy.c
+++ b/src/freedreno/ir3/ir3_lower_parallelcopy.c
@@ -312,6 +312,13 @@ _handle_copies(struct ir3_compiler *compiler, struct ir3_instruction *instr,
 
    for (unsigned i = 0; i < ctx->entry_count; i++) {
       struct copy_entry *entry = &ctx->entries[i];
+
+      /* Filter-out self copies. */
+      if (!entry->src.flags && entry->dst == entry->src.reg) {
+         entry->done = true;
+         continue;
+      }
+
       for (unsigned j = 0; j < copy_entry_size(entry); j++) {
          if (!entry->src.flags)
             ctx->physreg_use_count[entry->src.reg + j]++;

