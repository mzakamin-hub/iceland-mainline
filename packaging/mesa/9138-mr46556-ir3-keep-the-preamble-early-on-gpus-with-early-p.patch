+ * - texture/image/SSBO instructions, which always write GPRs;
+ * - loads that are not ACCESS_CAN_SPECULATE.
+ */
+static bool
+can_move_instr(const nir_instr *instr, const void *data)
+{
+   const struct ir3_shader_variant *v = data;
+
+   if (!v->compiler->info->props.has_early_preamble ||
+       (ir3_shader_debug & IR3_DBG_NOEARLYPREAMBLE))
+      return true;
+
+   if (instr->type == nir_instr_type_tex)
+      return false;
+
+   if (instr->type != nir_instr_type_intrinsic)
+      return true;
+
+   nir_intrinsic_instr *intrin = nir_instr_as_intrinsic(instr);
+
+   /* An early preamble also runs for draws/dispatches that launch no waves,
+    * so it may only contain loads that are safe to speculate.
+    */
