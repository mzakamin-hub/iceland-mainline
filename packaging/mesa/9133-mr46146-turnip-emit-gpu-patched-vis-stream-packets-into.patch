+         tu_cs_emit(vsc_cs, num_vsc_pipes); /* count */
+         tu_cs_emit(vsc_cs, 0);             /* offset */
+         tu_emit_vis_stream_patchpoint(cmd, vsc_cs, cmd->vsc_state_offset);
+
+         tu_vis_stream_patch_end(cmd, cs, vsc_cs);
+      }
    } else if (CHIP >= A7XX) {
       /* Earlier we disabled concurrent binning to make LRZ fast-clear work
        * with no HW binning, now re-enable it while staying on BR.
@@ -6592,8 +6623,12 @@ tu_CmdExecuteCommands(VkCommandBuffer commandBuffer,
          /* If this cmdbuf itself can be used multiple times in a submit then
           * its patchpoint will also be updated on the GPU.
           */
-         if (cmd->usage_flags & VK_COMMAND_BUFFER_USAGE_SIMULTANEOUS_USE_BIT)
-            tu_cs_set_writeable(cs, true);
+         uint32_t patchpoint_count =
+            util_dynarray_num_elements(&secondary->vis_stream_patchpoints, struct tu_vis_stream_patchpoint);
+         struct tu_cs patch_cs;
+         struct tu_cs *write_cs = simultaneous_use && patchpoint_count
+                                     ? tu_vis_stream_patch_begin(cmd, cs, &patch_cs, 5 * patchpoint_count)
+                                     : cs;
 
          util_dynarray_foreach (&secondary->vis_stream_patchpoints,
                                 struct tu_vis_stream_patchpoint,
@@ -6603,20 +6638,19 @@ tu_CmdExecuteCommands(VkCommandBuffer commandBuffer,
             patchpoint.render_pass_idx += cmd->state.tile_render_pass_count;
 
             if (simultaneous_use) {
