-         tu_cs_set_writeable(cs, true);
-
-      tu_emit_vsc<CHIP>(cmd, &cmd->cs);
-
-      if (cmd->usage_flags & VK_COMMAND_BUFFER_USAGE_SIMULTANEOUS_USE_BIT)
-         tu_cs_set_writeable(cs, false);
+      struct tu_cs patch_cs;
+      struct tu_cs *vsc_cs = tu_vis_stream_patch_begin(cmd, cs, &patch_cs, tu_vsc_size<CHIP>());
+      tu_emit_vsc<CHIP>(cmd, vsc_cs);
+      tu_vis_stream_patch_end(cmd, cs, vsc_cs);
    }
 
    unsigned views = tu_fdm_num_layers(cmd);
@@ -3671,13 +3703,10 @@ tu6_tile_render_begin(struct tu_cmd_buffer *cmd, struct tu_cs *cs,
        * emits the preamble lazily. We chose the per-bin approach but blob's
