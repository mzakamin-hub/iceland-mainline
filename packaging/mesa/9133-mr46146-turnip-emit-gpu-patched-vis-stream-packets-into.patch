From 98aabcc90cd06b68aa9fc5d22c0a1348615071c4 Mon Sep 17 00:00:00 2001
From: Dhruv Mark Collins <mark@igalia.com>
Date: Tue, 10 Nov 2026 13:29:44 +0000
Subject: [PATCH] tu: Emit GPU-patched vis stream packets into IB2s

A simultaneous-use command buffer can't have its vis stream addresses
written by the CPU at submit, so they're written on the GPU by
CP_MEM_WRITEs that run right before it: in a separate IB1 at submit for
a primary, and in the primary's IB1 at vkCmdExecuteCommands for a
secondary. But the packets they patch were in the command buffer's own
IB1s, which the CP can prefetch before the writes land. The first
execution of a simultaneous-use secondary with a GMEM render pass then
bins with the addresses it was recorded with, which are 0, and faults.
Later executions get the previous submit's addresses instead, which only
differ when there are several vis streams.

Emit the patched packets into IB2s instead, which the CP only fetches
when it calls them, after the writes and the waits that follow them.
The BV/BR offset in tu_init_hw stays where it is, since a stale value
there is never larger than the current one, which only holds BV back.

Fixes: 50aa66a7c1d ("tu: Rewrite visibility stream allocation")
Signed-off-by: Dhruv Mark Collins <mark@igalia.com>
Assisted-by: LLM
---
 src/freedreno/vulkan/tu_cmd_buffer.cc | 120 +++++++++++++++++---------
 1 file changed, 77 insertions(+), 43 deletions(-)

diff --git a/src/freedreno/vulkan/tu_cmd_buffer.cc b/src/freedreno/vulkan/tu_cmd_buffer.cc
index 7d0fab4c503..a3a6e796ec3 100644
--- a/src/freedreno/vulkan/tu_cmd_buffer.cc
+++ b/src/freedreno/vulkan/tu_cmd_buffer.cc
@@ -287,6 +287,41 @@ tu_emit_vis_stream_patchpoint(struct tu_cmd_buffer *cmd, struct tu_cs *cs,
    tu_cs_emit_qw(cs, offset);
 }
 
+/* A simultaneous-use command buffer's vis stream patchpoints are written on
+ * the GPU right before it runs, which the CP misses if it has already
+ * prefetched the IB1 holding them. So emit the patched packets into an IB2,
+ * which is only fetched once it's called.
+ */
+static struct tu_cs *
+tu_vis_stream_patch_begin(struct tu_cmd_buffer *cmd, struct tu_cs *cs, struct tu_cs *patch_cs, uint32_t size)
+{
+   if (!(cmd->usage_flags & VK_COMMAND_BUFFER_USAGE_SIMULTANEOUS_USE_BIT))
+      return cs;
+
+   tu_cs_set_writeable(&cmd->sub_cs, true);
+   tu_cs_begin_sub_stream(&cmd->sub_cs, size, patch_cs);
+   return patch_cs;
+}
+
+static void
+tu_vis_stream_patch_end(struct tu_cmd_buffer *cmd, struct tu_cs *cs, struct tu_cs *patch_cs)
+{
+   if (patch_cs == cs)
+      return;
+
+   struct tu_cs_entry entry = tu_cs_end_sub_stream(&cmd->sub_cs, patch_cs);
+   tu_cs_set_writeable(&cmd->sub_cs, false);
+   if (entry.size)
+      tu_cs_emit_ib(cs, &entry);
+}
+
+template <chip CHIP>
+static uint32_t
+tu_vsc_size()
+{
+   return CHIP == A6XX ? 9 : 10;
+}
+
 template <chip CHIP>
 static void
 tu_emit_vsc(struct tu_cmd_buffer *cmd, struct tu_cs *cs)
@@ -1604,13 +1639,10 @@ tu6_emit_tile_select(struct tu_cmd_buffer *cmd,
    tu_set_render_mode<CHIP>(cs, { .mode = RM6_BIN_RENDER_START, .uses_gmem = true });
 
    if (CHIP == A6XX && cmd->device->physical_device->has_preemption) {
