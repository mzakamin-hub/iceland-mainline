-                             : (v->local_size[1] % 2 == 0) ? 9
-                                                           : 17;
+      unsigned tile_height;
+      if (CHIP >= A8XX) {
+         tile_height = tu_a8xx_cs_wgtile_height(v->local_size[1]);
+      } else {
