+/* A8XX: the Qualcomm driver programs 16 / p, where p is the largest
+ * power of two dividing local_size_y, clamped to 16. A7XX uses 16 / p + 1
+ * with p clamped to 8. */
+static unsigned
+tu_a8xx_cs_wgtile_height(unsigned local_size_y)
+{
+   return 16 / MIN2(local_size_y & -local_size_y, 16u);
+}
