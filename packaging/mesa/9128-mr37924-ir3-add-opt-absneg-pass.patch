diff --git a/src/freedreno/ir3/ir3_opt_absneg.c b/src/freedreno/ir3/ir3_opt_absneg.c
new file mode 100644
index 00000000000..a041d5dfafd
--- /dev/null
+++ b/src/freedreno/ir3/ir3_opt_absneg.c
@@ -0,0 +1,201 @@
+/*
+ * Copyright © 2025 Igalia S.L.
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "ir3.h"
+#include "ir3_shader.h"
+
+#include "util/ralloc.h"
+
+static void
+fneg_src(struct ir3_register *src)
+{
+   src->flags ^= IR3_REG_FNEG;
+}
+
+static bool
+try_opt_fneg(struct ir3_compiler *compiler, struct ir3_instruction *instr)
+{
+   switch (instr->opc) {
+   case OPC_MUL_F:
+   case OPC_SIGN_F:
+   case OPC_TRUNC_F:
+   case OPC_RCP:
+      /* -mul(x, y) == mul(-x, y)
+       * -sign/trunc/rcp(x) == sign/trunc/rcp(-x)
+       */
+      fneg_src(instr->srcs[0]);
+      return true;
+
+   case OPC_ADD_F:
+      /* -add(-0.0, 0.0) != add(0.0, -0.0) */
+      if (is_signed_zero_preserve(instr)) {
+         return false;
+      }
+
+      /* -add(x, y) == add(-x, -y) */
+      fneg_src(instr->srcs[0]);
+      fneg_src(instr->srcs[1]);
+      return true;
+
+   case OPC_CEIL_F:
+      /* -ceil(x) == floor(-x) */
+      fneg_src(instr->srcs[0]);
+      instr->opc = OPC_FLOOR_F;
+      return true;
+
+   case OPC_FLOOR_F:
+      /* -floor(x) == ceil(-x) */
+      fneg_src(instr->srcs[0]);
+      instr->opc = OPC_CEIL_F;
+      return true;
+
+   case OPC_MIN_F:
+      /* -min(x, y) == max(-x, -y) */
+      fneg_src(instr->srcs[0]);
+      fneg_src(instr->srcs[1]);
+      instr->opc = OPC_MAX_F;
+      return true;
+
+   case OPC_MAX_F:
+      /* -max(x, y) == min(-x, -y) */
+      fneg_src(instr->srcs[0]);
+      fneg_src(instr->srcs[1]);
+      instr->opc = OPC_MIN_F;
+      return true;
+
+   case OPC_SEL_B16:
+   case OPC_SEL_B32:
+      if (!compiler->info->props.has_sel_b_fneg) {
+         return false;
+      }
+      FALLTHROUGH;
+
+   case OPC_SEL_F16:
+   case OPC_SEL_F32:
+      /* -sel(x, c, y) == sel(-x, c, -y)
+       */
+      fneg_src(instr->srcs[0]);
+      fneg_src(instr->srcs[2]);
+      return true;
+
+   case OPC_MAD_F16:
+   case OPC_MAD_F32:
+      /* -mad(-0.0, x, 0.0) != mad(0.0, x, -0.0) */
+      if (is_signed_zero_preserve(instr)) {
+         return false;
+      }
+
+       /* -mad(x, y, z) == mad(-x, y, -z) */
+      fneg_src(instr->srcs[0]);
+      fneg_src(instr->srcs[2]);
+      return true;
+
+   default:
+      return false;
+   }
+}
+
+static void
+fabs_src(struct ir3_register *src)
+{
+   src->flags |= IR3_REG_FABS;
+
+   /* (abs)(neg)x does neg(abs(x)) so we have to clear (neg). */
+   src->flags &= ~IR3_REG_FNEG;
+}
+
+static bool
+try_opt_fabs(struct ir3_instruction *instr)
+{
+   switch (instr->opc) {
+   case OPC_MUL_F:
+      /* |mul(x, y)| == mul(|x|, |y|) */
+      fabs_src(instr->srcs[0]);
+      fabs_src(instr->srcs[1]);
+      return true;
+
+   case OPC_SIGN_F:
+   case OPC_RCP:
+      /* |sign/rcp(x)| == sign/rcp(|x|) */
+      fabs_src(instr->srcs[0]);
+      return true;
+
+   default:
+      return false;
+   }
+}
+
+/* For some instructions, if their result is (neg)'d or (abs)'d by an absneg,
+ * the absneg can be removed by distributing (abs)/(neg) to the instruction's
+ * sources.
+ */
+bool
+ir3_opt_absneg(struct ir3 *ir, struct ir3_shader_variant *v)
+{
+   void *mem_ctx = ralloc_context(NULL);
+   ir3_find_ssa_uses(ir, mem_ctx, false);
+   bool progress = false;
+
+   foreach_block (block, &ir->block_list) {
+      foreach_instr (absneg, &block->instr_list) {
+         if (absneg->opc != OPC_ABSNEG_F || !absneg->srcs[0]->def) {
+            continue;
+         }
+
+         struct ir3_register *src = absneg->srcs[0];
+         struct ir3_instruction *src_instr = src->def->instr;
+
+         /* If the source instruction is used by instructions other than absneg,
+          * we cannot modify it.
+          */
+         if (src_instr->uses->entries > 1) {
+            continue;
+         }
+
+         /* In order to remove a (sat)absneg, we'll have to move the (sat) to
+          * the source instruction; bail out if it doesn't support (sat).
+          */
+         if ((absneg->flags & IR3_INSTR_SAT) &&
+             !sat_is_fsat(src_instr->opc)) {
+            continue;
+         }
+
+         if (src->flags & IR3_REG_FNEG) {
+            if (try_opt_fneg(v->compiler, src_instr)) {
+               src->flags &= ~IR3_REG_FNEG;
+               progress = true;
+            } else {
+               /* No point in trying to optimize away (abs) if we still need
+                * (neg) on absneg.
+                */
+               continue;
+            }
+         }
+
+         if (src->flags & IR3_REG_FABS) {
+            if (try_opt_fabs(src_instr)) {
+               src->flags &= ~IR3_REG_FABS;
+               progress = true;
+            } else {
+               continue;
+            }
+         }
+
+         if (!(src->flags & (IR3_REG_FNEG | IR3_REG_FABS))) {
+            /* If (neg) and (abs) have both been removed, ir3_cp will clean up
+             * the resulting no-op absneg. We just have to move any (sat) to the
+             * source.
+             */
+            if (absneg->flags & IR3_INSTR_SAT) {
+               absneg->flags &= ~IR3_INSTR_SAT;
+               src_instr->flags |= IR3_INSTR_SAT;
+            }
+         }
+      }
+   }
+
+   ralloc_free(mem_ctx);
+   return progress;
+}
