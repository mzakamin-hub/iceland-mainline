From b42e15f21bfde58cab3d16dc0ff99d00588ddb41 Mon Sep 17 00:00:00 2001
From: Job Noorman <jnoorman@igalia.com>
Date: Wed, 23 Sep 2026 10:21:48 +0200
Subject: [PATCH 1/2] ir3: add float controls to instructions

For some optimizations, we may need to be aware of the float controls of
the original NIR instruction. Add a field for this, and modify the
builder to set this field for every instruction it creates. This makes
sure we can set this correctly when NIR ALU instructions generate
multiple ir3 instructions.

Also add a helper to check if the current float controls is signed zero
preserve.

Signed-off-by: Job Noorman <jnoorman@igalia.com>
---
 src/freedreno/ir3/ir3.c              |  1 +
 src/freedreno/ir3/ir3.h              | 15 +++++++++++++++
 src/freedreno/ir3/ir3_compiler_nir.c |  2 ++
 3 files changed, 18 insertions(+)

diff --git a/src/freedreno/ir3/ir3.c b/src/freedreno/ir3/ir3.c
index 2b07dd226a2..29cb18bf2fe 100644
--- a/src/freedreno/ir3/ir3.c
+++ b/src/freedreno/ir3/ir3.c
@@ -978,6 +978,7 @@ ir3_build_instr(struct ir3_builder *builder, opc_t opc, int ndst, int nsrc)
       builder->cursor = ir3_after_instr(instr);
    }
 
+   instr->fp_math_ctrl = builder->fp_math_ctrl;
    return instr;
 }
 
diff --git a/src/freedreno/ir3/ir3.h b/src/freedreno/ir3/ir3.h
index 0627ecd8ef0..401351d6839 100644
--- a/src/freedreno/ir3/ir3.h
+++ b/src/freedreno/ir3/ir3.h
@@ -9,6 +9,7 @@
 #include <stdbool.h>
 #include <stdint.h>
 
+#include "compiler/nir/nir.h"
 #include "compiler/shader_enums.h"
 
 #include "util/bitscan.h"
@@ -548,6 +549,11 @@ struct ir3_instruction {
       } raw;
    };
 
+   /* If this instruction was created from a nir_alu_instr, this holds a copy of
+    * its fp_math_ctrl field.
+    */
+   uint32_t fp_math_ctrl;
+
    /* For assigning jump offsets, we need instruction's position: */
    uint32_t ip;
 
@@ -808,6 +814,9 @@ struct ir3_cursor {
 
 struct ir3_builder {
    struct ir3_cursor cursor;
+
+   /* nir_alu_instr::fp_math_ctrl of the instruction being emitted. */
+   uint32_t fp_math_ctrl;
 };
 
 #define MASK(n) ((1 << (n)) - 1)
@@ -1530,6 +1539,12 @@ is_input(struct ir3_instruction *instr)
    }
 }
 
+static inline bool
+is_signed_zero_preserve(struct ir3_instruction *instr)
+{
+   return !!(instr->fp_math_ctrl & nir_fp_preserve_signed_zero);
+}
+
 static inline bool
 is_bool(struct ir3_instruction *instr)
 {
diff --git a/src/freedreno/ir3/ir3_compiler_nir.c b/src/freedreno/ir3/ir3_compiler_nir.c
index 462185ecbec..b1fdc39ccfe 100644
--- a/src/freedreno/ir3/ir3_compiler_nir.c
+++ b/src/freedreno/ir3/ir3_compiler_nir.c
@@ -573,6 +573,7 @@ emit_alu(struct ir3_context *ctx, nir_alu_instr *alu)
    struct ir3_instruction_rpt dst, src[info->num_inputs];
    unsigned bs[info->num_inputs]; /* bit size */
    struct ir3_builder *b = &ctx->build;
+   b->fp_math_ctrl = alu->fp_math_ctrl;
    unsigned dst_sz;
    unsigned dst_bitsize = ir3_bitsize(ctx, alu->def.bit_size);
    type_t dst_type = type_uint_size(dst_bitsize);
@@ -4526,6 +4527,7 @@ emit_block(struct ir3_context *ctx, nir_block *nblock)
       ctx->cur_instr = instr;
       emit_instr(ctx, instr);
       ctx->cur_instr = NULL;
+      ctx->build.fp_math_ctrl = 0;
       if (ctx->error)
          return;
    }

From 554c5c931f6dd13033f4abc9ef5da0600782348a Mon Sep 17 00:00:00 2001
From: Job Noorman <jnoorman@igalia.com>
Date: Wed, 23 Sep 2026 10:21:48 +0200
Subject: [PATCH 2/2] ir3: add opt_absneg pass

For some instructions, if their result is (neg)'d or (abs)'d by an
absneg, the absneg can be removed by distributing (abs)/(neg) to the
instruction's sources. For example, `-mul.f(x, y)` == `mul.f(-x, y)`.
This commit adds a pass implementing this for a number of instructions.

This is inspired by nir_opt_algebraic_distribute_src_mods, which doesn't
produce great results for us by itself.

