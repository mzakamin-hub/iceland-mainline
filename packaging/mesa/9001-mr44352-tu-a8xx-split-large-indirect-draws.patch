From 18543839fbee18bccd3ca08baf67f79f1e6d0f3f Mon Sep 17 00:00:00 2001
From: Vamsi Chitta <vamschit@qti.qualcomm.com>
Date: Wed, 23 Sep 2026 08:20:05 +0000
Subject: [PATCH 4/7] ir3: lower draw_id to use draw_id_offset

Introduce an IR3 lowering pass that replaces draw_id
with draw_id plus draw_id_offset.

Add draw_id_offset to the driver params layout and plumb a
compiler option to enable the lowering.

Signed-off-by: Vamsi Chitta <vamschit@qti.qualcomm.com>
---
 src/freedreno/ir3/ir3_compiler.h     |  3 +++
 src/freedreno/ir3/ir3_compiler_nir.c |  3 +++
 src/freedreno/ir3/ir3_nir.c          | 25 +++++++++++++++++++++++++
 src/freedreno/ir3/ir3_shader.h       |  3 ++-
 src/freedreno/vulkan/tu_device.cc    |  1 +
 5 files changed, 34 insertions(+), 1 deletion(-)

diff --git a/src/freedreno/ir3/ir3_compiler.h b/src/freedreno/ir3/ir3_compiler.h
index d2743351..0be82225 100644
--- a/src/freedreno/ir3/ir3_compiler.h
+++ b/src/freedreno/ir3/ir3_compiler.h
@@ -56,6 +56,9 @@ struct ir3_compiler_options {
    bool dual_color_blend_by_location;
 
    uint64_t uche_trap_base;
+
+   /* If draw_id should be lowered in nir */
+   bool lower_draw_id;
 };
 
 struct ir3_compiler {
diff --git a/src/freedreno/ir3/ir3_compiler_nir.c b/src/freedreno/ir3/ir3_compiler_nir.c
index 49b4bdef..293ac002 100644
--- a/src/freedreno/ir3/ir3_compiler_nir.c
+++ b/src/freedreno/ir3/ir3_compiler_nir.c
@@ -3039,6 +3039,9 @@ emit_intrinsic(struct ir3_context *ctx, nir_intrinsic_instr *intr)
    case nir_intrinsic_load_draw_id:
       dst[0] = create_driver_param(ctx, IR3_DP_VS(draw_id));
       break;
+   case nir_intrinsic_load_draw_id_offset_ir3:
+      dst[0] = create_driver_param(ctx, IR3_DP_VS(draw_id_offset));
+      break;
    case nir_intrinsic_load_base_instance:
       dst[0] = create_driver_param(ctx, IR3_DP_VS(instid_base));
       break;
diff --git a/src/freedreno/ir3/ir3_nir.c b/src/freedreno/ir3/ir3_nir.c
index ac296920..e5159187 100644
--- a/src/freedreno/ir3/ir3_nir.c
+++ b/src/freedreno/ir3/ir3_nir.c
@@ -1466,6 +1466,25 @@ ir3_nir_set_threadsize(struct ir3_shader_variant *v, const nir_shader *s)
    }
 }
 
+static bool
+lower_draw_id(nir_builder *b, nir_intrinsic_instr *intr, void *data)
+{
+   if (intr->intrinsic != nir_intrinsic_load_draw_id)
+      return false;
+
+   b->cursor = nir_after_instr(&intr->instr);
+   nir_def_rewrite_uses_after(&intr->def,
+                        nir_iadd(b, &intr->def, nir_load_draw_id_offset_ir3(b)));
+   return true;
+}
+
+static bool
+ir3_nir_lower_draw_id(nir_shader *shader)
+{
+   return nir_shader_intrinsics_pass(shader, lower_draw_id,
+                                     nir_metadata_control_flow, NULL);
+}
+
 void
 ir3_nir_lower_variant(struct ir3_shader_variant *so,
                       const struct ir3_shader_nir_options *options,
@@ -1595,6 +1614,9 @@ ir3_nir_lower_variant(struct ir3_shader_variant *so,
 
    progress |= OPT(s, ir3_nir_opt_subgroups, so);
 
+   if (so->compiler->options.lower_draw_id)
+      progress |= OPT(s, ir3_nir_lower_draw_id);
+
    if (so->compiler->info->props.load_shader_consts_via_preamble)
       progress |= OPT(s, ir3_nir_lower_driver_params_to_ubo, so);
 
@@ -1787,6 +1809,9 @@ ir3_get_driver_param_info(const nir_shader *shader,
    case nir_intrinsic_load_draw_id:
       param_info->offset = IR3_DP_VS(draw_id);
       break;
+   case nir_intrinsic_load_draw_id_offset_ir3:
+      param_info->offset = IR3_DP_VS(draw_id_offset);
+      break;
    case nir_intrinsic_load_base_instance:
       param_info->offset = IR3_DP_VS(instid_base);
       break;
