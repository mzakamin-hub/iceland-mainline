@@ -9070,23 +9112,46 @@ tu6_emit_vs_params(struct tu_cmd_buffer *cmd,
        first_instance == cmd->state.last_vs_params.first_instance &&
        sw_multiview == cmd->state.last_vs_params.sw_multiview &&
