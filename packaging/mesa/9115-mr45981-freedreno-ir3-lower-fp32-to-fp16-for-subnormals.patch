From 92800105ce9b4c4c915949ae73a50d7f07957f30 Mon Sep 17 00:00:00 2001
From: Sahitya Kandru <kandru@qti.qualcomm.com>
Date: Wed, 4 Nov 2026 21:07:37 +0530
Subject: [PATCH] freedreno/ir3: Lower FP32 to FP16 for subnormals

The test cases in dEQP-VK.spirv_assembly.instruction.compute.* and
dEQP-VK.spirv_assembly.instruction.graphics.* use 2^-16 for the operation
OpQuantizeToF16. 2^-16 falls under FP16 subnormal and FP32. Being
subnormal it does not get lowered to 0. This lowering does that check and
lowers it to 0.

Signed-off-by: Sahitya Kandru <kandru@qti.qualcomm.com>
Part-of: <https://gitlab.freedesktop.org/mesa/mesa/-/merge_requests/45981>
(cherry picked from commit d520ae902ede90f4e3bc44bf3871030896971647)
---
 src/freedreno/ir3/ir3_compiler.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/src/freedreno/ir3/ir3_compiler.c b/src/freedreno/ir3/ir3_compiler.c
index fc974bf12d4..2c8b8ba5138 100644
--- a/src/freedreno/ir3/ir3_compiler.c
+++ b/src/freedreno/ir3/ir3_compiler.c
@@ -382,6 +382,7 @@ ir3_compiler_create(struct fd_device *dev, const struct fd_dev_id *dev_id,
 
    /* Set up nir shader compiler options, using device-specific overrides of our base settings. */
    compiler->nir_options = ir3_base_options;
+   compiler->nir_options.lower_fquantize2f16 = compiler->gen >= 8;
    compiler->nir_options.has_iadd3 = dev_info->props.has_sad;
    /* MGEN.B doesn't seem to produce useful results on FD307 */
    compiler->nir_options.has_bfm = compiler->gen >= 4;
