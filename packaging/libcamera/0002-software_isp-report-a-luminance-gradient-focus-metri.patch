From 1c6c78420c0a2b66bf919e5534e3265ae2bf2396 Mon Sep 17 00:00:00 2001
From: Osilvfe <64585305+Osilvfe@users.noreply.github.com>
Date: Tue, 29 Sep 2026 20:23:32 +0800
Subject: [PATCH 2/4] software_isp: report a luminance-gradient focus metric

(cherry picked from commit 9afba3cd3da3c84fc6acabf24aa6c7092c0a641f)
---
 .../internal/software_isp/swisp_stats.h       |  8 ++++++
 src/ipa/simple/soft_simple.cpp                | 11 ++++++++
 src/libcamera/software_isp/swstats_cpu.cpp    | 26 +++++++++++++++++--
 3 files changed, 43 insertions(+), 2 deletions(-)

diff --git a/include/libcamera/internal/software_isp/swisp_stats.h b/include/libcamera/internal/software_isp/swisp_stats.h
index d9d0d9be8..f923eced9 100644
--- a/include/libcamera/internal/software_isp/swisp_stats.h
+++ b/include/libcamera/internal/software_isp/swisp_stats.h
@@ -31,6 +31,14 @@ struct SwIspStats {
 	 * \brief Sums of colour channels of all the sampled pixels
 	 */
 	RGB<uint64_t> sum_;
+	/**
+	 * \brief Sum of horizontal luminance gradients used for focus measurement
+	 */
+	uint64_t focusSum;
+	/**
+	 * \brief Number of gradients accumulated in focusSum
+	 */
+	uint32_t focusSamples;
 	/**
 	 * \brief Number of bins in the yHistogram
 	 */
diff --git a/src/ipa/simple/soft_simple.cpp b/src/ipa/simple/soft_simple.cpp
index 629e1a32d..5d72032d8 100644
--- a/src/ipa/simple/soft_simple.cpp
+++ b/src/ipa/simple/soft_simple.cpp
@@ -6,6 +6,7 @@
  */
 
 #include <chrono>
+#include <limits>
 #include <stdint.h>
 #include <sys/mman.h>
 
@@ -177,6 +178,9 @@ int IPASoftSimple::init(const IPASettings &settings,
 		stats_ = static_cast<SwIspStats *>(mem);
 	}
 
+	context_.ctrlMap[&controls::FocusFoM] = ControlInfo(
+		0, std::numeric_limits<int32_t>::max(), 0);
+
 	ControlInfoMap::Map ctrlMap = context_.ctrlMap;
 	*ipaControls = ControlInfoMap(std::move(ctrlMap), controls::controls);
 
@@ -309,6 +313,13 @@ void IPASoftSimple::processStats(const uint32_t frame,
 	ControlList metadata(controls::controls);
 	for (const auto &algo : algorithms())
 		algo->process(context_, frame, frameContext, stats_, metadata);
+	if (stats_->valid && stats_->focusSamples) {
+		const uint64_t focus = stats_->focusSum * 1024 /
+				       stats_->focusSamples;
+		metadata.set(controls::FocusFoM,
+			     static_cast<int32_t>(std::min<uint64_t>(
+				     focus, std::numeric_limits<int32_t>::max())));
+	}
 	metadataReady.emit(frame, metadata);
 
 	/* Sanity check */
diff --git a/src/libcamera/software_isp/swstats_cpu.cpp b/src/libcamera/software_isp/swstats_cpu.cpp
index 5366e019f..c466d4dbd 100644
--- a/src/libcamera/software_isp/swstats_cpu.cpp
+++ b/src/libcamera/software_isp/swstats_cpu.cpp
@@ -174,10 +174,14 @@ static constexpr unsigned int kBlueYMul = 29; /* 0.114 * 256 */
 #define SWSTATS_START_LINE_STATS(pixel_t) \
 	pixel_t r, g, g2, b;              \
 	uint64_t yVal;                    \
+	uint32_t previousY = 0;           \
+	bool havePreviousY = false;       \
                                           \
 	uint64_t sumR = 0;                \
 	uint64_t sumG = 0;                \
-	uint64_t sumB = 0;
+	uint64_t sumB = 0;                \
+	uint64_t focusSum = 0;            \
+	uint32_t focusSamples = 0;
 
 #define SWSTATS_ACCUMULATE_LINE_STATS(div) \
 	sumR += r;                         \
@@ -187,12 +191,24 @@ static constexpr unsigned int kBlueYMul = 29; /* 0.114 * 256 */
 	yVal = r * kRedYMul;               \
 	yVal += g * kGreenYMul;            \
 	yVal += b * kBlueYMul;             \
+	{                                          \
+		const uint32_t focusY = yVal / (256 * (div)); \
+		if (havePreviousY) {                 \
+			focusSum += focusY > previousY ? focusY - previousY \
+							 : previousY - focusY; \
+			focusSamples++;                    \
+		}                                      \
+		previousY = focusY;                  \
+		havePreviousY = true;                \
+	}                                          \
 	stats.yHistogram[yVal * SwIspStats::kYHistogramSize / (256 * 256 * (div))]++;
 
 #define SWSTATS_FINISH_LINE_STATS() \
 	stats.sum_.r() += sumR;     \
 	stats.sum_.g() += sumG;     \
-	stats.sum_.b() += sumB;
+	stats.sum_.b() += sumB;     \
+	stats.focusSum += focusSum; \
+	stats.focusSamples += focusSamples;
 
 void SwStatsCpu::statsBGGR8Line0(const uint8_t *src[], SwIspStats &stats)
 {
@@ -339,6 +355,8 @@ void SwStatsCpu::startFrame(uint32_t frame)
 
 	for (auto &s : stats_) {
 		s.sum_ = RGB<uint64_t>({ 0, 0, 0 });
+		s.focusSum = 0;
+		s.focusSamples = 0;
 		s.yHistogram.fill(0);
 	}
 }
@@ -356,9 +374,13 @@ void SwStatsCpu::finishFrame(uint32_t frame, uint32_t bufferId)
 
 	if (valid) {
 		sharedStats_->sum_ = RGB<uint64_t>({ 0, 0, 0 });
+		sharedStats_->focusSum = 0;
+		sharedStats_->focusSamples = 0;
 		sharedStats_->yHistogram.fill(0);
 		for (const auto &s : stats_) {
 			sharedStats_->sum_ += s.sum_;
+			sharedStats_->focusSum += s.focusSum;
+			sharedStats_->focusSamples += s.focusSamples;
 			for (unsigned int j = 0; j < SwIspStats::kYHistogramSize; j++)
 				sharedStats_->yHistogram[j] += s.yHistogram[j];
 		}
-- 
2.43.0

