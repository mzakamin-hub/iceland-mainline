From b4d61e1406048c5c2529b8d425a7ee48cd5b0dfe Mon Sep 17 00:00:00 2001
From: Ben Ashby <mail@benashby.com>
Date: Thu, 1 Oct 2026 17:45:23 -0600
Subject: [PATCH 1/2] v4l2object: fix IS_MUTABLE assertion in set_format

When the driver returns a field or a colorspace that GStreamer can't
map, gst_v4l2_object_set_format_full() removes interlace-mode or
colorimetry from the caps it was given. On S_FMT these are negotiated
caps, which the m2m elements pass without a writable copy, and the
call fails with:

  gst_structure_remove_field: assertion 'IS_MUTABLE (structure)' failed

v4l2h264dec hits this on any H.264 stream without a colour description
when the driver keeps V4L2_COLORSPACE_DEFAULT for the coded format.

Only drop the fields on TRY_FMT, where v4l2src adjusts its own copy of
the caps during fixation, and leave negotiated caps alone.

Part-of: <https://gitlab.freedesktop.org/gstreamer/gstreamer/-/merge_requests/12699>
---
 subprojects/gst-plugins-good/sys/v4l2/gstv4l2object.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/subprojects/gst-plugins-good/sys/v4l2/gstv4l2object.c b/subprojects/gst-plugins-good/sys/v4l2/gstv4l2object.c
index e544e3e854b..8af08d4416a 100644
--- a/subprojects/gst-plugins-good/sys/v4l2/gstv4l2object.c
+++ b/subprojects/gst-plugins-good/sys/v4l2/gstv4l2object.c
@@ -4375,7 +4375,7 @@ gst_v4l2_object_set_format_full (GstV4l2Object * v4l2object, GstCaps * caps,
       if (format.fmt.pix.field != field)
         goto invalid_field;
     }
-  } else {
+  } else if (try_only) {
     /* The driver (or libv4l2) is miss-behaving, just ignore interlace-mode from
      * the TRY_FMT */
     disable_interlacing = TRUE;
@@ -4389,7 +4389,7 @@ gst_v4l2_object_set_format_full (GstV4l2Object * v4l2object, GstCaps * caps,
       if (!gst_v4l2_video_colorimetry_matches (&info.vinfo.colorimetry, caps))
         goto invalid_colorimetry;
     }
-  } else {
+  } else if (try_only) {
     /* The driver (or libv4l2) is miss-behaving, just ignore colorimetry from
      * the TRY_FMT */
     disable_colorimetry = TRUE;
-- 
