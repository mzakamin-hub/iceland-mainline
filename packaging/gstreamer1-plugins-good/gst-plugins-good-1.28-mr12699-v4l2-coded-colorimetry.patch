From a95f1aa304ef9f1370f98d1dcf83202c2c8ed4d4 Mon Sep 17 00:00:00 2001
From: Ben Ashby <mail@benashby.com>
Date: Fri, 2 Oct 2026 09:46:07 -0600
Subject: [PATCH 2/2] v4l2object: accept any colorimetry on coded OUTPUT caps

For raw formats, add_non_colorimetry_caps() appends a copy of each
probed structure without colorimetry, so any colorimetry from upstream
still negotiates. Coded formats don't get that copy, so a V4L2 decoder
refuses a stream whose colorimetry wasn't probed, and decodebin3 falls
back to software. h264parse and h265parse report such values, 2:3:0:0
and 2:3:0:1, for a VUI that leaves the primaries or the transfer
unspecified.

On the OUTPUT queue, coded caps are the decoder's input, and their
colorimetry is only a hint the decoder passes in S_FMT. Append the copy
for coded formats on that queue too. On CAPTURE, encoders and v4l2src
report what they produce, so coded caps there keep the probed list.

Fixes #5142

Part-of: <https://gitlab.freedesktop.org/gstreamer/gstreamer/-/merge_requests/12699>
---
 subprojects/gst-plugins-good/sys/v4l2/gstv4l2object.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/subprojects/gst-plugins-good/sys/v4l2/gstv4l2object.c b/subprojects/gst-plugins-good/sys/v4l2/gstv4l2object.c
index 8af08d4416a..47cdd4f509e 100644
--- a/subprojects/gst-plugins-good/sys/v4l2/gstv4l2object.c
+++ b/subprojects/gst-plugins-good/sys/v4l2/gstv4l2object.c
@@ -1824,8 +1824,9 @@ add_non_colorimetry_caps (GstV4l2Object * v4l2object, GstCaps * caps)
     GstStructure *structure = gst_caps_get_structure (caps, i);
     GstCapsFeatures *features = gst_caps_get_features (caps, i);
 
-    if (gst_structure_has_name (structure, "video/x-raw")
-        && gst_structure_has_field (structure, "colorimetry")) {
+    if (gst_structure_has_field (structure, "colorimetry")
+        && (gst_structure_has_name (structure, "video/x-raw")
+            || V4L2_TYPE_IS_OUTPUT (v4l2object->type))) {
       GstStructure *alt_s = gst_structure_copy (structure);
       gst_structure_remove_field (alt_s, "colorimetry");
       if (gst_caps_features_contains (features,
